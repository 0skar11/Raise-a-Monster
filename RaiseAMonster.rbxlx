		MotherDamage = 45,
		MotherSize = 11,
	},
} :: { Zone }

Config.ZoneResetInterval = 600 -- كل 10 دقايق الأعشاش بتتجدد بوحوش تانية
Config.NestsPerZone = 3
Config.BabiesPerNest = 3

Config.WalkSpeed = 20 -- سرعة المشي (الافتراضي في Roblox 16)

-- الوحش اللي شايله على ضهرك لحد ما توصل قاعدتك
Config.Carry = {
	WalkSpeedMultiplier = 0.8, -- بتمشي أبطأ وانت شايل وحش
	SecretEggSpeedMultiplier = 0.7, -- بيضة الـ Big Boss تقيلة شوية
	KillCreditTime = 10, -- لو حد ضربك في آخر 10 ثواني وموتّ، هو اللي بياخد اللي شايله
	DropLifetime = 60, -- الوحش اللي بيقع على الأرض بيختفي بعد المدة دي
}

-- ضرب اللاعبين بالمضرب (برّه القواعد بس)
Config.PvP = {
	BatDamage = 15,
	SwordDamage = 30,
	Reach = 7,
}

Config.Combat = {
	BaseDamage = 10, -- ضرر اللاعب من غير وحوش
	DamagePerProduction = 2, -- كل 1 Coin/s من وحوشك بيزوّد ضربتك 2
	AttackCooldown = 0.35,
	BatReach = 7, -- قد إيه تبعد عن حرف الأم وتقدر تضربها بالمضرب
	MotherAttackInterval = 1.5,
	MotherAttackRange = 24,
	MotherRegenDelay = 20, -- لو محدش ضربها المدة دي الـ HP بيرجع كامل
	TakeHoldDuration = 1,
}

-- Gamepasses و Developer Products -----------------------------------------------------
-- حط الـ Id بتاع كل واحد بعد ما تعمله من Creator Dashboard (بعد الـ Publish).
-- لو الـ Id = 0: في Studio الزرار بيدّيهولك مجاناً عشان التجربة، وفي اللعبة الحقيقية بيقول "Coming soon".
export type Gamepass = { Id: number, Name: string, Description: string, Price: number, Order: number }
Config.Gamepasses = {
	VIP = { Id = 0, Name = "VIP", Description = "x2 coins from all your monsters", Price = 299, Order = 1 },
	VIPSword = { Id = 0, Name = "VIP Sword", Description = "A strong sword for the monster zones", Price = 199, Order = 2 },
	AutoCollect = { Id = 0, Name = "Auto-Collect", Description = "Coins go to your wallet by themselves", Price = 149, Order = 3 },
	ExtraSlots = { Id = 0, Name = "+2 Slots", Description = "Two more monster slots in your base", Price = 99, Order = 4 },
} :: { [string]: Gamepass }

export type Product = { Id: number, Name: string, Description: string, Price: number, Order: number }
Config.Products = {
	InstantHatch = { Id = 0, Name = "Instant Hatch", Description = "All your eggs hatch right now", Price = 25, Order = 1 },
	LuckyEgg = { Id = 0, Name = "Lucky Egg", Description = "A rare egg with better odds", Price = 49, Order = 2 },
	SpeedBoost = { Id = 0, Name = "Speed Boost", Description = "Run faster for 10 minutes", Price = 29, Order = 3 },
} :: { [string]: Product }

Config.VIPCoinMultiplier = 2
Config.ExtraSlotsAmount = 2
Config.VIPSword = { DamageMultiplier = 3, ExtraReach = 3 }
Config.SpeedBoost = { Duration = 600, Multiplier = 1.4 }

-- أحداث الماب ---------------------------------------------------------------------------
-- Monster Rain: كل ساعة وحش نادر بيقع في نص الماب، وأول واحد يمسكه ويوصله قاعدته ياخده.
Config.MonsterRain = {
	Interval = 3600,
	Lifetime = 300, -- لو محدش مسكه بيختفي
	Species = { "Shadowy", "Flamey", "Draco", "Monster9", "Monster10", "Monster11", "Monster12", "Monster13", "Monster14" },
	MutationChanceMultiplier = 3,
}

-- Big Boss: أوقات بينزل في الماب ومعاه بيضة Secret. لازم الكل يتجمع يقتله.
Config.Boss = {
	MinInterval = 2400, -- بين 40 و 80 دقيقة
	MaxInterval = 4800,
	HealthPerPlayer = 60000,
	MinHealth = 120000,
	Damage = 30, -- كل ضربة، لكل اللي جنبه
	AttackInterval = 1.5,
	AttackRange = 30,
	Size = 18,
	Lifetime = 600, -- لو محدش قتله بيمشي
	Position = Vector3.new(120, 0, 0), -- في الطريق جوه Zone 1
}

-- اللوحات اللي في الساحة (Leaderboards)
Config.Leaderboards = {
	UpdateInterval = 60,
	TopCount = 10,
}

-- الهدية اليومية وعجلة الحظ ---------------------------------------------------------------
Config.Daily = {
	Cooldown = 20 * 3600, -- تقدر تاخدها كل 20 ساعة
	StreakReset = 48 * 3600, -- لو غبت أكتر من كده الـ Streak يبدأ من الأول
	CoinsPerDay = 150, -- بتتضرب في يوم الـ Streak (لحد 7)
	MaxStreak = 7,
	Day7Egg = "Rare", -- اليوم السابع بيدّيك بيضة كمان
}

export type SpinPrize = { Name: string, Weight: number, Coins: number?, Egg: string?, Color: Color3 }
Config.Spin = {
	Cooldown = 24 * 3600, -- لفة مجانية كل يوم
	Prizes = {
		{ Name = "100 Coins", Weight = 30, Coins = 100, Color = Color3.fromRGB(255, 210, 70) },
		{ Name = "Rare Egg", Weight = 16, Egg = "Rare", Color = Color3.fromRGB(80, 160, 255) },
		{ Name = "400 Coins", Weight = 24, Coins = 400, Color = Color3.fromRGB(255, 160, 50) },
		{ Name = "Lucky Egg", Weight = 6, Egg = "Lucky", Color = Color3.fromRGB(90, 230, 120) },
		{ Name = "1500 Coins", Weight = 14, Coins = 1500, Color = Color3.fromRGB(255, 110, 60) },
		{ Name = "Mythic Egg", Weight = 10, Egg = "Mythic", Color = Color3.fromRGB(255, 60, 120) },
	} :: { SpinPrize },
}

-- ألعاب صغيرة مع الوحش (بدل زرار Play) ------------------------------------------------------
Config.MiniGames = {
	Cooldown = 20, -- لكل وحش
	Happiness = 40,
	Catch = { Duration = 12, XpPerCatch = 4, MaxCatches = 30 },
	Run = { Duration = 15, Target = 160, MaxXp = 60 }, -- XP على حسب المسافة اللي جريتها
}

-- إكسسوارات الوحوش -------------------------------------------------------------------------
export type Accessory = { Name: string, Slot: string, Cost: number, Bonus: number, Color: Color3, Order: number }
Config.Accessories = {
	PartyHat = { Name = "Party Hat", Slot = "Hat", Cost = 300, Bonus = 0, Color = Color3.fromRGB(255, 90, 180), Order = 1 },
	TopHat = { Name = "Top Hat", Slot = "Hat", Cost = 1500, Bonus = 0.03, Color = Color3.fromRGB(30, 30, 35), Order = 2 },
	WizardHat = { Name = "Wizard Hat", Slot = "Hat", Cost = 8000, Bonus = 0.08, Color = Color3.fromRGB(90, 60, 200), Order = 3 },
	Crown = { Name = "Crown", Slot = "Hat", Cost = 30000, Bonus = 0.15, Color = Color3.fromRGB(255, 205, 50), Order = 4 },
	StarGlasses = { Name = "Star Glasses", Slot = "Glasses", Cost = 400, Bonus = 0, Color = Color3.fromRGB(255, 220, 60), Order = 5 },
	CoolShades = { Name = "Cool Shades", Slot = "Glasses", Cost = 2500, Bonus = 0.05, Color = Color3.fromRGB(20, 20, 25), Order = 6 },
	Monocle = { Name = "Monocle", Slot = "Glasses", Cost = 12000, Bonus = 0.1, Color = Color3.fromRGB(230, 190, 80), Order = 7 },
} :: { [string]: Accessory }

-- Monster Arena: معارك 1 ضد 1. الكسبان بياخد فلوس والوحش اللي خسر --------------------------
Config.Arena = {
	Position = Vector3.new(20, 0, 150), -- في الساحة
	RequestTimeout = 60,
	TurnTime = 0.8,
	MaxTurns = 40,
	PrizeCoins = 500, -- + 10% من قيمة الوحش اللي خسر
	PrizeValueShare = 0.1,
}

-- Trading -------------------------------------------------------------------------------------
Config.Trade = {
	MaxOffer = 4,
	RequestTimeout = 60,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">MonsterMath</string>
          <string name="Source"><![CDATA[--!strict
-- حسابات مشتركة بين السيرفر والواجهة (مستوى، مرحلة، إنتاج، أسعار).

local Config = require(script.Parent.Config)

export type MonsterData = {
	Id: string,
	Species: string,
	Mutation: string?,
	Level: number,
	Xp: number,
	Hunger: number,
	Happiness: number,
	Slot: number,
	Hat: string?, -- إكسسوارات (Config.Accessories)
	Glasses: string?,
}

local MonsterMath = {}

function MonsterMath.GetStageIndex(level: number): number
	local index = 1
	for i, stage in Config.Stages do
		if level >= stage.MinLevel then
			index = i
		end
	end
	return index
end

function MonsterMath.GetStage(level: number): Config.Stage
	return Config.Stages[MonsterMath.GetStageIndex(level)]
end

function MonsterMath.GetMutation(name: string?): Config.Mutation?
	if not name then
		return nil
	end
	for _, mutation in Config.Mutations do
		if mutation.Name == name then
			return mutation
		end
	end
	return nil
end

function MonsterMath.GetMutationMultiplier(name: string?): number
	local mutation = MonsterMath.GetMutation(name)
	return if mutation then mutation.Multiplier else 1
end

-- الزيادة في الإنتاج من القبعة والنضارة (0.15 = +15%)
function MonsterMath.GetAccessoryBonus(monster: MonsterData): number
	local bonus = 0
	for _, name in { monster.Hat, monster.Glasses } do
		local accessory = name and Config.Accessories[name]
		if accessory then
			bonus += accessory.Bonus
		end
	end
	return bonus
end

-- Coins في الثانية
function MonsterMath.GetProduction(monster: MonsterData): number
	local species = Config.Species[monster.Species]
	if not species then
		return 0
	end
	local stage = MonsterMath.GetStage(monster.Level)
	local levelBonus = 1 + (monster.Level - 1) * 0.05
	local production = species.BaseProduction
		* stage.ProductionMultiplier
		* levelBonus
		* MonsterMath.GetMutationMultiplier(monster.Mutation)
		* (1 + MonsterMath.GetAccessoryBonus(monster))
	if monster.Hunger < Config.LowNeedsThreshold or monster.Happiness < Config.LowNeedsThreshold then
		production *= Config.LowNeedsProductionMultiplier
	end
	return production
end

function MonsterMath.GetSellValue(monster: MonsterData): number
	local species = Config.Species[monster.Species]
	if not species then
		return 0
	end
	local stage = MonsterMath.GetStage(monster.Level)
	return math.floor(
		species.SellValue
			* (1 + (monster.Level - 1) * 0.1)
			* stage.ProductionMultiplier
			* MonsterMath.GetMutationMultiplier(monster.Mutation)
	)
end

function MonsterMath.GetFoodCost(monster: MonsterData): number
	return Config.Food.Cost * MonsterMath.GetStageIndex(monster.Level)
end

function MonsterMath.GetDisplayName(monster: MonsterData): string
	local species = Config.Species[monster.Species]
	local name = if species then species.DisplayName else monster.Species
	if monster.Mutation then
		name = monster.Mutation .. " " .. name
	end
	return name
end

function MonsterMath.FormatNumber(value: number): string
	local suffixes = { "", "K", "M", "B", "T" }
	local index = 1
	while math.abs(value) >= 1000 and index < #suffixes do
		value /= 1000
		index += 1
	end
	if index == 1 then
		return tostring(math.floor(value))
	end
	return string.format("%.1f%s", value, suffixes[index])
end

return MonsterMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- السيرفر بيعمل الـ RemoteEvents، والكلاينت بيستناها.

local RunService = game:GetService("RunService")

local EVENT_NAMES = {
	-- سيرفر → كلاينت
	"StateUpdate", -- (state)
	"Notify", -- (text, kind)
	"OpenShop", -- ()
	"OpenMonster", -- (monsterId)
	-- كلاينت → سيرفر
	"BuyEgg", -- (eggType)
	"FeedMonster", -- (monsterId)
	"PlayMonster", -- (monsterId)
	"SellMonster", -- (monsterId)
	"BuyUpgrade", -- (upgradeName)
	"Teleport", -- ("Home" | "Shop")
	"BuyPass", -- (passName)
	"BuyProduct", -- (productName)
	"ClaimDaily", -- ()
	"Spin", -- ()
	"BuyAccessory", -- (accessoryName)
	"EquipAccessory", -- (monsterId, slot, accessoryName?)
	"MiniGameStart", -- (monsterId, gameName)
	"MiniGameFinish", -- (score)
	"TradeRequest", -- (targetUserId)
	"TradeRespond", -- (fromUserId, accepted)
	"TradeSetOffer", -- ({ monsterId })
	"TradeReady", -- (ready)
	"TradeCancel", -- ()
	"ArenaChallenge", -- (targetUserId, monsterId)
	"ArenaRespond", -- (fromUserId, monsterId?)  monsterId = nil يعني رفض
	-- سيرفر → كلاينت (زيادة)
	"Announce", -- (text, color)  إعلان كبير لكل السيرفر
	"SpinResult", -- (prizeIndex)
	"MiniGameState", -- ({ Game, TimeLeft, Progress, Done, Xp })
	"TradeUpdate", -- (trade state | nil)
	"TradeIncoming", -- (fromUserId, fromName)
	"ArenaIncoming", -- (fromUserId, fromName, monsterName)
	"ArenaUpdate", -- (battle state | nil)
}

local Remotes = {}

function Remotes.Get(): { [string]: RemoteEvent }
	local result: { [string]: RemoteEvent } = {}
	local folder: Instance
	if RunService:IsServer() then
		local existing = script.Parent:FindFirstChild("RemoteEvents")
		if existing then
			folder = existing
		else
			folder = Instance.new("Folder")
			folder.Name = "RemoteEvents"
			folder.Parent = script.Parent
		end
		for _, name in EVENT_NAMES do
			local remote = folder:FindFirstChild(name) :: RemoteEvent?
			if not remote then
				local created = Instance.new("RemoteEvent")
				created.Name = name
				created.Parent = folder
				remote = created
			end
			result[name] = remote :: RemoteEvent
		end
	else
		folder = script.Parent:WaitForChild("RemoteEvents")
		for _, name in EVENT_NAMES do
			result[name] = folder:WaitForChild(name) :: RemoteEvent
		end
	end
	return result
end

return Remotes
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="7">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- نقطة البداية للسيرفر: بتشغّل كل الخدمات وبتربطها ببعض.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local CharacterService = require(script.CharacterService)
local DataService = require(script.DataService)
local PlotService = require(script.PlotService)
local MonsterService = require(script.MonsterService)
local StealService = require(script.StealService)
local CombatService = require(script.CombatService)
local CarryService = require(script.CarryService)
local ZoneService = require(script.ZoneService)
local TerrainService = require(script.TerrainService)
local MonetizationService = require(script.MonetizationService)
local EventService = require(script.EventService)
local LeaderboardService = require(script.LeaderboardService)
local RewardService = require(script.RewardService)
local TradeService = require(script.TradeService)
local ArenaService = require(script.ArenaService)

local remotes = Remotes.Get()

-- Hooks (عشان MonsterService مايحتاجش يعمل require للخدمات اللي بتعتمد عليه)
MonsterService.HasPass = MonetizationService.HasPass
MonsterService.ExtraState = function(player: Player): { [string]: any }
	local profile = DataService.Get(player)
	return {
		Passes = MonetizationService.GetOwnedPasses(player),
		BoostLeft = MonetizationService.BoostLeft(player),
		DailyReadyIn = RewardService.DailyReadyIn(player),
		SpinReadyIn = RewardService.SpinReadyIn(player),
		DailyStreak = if profile then profile.Data.Daily.Streak else 0,
		Carrying = CarryService.IsCarrying(player),
	}
end

CharacterService.Init()
PlotService.Init()
MonsterService.Init(remotes)
StealService.Init()
CarryService.Init()
ZoneService.Init()
TerrainService.Init()
MonetizationService.Init(remotes)
EventService.Init()
LeaderboardService.Init()
RewardService.Init(remotes)
TradeService.Init(remotes)
ArenaService.Init(remotes)
DataService.StartAutosave()

PlotService.Callbacks.Collect = MonsterService.Collect
PlotService.Callbacks.Lock = MonsterService.Lock
PlotService.Callbacks.Care = MonsterService.OpenMonster
PlotService.Callbacks.OpenShop = function(player)
	remotes.OpenShop:FireClient(player)
end

-- تليبورت للبيت أو المتجر (مش شغال جوه مناطق الوحوش، ولا وانت شايل وحش)
local lastTeleport: { [Player]: number } = {}
remotes.Teleport.OnServerEvent:Connect(function(player: Player, where: unknown)
	if where ~= "Home" and where ~= "Shop" then
		return
	end
	local now = os.clock()
	if lastTeleport[player] and now - lastTeleport[player] < 2 then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	if root.Position.X >= PlotService.ZonesStartX then
		MonsterService.Notify(player, "🚫 You can't teleport from inside the monster zones!", "error")
		return
	end
	if CarryService.IsCarrying(player) then
		MonsterService.Notify(player, "🚫 You can't teleport while carrying something! Walk it home.", "error")
		return
	end
	lastTeleport[player] = now
	if where == "Home" then
		PlotService.SendHome(player)
	else
		character:PivotTo(CFrame.new(PlotService.ShopPosition + Vector3.new(0, 4, 10)))
	end
end)

local function onCharacter(player: Player, character: Model)
	PlotService.SendHome(player)
	CharacterService.UpdateSpeed(player)
	CombatService.GiveWeapons(player, MonetizationService.HasPass(player, "VIPSword"))
	MonetizationService.OnCharacter(player)
	task.spawn(function()
		CharacterService.ApplyAppearance(player, character)
		CharacterService.UpdateSpeed(player)
	end)
end

local function onPlayerAdded(player: Player)
	local profile = DataService.Load(player)
	if not player.Parent then
		DataService.Release(player)
		return
	end

	local plot = PlotService.Assign(player)
	if not plot then
		player:Kick("This server is full, please try another one.")
		DataService.Release(player)
		return
	end

	MonetizationService.SetupPlayer(player)

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = profile.Data.Coins
	coins.Parent = leaderstats
	-- الـ Steals: لما تموّت حد شايل وحش وتاخده منه
	local steals = Instance.new("IntValue")
	steals.Name = "Steals"
	steals.Value = profile.Data.Stats.Steals
	steals.Parent = leaderstats
	leaderstats.Parent = player

	task.spawn(function()
		while player.Parent and DataService.Get(player) == profile do
			coins.Value = math.floor(profile.Data.Coins)
			steals.Value = profile.Data.Stats.Steals
			task.wait(0.5)
		end
	end)

	player.CharacterAdded:Connect(function(character)
		task.wait()
		onCharacter(player, character)
	end)
	local character = player.Character
	if character and not CharacterService.IsR6(character) then
		-- اتولد قبل ما الـ R6 يجهز: نولّده تاني
		player:LoadCharacter()
	elseif character then
		onCharacter(player, character)
	end

	MonsterService.SetupPlayer(player)

	if profile.LoadFailed then
		MonsterService.Notify(player, "⚠️ Could not load your data. Progress will NOT be saved this session.", "error")
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	lastTeleport[player] = nil
	StealService.CleanupPlayer(player)
	CombatService.CleanupPlayer(player)
	TradeService.CleanupPlayer(player)
	ArenaService.CleanupPlayer(player)
	RewardService.CleanupPlayer(player)
	ZoneService.CleanupPlayer(player)
	MonetizationService.CleanupPlayer(player)
	CharacterService.Cleanup(player)
	MonsterService.CleanupPlayer(player)
	PlotService.Release(player)
	DataService.Release(player)
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">ArenaService</string>
          <string name="Source"><![CDATA[--!strict
-- Monster Arena: معارك وحوش 1 ضد 1.
-- لاعب بيتحدى لاعب بوحش، التاني يقبل ويختار وحشه، والمعركة بتتعرض في الـ Arena اللي في الساحة.
-- الكسبان بياخد فلوس + الوحش اللي خسر.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)
local Build = require(script.Parent.Build)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local MonsterService = require(script.Parent.MonsterService)

type Fighter = {
	Player: Player,
	MonsterId: string,
	Name: string,
	Health: number,
	MaxHealth: number,
	Attack: number,
	Model: Model?,
	Label: TextLabel?,
}

type Challenge = { From: Player, MonsterId: string, Time: number }

local ArenaService = {}

local remotes: { [string]: RemoteEvent }
local challenges: { [Player]: { [Player]: Challenge } } = {} -- challenges[target][from]
local fighting: { [Player]: boolean } = {}
local battleRunning = false
local pedestals: { BasePart } = {}
local arenaSign: TextLabel

-- قوة الوحش في المعركة: الندرة والـ Level والمرحلة والطفرة
local function fighterStats(monster: MonsterMath.MonsterData): (number, number)
	local species = Config.Species[monster.Species]
	local rarity = Config.Rarities[species.Rarity]
	local score = (rarity.Order * 10 + monster.Level * 2 + MonsterMath.GetStageIndex(monster.Level) * 15)
		* MonsterMath.GetMutationMultiplier(monster.Mutation)
	return math.floor(100 + score * 5), 8 + score * 0.6
end

local function setCarried(player: Player, monsterId: string, value: boolean)
	local set = MonsterService.Carried[player]
	if not set then
		set = {}
		MonsterService.Carried[player] = set
	end
	set[monsterId] = if value then true else nil
end

local function buildArena()
	local center = Config.Arena.Position
	local folder = Instance.new("Folder")
	folder.Name = "MonsterArena"
	folder.Parent = workspace
	Build.MakePart({
		Name = "ArenaFloor",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 36, 36),
		CFrame = CFrame.new(center + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(150, 60, 60),
		Material = Enum.Material.Slate,
		Parent = folder,
	})
	Build.MakePart({
		Name = "ArenaRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7, 30, 30),
		CFrame = CFrame.new(center + Vector3.new(0, 0.35, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(200, 170, 120),
		Material = Enum.Material.Sand,
		Parent = folder,
	})
	for _, side in { -1, 1 } do
		local pedestal = Build.MakePart({
			Name = "ArenaPedestal",
			Size = Vector3.new(7, 1.5, 7),
			Position = center + Vector3.new(0, 1.2, side * 9),
			Color = if side < 0 then Color3.fromRGB(70, 130, 255) else Color3.fromRGB(255, 80, 80),
			Material = Enum.Material.Neon,
			Parent = folder,
		})
		table.insert(pedestals, pedestal)
	end
	for i = 0, 7 do
		local angle = i / 8 * math.pi * 2
		Build.MakePart({
			Name = "ArenaPillar",
			Size = Vector3.new(2, 8, 2),
			Position = center + Vector3.new(math.cos(angle) * 17, 4, math.sin(angle) * 17),
			Color = Color3.fromRGB(120, 110, 100),
			Material = Enum.Material.Cobblestone,
			Parent = folder,
		})
	end
	local signPart = Build.MakePart({
		Name = "ArenaSign",
		Size = Vector3.new(1, 1, 1),
		Position = center + Vector3.new(0, 14, 0),
		Transparency = 1,
		CanCollide = false,
		Parent = folder,
	})
	local gui, label = Build.MakeBillboard(signPart, UDim2.fromScale(28, 7), Vector3.zero, 220)
	gui.AlwaysOnTop = false
	label.Text = '<font color="#FF6060">⚔️ MONSTER ARENA ⚔️</font>\nChallenge someone from the Arena button'
	arenaSign = label
end

local function fighterLabel(fighter: Fighter): string
	return string.format("%s\n❤️ %d / %d", fighter.Name, math.max(0, math.floor(fighter.Health)), fighter.MaxHealth)
end

local function showFighter(fighter: Fighter, pedestal: BasePart, monster: MonsterMath.MonsterData)
	local model = PlotService.BuildMonsterModel(monster)
	local body = model.PrimaryPart :: BasePart
	local facing = Config.Arena.Position + Vector3.new(0, pedestal.Position.Y, 0)
	model:PivotTo(CFrame.lookAt(pedestal.Position + Vector3.new(0, 0.75 + body.Size.Y / 2 + 0.6, 0), facing))
	local info = body:FindFirstChild("Info")
	local label = info and info:FindFirstChild("Label") :: TextLabel?
	model.Parent = pedestal.Parent
	fighter.Model = model
	fighter.Label = label
	if label then
		label.Text = fighterLabel(fighter)
	end
end

local function sendState(a: Fighter, b: Fighter, log: string, done: boolean, winner: Player?)
	for _, pair in { { a, b }, { b, a } } do
		local me, them = pair[1], pair[2]
		if me.Player.Parent then
			remotes.ArenaUpdate:FireClient(me.Player, {
				MyName = me.Name,
				TheirName = them.Name,
				MyHealth = math.max(0, me.Health),
				MyMax = me.MaxHealth,
				TheirHealth = math.max(0, them.Health),
				TheirMax = them.MaxHealth,
				Log = log,
				Done = done,
				Won = winner == me.Player,
			})
		end
	end
end

local function finishBattle(a: Fighter, b: Fighter, winner: Fighter, loser: Fighter)
	setCarried(a.Player, a.MonsterId, false)
	setCarried(b.Player, b.MonsterId, false)
	fighting[a.Player] = nil
	fighting[b.Player] = nil

	local winnerProfile = DataService.Get(winner.Player)
	local lostMonster = if loser.Player.Parent then MonsterService.TakeMonsterData(loser.Player, loser.MonsterId) else nil
	local prize = Config.Arena.PrizeCoins
	if lostMonster then
		prize += math.floor(MonsterMath.GetSellValue(lostMonster) * Config.Arena.PrizeValueShare)
	end
	if winner.Player.Parent and winnerProfile then
		DataService.AddCoins(winner.Player, prize)
		winnerProfile.Data.Stats.ArenaWins += 1
		if lostMonster and not MonsterService.InsertMonsterData(winner.Player, lostMonster) then
			-- مفيش مكان: بياخد قيمته فلوس
			DataService.AddCoins(winner.Player, MonsterMath.GetSellValue(lostMonster))
			MonsterService.Notify(winner.Player, "Your base was full, so you got the monster's value in coins.", "info")
		end
		MonsterService.Notify(winner.Player, "🏆 You won the battle! +" .. MonsterMath.FormatNumber(prize) .. " coins and " .. loser.Name .. "!", "success")
	end
	if loser.Player.Parent then
		MonsterService.Notify(loser.Player, "💔 You lost the battle and " .. loser.Name .. ".", "error")
	end
	MonsterService.Announce("⚔️ " .. winner.Player.DisplayName .. "'s " .. winner.Name .. " beat " .. loser.Player.DisplayName .. "'s " .. loser.Name .. " in the Arena!", Color3.fromRGB(255, 120, 120))
	for _, fighter in { a, b } do
		if fighter.Player.Parent then
			MonsterService.PushState(fighter.Player)
			task.spawn(DataService.Save, fighter.Player)
		end
	end

	task.delay(4, function()
		for _, fighter in { a, b } do
			if fighter.Model then
				fighter.Model:Destroy()
			end
		end
		battleRunning = false
		arenaSign.Text = '<font color="#FF6060">⚔️ MONSTER ARENA ⚔️</font>\nChallenge someone from the Arena button'
	end)
end

local function runBattle(a: Fighter, b: Fighter)
	battleRunning = true
	arenaSign.Text = string.format('<font color="#FF6060">⚔️ %s vs %s ⚔️</font>', a.Player.DisplayName, b.Player.DisplayName)
	sendState(a, b, "The battle begins!", false, nil)
	task.wait(1.5)
	local attacker, defender = a, b
	if math.random() < 0.5 then
		attacker, defender = b, a
	end
	for _ = 1, Config.Arena.MaxTurns do
		if not a.Player.Parent or not b.Player.Parent then
			break
		end
		local damage = math.floor(attacker.Attack * (0.75 + math.random() * 0.5))
		defender.Health -= damage
		if defender.Label then
			defender.Label.Text = fighterLabel(defender)
		end
		local model = defender.Model
		if model and model.PrimaryPart then
			local body = model.PrimaryPart
			local original = body.Color
			body.Color = Color3.fromRGB(255, 80, 80)
			task.delay(0.15, function()
				if body.Parent then
					body.Color = original
				end
			end)
		end
		sendState(a, b, attacker.Name .. " hits for " .. damage .. "!", false, nil)
		if defender.Health <= 0 then
			break
		end
		attacker, defender = defender, attacker
		task.wait(Config.Arena.TurnTime)
	end

	-- لو حد خرج من السيرفر، التاني هو الكسبان. غير كده الأعلى في نسبة الـ HP.
	local winner: Fighter
	if not a.Player.Parent then
		winner = b
	elseif not b.Player.Parent then
		winner = a
	else
		winner = if a.Health / a.MaxHealth >= b.Health / b.MaxHealth then a else b
	end
	local loser = if winner == a then b else a
	sendState(a, b, winner.Name .. " wins!", true, winner.Player)
	finishBattle(a, b, winner, loser)
end

local function ownMonster(player: Player, monsterId: unknown): MonsterMath.MonsterData?
	if type(monsterId) ~= "string" then
		return nil
	end
	local profile = DataService.Get(player)
	local monster = profile and profile.Data.Monsters[monsterId]
	if not monster or MonsterService.IsCarried(player, monsterId) then
		return nil
	end
	return monster
end

local function onChallenge(player: Player, targetUserId: unknown, monsterId: unknown)
	if type(targetUserId) ~= "number" or fighting[player] then
		return
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	local monster = ownMonster(player, monsterId)
	if not target or target == player or not monster then
		return
	end
	challenges[target] = challenges[target] or {}
	challenges[target][player] = { From = player, MonsterId = monsterId :: string, Time = os.clock() }
	remotes.ArenaIncoming:FireClient(target, player.UserId, player.DisplayName, MonsterMath.GetDisplayName(monster))
	MonsterService.Notify(player, "⚔️ Challenge sent to " .. target.DisplayName .. "!", "info")
end

local function onRespond(player: Player, fromUserId: unknown, monsterId: unknown)
	if type(fromUserId) ~= "number" then
		return
	end
	local from = Players:GetPlayerByUserId(fromUserId)
	local pending = challenges[player]
	local challenge = from and pending and pending[from]
	if not from or not pending or not challenge then
		return
	end
	pending[from] = nil
	if monsterId == nil then
		MonsterService.Notify(from, player.DisplayName .. " declined your Arena challenge.", "info")
		return
	end
	if os.clock() - challenge.Time > Config.Arena.RequestTimeout then
		MonsterService.Notify(player, "That challenge expired.", "error")
		return
	end
	if battleRunning then
		MonsterService.Notify(player, "The Arena is busy, try again in a moment!", "error")
		MonsterService.Notify(from, "The Arena is busy, try again in a moment!", "error")
		return
	end
	local mine = ownMonster(player, monsterId)
	local theirs = ownMonster(from, challenge.MonsterId)
	if not mine or not theirs or fighting[player] or fighting[from] then
		MonsterService.Notify(player, "This battle can't start right now.", "error")
		return
	end

	local function makeFighter(owner: Player, id: string, monster: MonsterMath.MonsterData): Fighter
		local health, attack = fighterStats(monster)
		return {
			Player = owner,
			MonsterId = id,
			Name = MonsterMath.GetDisplayName(monster),
			Health = health,
			MaxHealth = health,
			Attack = attack,
			Model = nil,
			Label = nil,
		}
	end
	local a = makeFighter(from, challenge.MonsterId, theirs)
	local b = makeFighter(player, monsterId :: string, mine)
	-- الوحوش مقفولة لحد ما المعركة تخلص (مفيش بيع ولا Trade)
	fighting[from] = true
	fighting[player] = true
	setCarried(from, a.MonsterId, true)
	setCarried(player, b.MonsterId, true)
	showFighter(a, pedestals[1], theirs)
	showFighter(b, pedestals[2], mine)
	task.spawn(runBattle, a, b)
end

function ArenaService.CleanupPlayer(player: Player)
	challenges[player] = nil
	for _, pending in challenges do
		pending[player] = nil
	end
end

function ArenaService.Init(allRemotes: { [string]: RemoteEvent })
	remotes = allRemotes
	buildArena()
	remotes.ArenaChallenge.OnServerEvent:Connect(onChallenge)
	remotes.ArenaRespond.OnServerEvent:Connect(onRespond)
end

return ArenaService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[--!strict
-- أدوات بناء مشتركة بين خدمات الماب (Parts و Billboards و ProximityPrompts).

local Build = {}

function Build.MakePart(props: { [string]: any }): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		if key ~= "Parent" then
			(part :: any)[key] = value
		end
	end
	part.Parent = props.Parent
	return part
end

function Build.MakeBillboard(
	adornee: BasePart,
	size: UDim2,
	offset: Vector3,
	maxDistance: number?
): (BillboardGui, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffset = offset
	gui.AlwaysOnTop = true
	gui.MaxDistance = maxDistance or 120
	gui.LightInfluence = 0
	gui.Adornee = adornee
	gui.Parent = adornee

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.RichText = true
	label.Parent = gui
	return gui, label
end

function Build.MakePrompt(parent: Instance, name: string, action: string, key: Enum.KeyCode, hold: number): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.KeyboardKeyCode = key
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

function Build.ColorToHex(color: Color3): string
	return string.format(
		"#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">CarryService</string>
          <string name="Source"><![CDATA[--!strict
-- لما تاخد وحش (من عش، من Monster Rain، أو بيضة الـ Big Boss) بيتشال على ضهرك،
-- ولازم ترجع بيه لقاعدتك عشان يبقى بتاعك. لو حد ضربك وموّتك بياخده منك
-- ولازم يرجع بيه هو كمان. لو موتّ من حاجة تانية بيقع على الأرض وأي حد يقدر ياخده.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)
local Build = require(script.Parent.Build)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local MonsterService = require(script.Parent.MonsterService)
local CombatService = require(script.Parent.CombatService)
local CharacterService = require(script.Parent.CharacterService)

export type Cargo = {
	Kind: string, -- "Monster" أو "Egg"
	Species: string?,
	Mutation: string?,
	EggType: string?,
}

type Carry = {
	Cargo: Cargo,
	Model: Model,
	DiedConnection: RBXScriptConnection?,
	LastFullWarning: number,
}

local CarryService = {}

local carries: { [Player]: Carry } = {}
local pickupsFolder: Folder

function CarryService.CargoName(cargo: Cargo): string
	if cargo.Kind == "Egg" then
		local egg = Config.Eggs[cargo.EggType :: string]
		return if egg then egg.DisplayName else "Egg"
	end
	local species = Config.Species[cargo.Species :: string]
	local name = if species then species.DisplayName else "Monster"
	return if cargo.Mutation then cargo.Mutation .. " " .. name else name
end

local function cargoColor(cargo: Cargo): string
	if cargo.Kind == "Egg" then
		return "#FFFFFF"
	end
	local species = Config.Species[cargo.Species :: string]
	local rarity = species and Config.Rarities[species.Rarity]
	return if rarity then "#" .. rarity.Color:ToHex() else "#FFFFFF"
end

-- شكل الحاجة اللي بتتشال (وحش صغير أو بيضة)
local function buildCargoModel(cargo: Cargo): Model
	if cargo.Kind == "Monster" then
		local fake: MonsterMath.MonsterData = {
			Id = "Carried",
			Species = cargo.Species :: string,
			Mutation = cargo.Mutation,
			Level = 1,
			Xp = 0,
			Hunger = 100,
			Happiness = 100,
			Slot = 0,
		}
		local model = PlotService.BuildMonsterModel(fake)
		local info = model.PrimaryPart and model.PrimaryPart:FindFirstChild("Info")
		if info then
			info:Destroy()
		end
		return model
	end
	local egg = Config.Eggs[cargo.EggType :: string]
	local model = Instance.new("Model")
	local part = Build.MakePart({
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3, 3, 3),
		Color = if egg then egg.Color else Color3.new(1, 1, 1),
		Material = if cargo.EggType == "Secret" then Enum.Material.Neon else Enum.Material.SmoothPlastic,
		CanCollide = false,
		Parent = model,
	})
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.3, 1)
	mesh.Parent = part
	if cargo.EggType == "Secret" then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(200, 120, 255)
		sparkles.Parent = part
	end
	model.PrimaryPart = part
	return model
end

function CarryService.IsCarrying(player: Player): boolean
	return carries[player] ~= nil
end

local function speedFor(cargo: Cargo): number
	return if cargo.Kind == "Egg" and cargo.EggType == "Secret"
		then Config.Carry.SecretEggSpeedMultiplier
		else Config.Carry.WalkSpeedMultiplier
end

local function stopCarry(player: Player): Cargo?
	local carry = carries[player]
	if not carry then
		return nil
	end
	carries[player] = nil
	if carry.DiedConnection then
		carry.DiedConnection:Disconnect()
	end
	carry.Model:Destroy()
	CharacterService.SetSpeedFactor(player, "Carry", nil)
	return carry.Cargo
end

-- بيحط حاجة على الأرض وأي حد يقدر ياخدها (بيستخدمها الـ Monster Rain وبيضة الـ Boss والوقعات)
function CarryService.SpawnPickup(cargo: Cargo, position: Vector3, lifetime: number, title: string?, fallHeight: number?): Model
	local model = buildCargoModel(cargo)
	model.Name = "Pickup"
	local body = model.PrimaryPart :: BasePart
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
		end
	end
	local ground = position + Vector3.new(0, body.Size.Y / 2 + 0.5, 0)
	model:PivotTo(CFrame.new(ground + Vector3.new(0, fallHeight or 0, 0)))
	model.Parent = pickupsFolder

	local gui, label = Build.MakeBillboard(body, UDim2.fromOffset(240, 60), Vector3.new(0, body.Size.Y / 2 + 3, 0), 250)
	gui.Name = "Info"
	label.Text = string.format('<font color="%s">%s</font>\n%s', cargoColor(cargo), CarryService.CargoName(cargo), title or "✋ Take it to your base!")

	local prompt = Build.MakePrompt(body, "PickupPrompt", "Take", Enum.KeyCode.E, Config.Combat.TakeHoldDuration)
	prompt.ObjectText = CarryService.CargoName(cargo)
	prompt.MaxActivationDistance = 12
	prompt.Enabled = fallHeight == nil
	prompt.Triggered:Connect(function(player)
		if model.Parent and CarryService.StartCarry(player, cargo) then
			model:Destroy()
		end
	end)

	-- بيقع من السما
	if fallHeight then
		task.spawn(function()
			local steps = 40
			for i = 1, steps do
				if not model.Parent then
					return
				end
				model:PivotTo(CFrame.new(ground + Vector3.new(0, fallHeight * (1 - i / steps), 0)))
				task.wait(0.05)
			end
			prompt.Enabled = true
		end)
	end

	task.delay(lifetime, function()
		if model.Parent then
			model:Destroy()
		end
	end)
	return model
end

local function onCarrierDied(player: Player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local position = if root then root.Position else nil
	local cargo = stopCarry(player)
	if not cargo then
		return
	end
	local name = CarryService.CargoName(cargo)

	-- اللي قتلك بياخده منك
	local killer = CombatService.GetKiller(player)
	if killer and not CarryService.IsCarrying(killer) and CarryService.StartCarry(killer, cargo) then
		local profile = DataService.Get(killer)
		if profile then
			profile.Data.Stats.Steals += 1
		end
		MonsterService.Notify(killer, "🦹 You took " .. name .. " from " .. player.DisplayName .. "! Run home!", "warning")
		MonsterService.Notify(player, "😱 " .. killer.DisplayName .. " knocked you out and took your " .. name .. "!", "error")
		return
	end

	if position then
		CarryService.SpawnPickup(cargo, position - Vector3.new(0, 3, 0), Config.Carry.DropLifetime, "💥 Dropped! Grab it!")
		MonsterService.Notify(player, "You dropped " .. name .. "! Go back and grab it.", "error")
	end
end

-- بيشيّل اللاعب حاجة على ضهره. بيرجع false لو مش هينفع (شايل حاجة أو قاعدته مليانة).
function CarryService.StartCarry(player: Player, cargo: Cargo): boolean
	if carries[player] then
		MonsterService.Notify(player, "You are already carrying something! Take it home first.", "error")
		return false
	end
	if not MonsterService.GetFreeSlot(player) then
		MonsterService.Notify(player, "Your base is full! Sell a monster or buy a new slot.", "error")
		return false
	end
	local character = player.Character
	local torso = character and (character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")) :: BasePart?
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not torso or not humanoid or humanoid.Health <= 0 then
		return false
	end

	local model = buildCargoModel(cargo)
	model.Name = "CarriedCargo"
	local body = model.PrimaryPart :: BasePart
	local scale = math.min(1, 2.6 / math.max(body.Size.Y, 0.1))
	if scale < 1 then
		model:ScaleTo(scale)
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = false
			part.Massless = true
		end
	end
	model:PivotTo(torso.CFrame * CFrame.new(0, 0.4, 0.6 + body.Size.Y / 2))
	local weldConstraint = Instance.new("WeldConstraint")
	weldConstraint.Part0 = torso
	weldConstraint.Part1 = body
	weldConstraint.Parent = body
	model.Parent = character

	local carry: Carry = { Cargo = cargo, Model = model, DiedConnection = nil, LastFullWarning = 0 }
	carry.DiedConnection = humanoid.Died:Connect(function()
		if carries[player] == carry then
			onCarrierDied(player)
		end
	end)
	carries[player] = carry
	CharacterService.SetSpeedFactor(player, "Carry", speedFor(cargo))
	MonsterService.Notify(player, "🎒 You picked up " .. CarryService.CargoName(cargo) .. "! Carry it back to your base!", "warning")
	return true
end

local function deliver(player: Player, carry: Carry)
	local cargo = carry.Cargo
	local ok = if cargo.Kind == "Egg"
		then MonsterService.AddEgg(player, cargo.EggType :: string)
		else MonsterService.AddMonster(player, cargo.Species :: string, cargo.Mutation)
	if ok then
		stopCarry(player)
	elseif os.clock() - carry.LastFullWarning > 5 then
		carry.LastFullWarning = os.clock()
		MonsterService.Notify(player, "Your base is full! Free up a slot to keep it.", "error")
	end
end

local function update()
	for player, carry in carries do
		local plot = PlotService.GetPlot(player)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not carry.Model.Parent then
			-- الشخصية اتشالت (Respawn مثلاً) من غير Died
			onCarrierDied(player)
		elseif plot and root and PlotService.IsInsidePlot(plot, root.Position) then
			deliver(player, carry)
		end
	end
end

function CarryService.CleanupPlayer(player: Player)
	if carries[player] then
		onCarrierDied(player)
	end
end

function CarryService.Init()
	pickupsFolder = Instance.new("Folder")
	pickupsFolder.Name = "Pickups"
	pickupsFolder.Parent = workspace

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.2 then
			accumulator = 0
			update()
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		CarryService.CleanupPlayer(player)
	end)
end

return CarryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">CharacterService</string>
          <string name="Source"><![CDATA[--!strict
-- كل اللاعبين بيلعبوا بشخصيات R6 من غير ما نحتاج نعمل Publish ونغيّر Game Settings:
-- بنحط Rig من نوع R6 كـ StarterCharacter، وبعدين نلبّسه شكل اللاعب نفسه (هدومه وإكسسواراته).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local Config = require(ReplicatedStorage.Shared.Config)

local CharacterService = {}

local descriptions: { [Player]: HumanoidDescription } = {}

local function getDescription(player: Player): HumanoidDescription?
	local cached = descriptions[player]
	if cached then
		return cached
	end
	if player.UserId <= 0 then
		return nil
	end
	local ok, result = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(player.UserId)
	end)
	if ok and result then
		descriptions[player] = result
		return result
	end
	return nil
end

function CharacterService.IsR6(character: Model): boolean
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.RigType == Enum.HumanoidRigType.R6
end

-- بيلبّس شخصية الـ R6 شكل اللاعب. بيستنى، فشغّله في task.spawn.
function CharacterService.ApplyAppearance(player: Player, character: Model)
	local description = getDescription(player)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not description or not humanoid or not character.Parent then
		return
	end
	local ok, err = pcall(function()
		humanoid:ApplyDescription(description)
	end)
	if not ok then
		warn("[CharacterService] Could not apply appearance for", player.Name, err)
	end
end

-- سرعة المشي = Config.WalkSpeed × كل العوامل (شايل وحش، Speed Boost، ...)
local speedFactors: { [Player]: { [string]: number } } = {}

function CharacterService.UpdateSpeed(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local speed = Config.WalkSpeed
	for _, factor in speedFactors[player] or {} do
		speed *= factor
	end
	humanoid.WalkSpeed = speed
end

function CharacterService.SetSpeedFactor(player: Player, reason: string, factor: number?)
	local factors = speedFactors[player]
	if not factors then
		factors = {}
		speedFactors[player] = factors
	end
	factors[reason] = factor
	CharacterService.UpdateSpeed(player)
end

function CharacterService.Cleanup(player: Player)
	descriptions[player] = nil
	speedFactors[player] = nil
end

function CharacterService.Init()
	if StarterPlayer:FindFirstChild("StarterCharacter") then
		return
	end
	local ok, rig = pcall(function()
		return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R6)
	end)
	if ok and rig then
		rig.Name = "StarterCharacter"
		rig.Parent = StarterPlayer
	else
		warn("[CharacterService] Could not create the R6 character:", rig)
	end
end

return CharacterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--!strict
-- الأسلحة والضرب: المضرب الخشبي لكل الناس، وسيف الـ VIP لأصحاب الـ Gamepass.
-- أي حاجة ممكن تتضرب (الوحوش الأم، الـ Big Boss) بتتسجل هنا كـ Target،
-- ولو مفيش Target قريب السلاح بيضرب أقرب لاعب (برّه القواعد بس).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Build = require(script.Parent.Build)
local PlotService = require(script.Parent.PlotService)
local MonsterService = require(script.Parent.MonsterService)

export type Target = {
	Part: BasePart,
	Radius: number, -- نص عرض الهدف، عشان المدى يتحسب من حرفه
	OnHit: (player: Player, damage: number) -> (),
}

type Tag = { Attacker: Player, Time: number }

local CombatService = {}

local targets: { [Target]: boolean } = {}
local lastSwing: { [Player]: number } = {}
local tags: { [Player]: Tag } = {}

function CombatService.Register(target: Target): Target
	targets[target] = true
	return target
end

function CombatService.Unregister(target: Target?)
	if target then
		targets[target] = nil
	end
end

local function getRoot(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- اللاعب جوه أي قاعدة؟ (القواعد أمان: مفيش ضرب لاعبين فيها)
function CombatService.IsInSafeZone(position: Vector3): boolean
	for _, plot in PlotService.GetPlots() do
		if PlotService.IsInsidePlot(plot, position) then
			return true
		end
	end
	return false
end

-- مين آخر حد ضرب اللاعب ده في آخر شوية ثواني (عشان ياخد اللي كان شايله لو مات)
function CombatService.GetKiller(victim: Player): Player?
	local tag = tags[victim]
	if tag and os.clock() - tag.Time <= Config.Carry.KillCreditTime and tag.Attacker.Parent then
		return tag.Attacker
	end
	return nil
end

local function swing(player: Player, tool: Tool, damageMultiplier: number, extraReach: number, pvpDamage: number)
	local now = os.clock()
	if lastSwing[player] and now - lastSwing[player] < Config.Combat.AttackCooldown then
		return
	end
	lastSwing[player] = now
	local root = getRoot(player)
	local humanoid = getHumanoid(player)
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end

	-- أنيميشن الضربة بتاع R6
	local animation = Instance.new("StringValue")
	animation.Name = "toolanim"
	animation.Value = "Slash"
	animation.Parent = tool

	-- الأول: أقرب وحش أم أو Boss في المدى
	local best: Target? = nil
	local bestDistance = math.huge
	for target in targets do
		if target.Part.Parent then
			local distance = flatDistance(root.Position, target.Part.Position) - target.Radius
			if distance <= Config.Combat.BatReach + extraReach and distance < bestDistance then
				best = target
				bestDistance = distance
			end
		end
	end
	if best then
		best.OnHit(player, math.floor(MonsterService.GetAttackDamage(player) * damageMultiplier))
		return
	end

	-- مفيش: نضرب أقرب لاعب (برّه القواعد)
	if CombatService.IsInSafeZone(root.Position) then
		return
	end
	local victim: Player? = nil
	local victimDistance = math.huge
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local otherRoot = getRoot(other)
			local otherHumanoid = getHumanoid(other)
			if otherRoot and otherHumanoid and otherHumanoid.Health > 0 then
				local distance = (otherRoot.Position - root.Position).Magnitude
				if distance <= Config.PvP.Reach + extraReach and distance < victimDistance and not CombatService.IsInSafeZone(otherRoot.Position) then
					victim = other
					victimDistance = distance
				end
			end
		end
	end
	if victim then
		local victimHumanoid = getHumanoid(victim)
		if victimHumanoid then
			tags[victim] = { Attacker = player, Time = now }
			victimHumanoid:TakeDamage(pvpDamage)
		end
	end
end

local function weld(part0: BasePart, part1: BasePart)
	local constraint = Instance.new("WeldConstraint")
	constraint.Part0 = part0
	constraint.Part1 = part1
	constraint.Parent = part1
end

local function makeBat(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Bat"
	tool.ToolTip = "Hit the mother monsters!"
	tool.CanBeDropped = false
	tool.GripPos = Vector3.new(0, 0, 0.6) -- اللاعب ماسكه من آخره
	local handle = Build.MakePart({
		Name = "Handle",
		Size = Vector3.new(0.5, 0.5, 2.2),
		Color = Color3.fromRGB(140, 95, 55),
		Material = Enum.Material.Wood,
		Anchored = false,
		CanCollide = false,
		Massless = true,
	})
	handle.Parent = tool
	local barrel = Build.MakePart({
		Name = "Barrel",
		Size = Vector3.new(0.85, 0.85, 2.6),
		CFrame = handle.CFrame * CFrame.new(0, 0, -2.3),
		Color = Color3.fromRGB(170, 120, 70),
		Material = Enum.Material.Wood,
		Anchored = false,
		CanCollide = false,
		Massless = true,
	})
	barrel.Parent = tool
	weld(handle, barrel)
	return tool
end

local function makeSword(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "VIP Sword"
	tool.ToolTip = "VIP: hits much harder!"
	tool.CanBeDropped = false
	tool.GripPos = Vector3.new(0, 0, 0.4)
	local handle = Build.MakePart({
		Name = "Handle",
		Size = Vector3.new(0.4, 0.4, 1.4),
		Color = Color3.fromRGB(60, 40, 30),
		Material = Enum.Material.Wood,
		Anchored = false,
		CanCollide = false,
		Massless = true,
	})
	handle.Parent = tool
	local guard = Build.MakePart({
		Name = "Guard",
		Size = Vector3.new(1.8, 0.3, 0.3),
		CFrame = handle.CFrame * CFrame.new(0, 0, -0.85),
		Color = Color3.fromRGB(255, 205, 50),
		Material = Enum.Material.Foil,
		Anchored = false,
		CanCollide = false,
		Massless = true,
	})
	guard.Parent = tool
	weld(handle, guard)
	local blade = Build.MakePart({
		Name = "Blade",
		Size = Vector3.new(0.25, 0.6, 4.2),
		CFrame = handle.CFrame * CFrame.new(0, 0, -3.1),
		Color = Color3.fromRGB(120, 220, 255),
		Material = Enum.Material.Neon,
		Anchored = false,
		CanCollide = false,
		Massless = true,
	})
	blade.Parent = tool
	weld(handle, blade)
	return tool
end

-- بيدّي اللاعب أسلحته (بيتنادى كل ما الشخصية تتولد، عشان الـ Backpack بيتمسح)
function CombatService.GiveWeapons(player: Player, hasSword: boolean)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	local character = player.Character
	local function has(name: string): boolean
		return backpack:FindFirstChild(name) ~= nil or (character ~= nil and character:FindFirstChild(name) ~= nil)
	end
	if not has("Bat") then
		local bat = makeBat()
		bat.Activated:Connect(function()
			swing(player, bat, 1, 0, Config.PvP.BatDamage)
		end)
		bat.Parent = backpack
	end
	if hasSword and not has("VIP Sword") then
		local sword = makeSword()
		sword.Activated:Connect(function()
			swing(player, sword, Config.VIPSword.DamageMultiplier, Config.VIPSword.ExtraReach, Config.PvP.SwordDamage)
		end)
		sword.Parent = backpack
	end
end

function CombatService.CleanupPlayer(player: Player)
	lastSwing[player] = nil
	tags[player] = nil
	for victim, tag in tags do
		if tag.Attacker == player then
			tags[victim] = nil
		end
	end
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--!strict
-- حفظ وتحميل بيانات اللاعبين باستخدام DataStoreService.
-- لو التحميل فشل، اللاعب بيلعب ببيانات مؤقتة ومش بنحفظ فوق بياناته القديمة.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)

export type EggData = {
	Id: string,
	EggType: string,
	Slot: number,
	HatchAt: number,
}

export type PlayerData = {
	Version: number,
	Coins: number,
	PendingCoins: number,
	TotalEarned: number,
	Monsters: { [string]: MonsterMath.MonsterData },
	Eggs: { [string]: EggData },
	SlotUpgrades: number,
	LockUpgrades: number,
	NextId: number,
	Stats: { Hatched: number, Steals: number, TimesRobbed: number, ArenaWins: number },
	Accessories: { [string]: boolean }, -- الإكسسوارات اللي اللاعب اشتراها
	Daily: { LastClaim: number, Streak: number },
	LastSpin: number,
}

export type Profile = {
	Data: PlayerData,
	LoadFailed: boolean,
}

local DEFAULT_DATA: PlayerData = {
	Version = 1,
	Coins = Config.StartingCoins,
	PendingCoins = 0,
	TotalEarned = 0,
	Monsters = {},
	Eggs = {},
	SlotUpgrades = 0,
	LockUpgrades = 0,
	NextId = 1,
	Stats = { Hatched = 0, Steals = 0, TimesRobbed = 0, ArenaWins = 0 },
	Accessories = {},
	Daily = { LastClaim = 0, Streak = 0 },
	LastSpin = 0,
}

local MAX_RETRIES = 3

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore unavailable (enable Studio Access to API Services):", result)
	end
end

local profiles: { [Player]: Profile } = {}

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- يضيف أي مفاتيح جديدة اتضافت للـ DEFAULT_DATA من غير ما يمسح القديم.
local function reconcile(target: { [any]: any }, template: { [any]: any })
	for key, value in template do
		if target[key] == nil then
			target[key] = deepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil then
			reconcile(target[key], value)
		end
	end
end

local function withRetries<T>(callback: () -> T): (boolean, T | string)
	local lastError: any
	for attempt = 1, MAX_RETRIES do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		task.wait(attempt)
	end
	return false, tostring(lastError)
end

local function keyFor(player: Player): string
	return "Player_" .. player.UserId
end

local DataService = {}

function DataService.Load(player: Player): Profile
	local data: PlayerData = deepCopy(DEFAULT_DATA)
	local loadFailed = false

	if store then
		local dataStore = store :: DataStore
		local ok, result = withRetries(function()
			return dataStore:GetAsync(keyFor(player))
		end)
		if ok then
			if type(result) == "table" then
				data = result :: any
				reconcile(data :: any, DEFAULT_DATA :: any)
			end
		else
			loadFailed = true
			warn("[DataService] Failed to load data for", player.Name, result)
		end
	else
		loadFailed = true
	end

	local profile: Profile = { Data = data, LoadFailed = loadFailed }
	profiles[player] = profile
	return profile
end

function DataService.Get(player: Player): Profile?
	return profiles[player]
end

function DataService.Save(player: Player): boolean
	local profile = profiles[player]
	if not profile or profile.LoadFailed or not store then
		return false
	end
	local dataStore = store :: DataStore
	local snapshot = deepCopy(profile.Data)
	local ok, err = withRetries(function()
		dataStore:UpdateAsync(keyFor(player), function()
			return snapshot
		end)
		return true
	end)
	if not ok then
		warn("[DataService] Failed to save data for", player.Name, err)
	end
	return ok
end

function DataService.Release(player: Player)
	DataService.Save(player)
	profiles[player] = nil
end

function DataService.NewId(player: Player): string
	local profile = profiles[player]
	assert(profile, "No profile")
	local id = tostring(profile.Data.NextId)
	profile.Data.NextId += 1
	return id
end

function DataService.AddCoins(player: Player, amount: number)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.Data.Coins += amount
	if amount > 0 then
		profile.Data.TotalEarned += amount
	end
end

function DataService.TrySpend(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or profile.Data.Coins < amount then
		return false
	end
	profile.Data.Coins -= amount
	return true
end

function DataService.StartAutosave()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in profiles do
				task.spawn(DataService.Save, player)
			end
		end
	end)

	game:BindToClose(function()
		local remaining = 0
		for player in profiles do
			remaining += 1
			task.spawn(function()
				DataService.Save(player)
				remaining -= 1
			end)
		end
		local started = os.clock()
		while remaining > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--!strict
-- أحداث الماب:
--  • Monster Rain كل ساعة: وحش نادر بيقع في نص الماب، وأول واحد يمسكه ويوصله قاعدته ياخده.
--  • Big Boss كل شوية (عشوائي): وحش ضخم دمه وضربته عاليين، لازم الكل يتجمع يقتله،
--    ولما يموت بيسيب بيضة Secret. اللي يشيلها بيمشي أبطأ شوية لحد ما يوصلها قاعدته.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)
local Build = require(script.Parent.Build)
local MonsterService = require(script.Parent.MonsterService)
local CombatService = require(script.Parent.CombatService)
local CarryService = require(script.Parent.CarryService)

local EventService = {}

local RAIN_POSITION = Vector3.new(20, 0.2, 0) -- نص الساحة قدام القواعد
local BOSS_COLOR = Color3.fromRGB(40, 20, 50)

type Boss = {
	Part: BasePart,
	Health: number,
	MaxHealth: number,
	Fill: Frame,
	Text: TextLabel,
	Target: CombatService.Target,
	Dead: boolean,
}

local eventsFolder: Folder
local boss: Boss? = nil

-- Monster Rain ----------------------------------------------------------------------------

function EventService.MonsterRain()
	local pool = Config.MonsterRain.Species
	local species = pool[math.random(1, #pool)]
	local cargo: CarryService.Cargo = {
		Kind = "Monster",
		Species = species,
		Mutation = MonsterService.RollMutation(Config.MonsterRain.MutationChanceMultiplier),
	}
	CarryService.SpawnPickup(cargo, RAIN_POSITION, Config.MonsterRain.Lifetime, "🌧️ MONSTER RAIN! Grab it and run home!", 140)
	MonsterService.Announce("🌧️ MONSTER RAIN! A " .. CarryService.CargoName(cargo) .. " is falling in the middle of the map!", Color3.fromRGB(120, 200, 255))
end

-- Big Boss ---------------------------------------------------------------------------------

local function updateBossBar(current: Boss)
	current.Fill.Size = UDim2.fromScale(math.clamp(current.Health / current.MaxHealth, 0, 1), 1)
	current.Text.Text = MonsterMath.FormatNumber(math.max(0, current.Health)) .. " / " .. MonsterMath.FormatNumber(current.MaxHealth)
end

local function removeBoss(current: Boss)
	current.Dead = true
	CombatService.Unregister(current.Target)
	current.Part:Destroy()
	if boss == current then
		boss = nil
	end
end

local function killBoss(current: Boss, killer: Player)
	local position = current.Part.Position
	removeBoss(current)
	MonsterService.Announce("💀 " .. killer.DisplayName .. " landed the final hit on the BIG BOSS! A SECRET EGG dropped!", Color3.fromRGB(200, 120, 255))
	CarryService.SpawnPickup(
		{ Kind = "Egg", EggType = "Secret" },
		Vector3.new(position.X, 0.2, position.Z),
		Config.Boss.Lifetime,
		"🌌 SECRET EGG! Carry it home (it's heavy)"
	)
end

function EventService.SpawnBoss()
	if boss then
		return
	end
	local settings = Config.Boss
	local maxHealth = math.max(settings.MinHealth, settings.HealthPerPlayer * #Players:GetPlayers())
	local part = Build.MakePart({
		Name = "BigBoss",
		Size = Vector3.one * settings.Size,
		Position = settings.Position + Vector3.new(0, settings.Size / 2, 0),
		Color = BOSS_COLOR,
		Material = Enum.Material.SmoothPlastic,
		Parent = eventsFolder,
	})
	local fire = Instance.new("Fire")
	fire.Color = Color3.fromRGB(170, 60, 255)
	fire.SecondaryColor = Color3.fromRGB(60, 20, 120)
	fire.Size = 14
	fire.Parent = part

	local gui, label = Build.MakeBillboard(part, UDim2.fromScale(30, 8), Vector3.new(0, settings.Size / 2 + 5, 0), 400)
	gui.AlwaysOnTop = false
	label.Size = UDim2.fromScale(1, 0.55)
	label.Text = '<font color="#C878FF">💀 BIG BOSS 💀</font>\nTeam up to defeat it!'
	local bar = Instance.new("Frame")
	bar.Size = UDim2.fromScale(1, 0.35)
	bar.Position = UDim2.fromScale(0, 0.62)
	bar.BackgroundColor3 = Color3.fromRGB(40, 20, 20)
	bar.BorderSizePixel = 0
	bar.Parent = gui
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(190, 60, 255)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0.3
	text.ZIndex = 2
	text.Parent = bar

	local current: Boss
	current = {
		Part = part,
		Health = maxHealth,
		MaxHealth = maxHealth,
		Fill = fill,
		Text = text,
		Dead = false,
		Target = CombatService.Register({
			Part = part,
			Radius = settings.Size / 2,
			OnHit = function(player: Player, damage: number)
				if current.Dead then
					return
				end
				current.Health -= damage
				part.Color = Color3.fromRGB(255, 90, 90)
				task.delay(0.1, function()
					if part.Parent then
						part.Color = BOSS_COLOR
					end
				end)
				if current.Health <= 0 then
					killBoss(current, player)
				else
					updateBossBar(current)
				end
			end,
		}),
	}
	boss = current
	updateBossBar(current)
	MonsterService.Announce("💀 A BIG BOSS appeared in Zone 1! Everyone team up to defeat it and win a SECRET EGG!", Color3.fromRGB(200, 120, 255))

	-- بيضرب كل اللي جنبه
	task.spawn(function()
		while not current.Dead do
			task.wait(settings.AttackInterval)
			if current.Dead then
				break
			end
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if root and humanoid and humanoid.Health > 0 then
					local flat = Vector3.new(root.Position.X - part.Position.X, 0, root.Position.Z - part.Position.Z)
					if flat.Magnitude <= settings.AttackRange then
						humanoid:TakeDamage(settings.Damage)
					end
				end
			end
		end
	end)

	-- لو محدش قتله بيمشي
	task.delay(settings.Lifetime, function()
		if boss == current and not current.Dead then
			removeBoss(current)
			MonsterService.Announce("The Big Boss got away... maybe next time!", Color3.fromRGB(200, 200, 200))
		end
	end)
end

function EventService.Init()
	eventsFolder = Instance.new("Folder")
	eventsFolder.Name = "Events"
	eventsFolder.Parent = workspace

	task.spawn(function()
		while true do
			task.wait(Config.MonsterRain.Interval)
			EventService.MonsterRain()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(math.random(Config.Boss.MinInterval, Config.Boss.MaxInterval))
			EventService.SpawnBoss()
		end
	end)

	-- في Studio بس: تقدر تشغّل الأحداث من الـ Command Bar عشان تجرّبها:
	--   game.ServerStorage.RaiseAMonsterDebug.MonsterRain:Fire()
	--   game.ServerStorage.RaiseAMonsterDebug.Boss:Fire()
	if RunService:IsStudio() then
		local folder = Instance.new("Folder")
		folder.Name = "RaiseAMonsterDebug"
		-- KillBoss: آخر ضربة باسم أول لاعب (عشان تجرّب بيضة الـ Secret من غير مئات الضربات)
		local function killBossForTest()
			local current = boss
			local first = Players:GetPlayers()[1]
			if current and first then
				current.Target.OnHit(first, current.Health + 1)
			end
		end
		for name, callback in { MonsterRain = EventService.MonsterRain, Boss = EventService.SpawnBoss, KillBoss = killBossForTest } do
			local event = Instance.new("BindableEvent")
			event.Name = name
			event.Event:Connect(callback)
			event.Parent = folder
		end
		folder.Parent = game:GetService("ServerStorage")
	end
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--!strict
-- لوحات في الساحة: الأغنى، أكتر حرامي، وأكتر وحوش Legendary.
-- بتستخدم OrderedDataStore عشان تبقى لكل اللاعبين (بعد الـ Publish)،
-- ولو مش متاحة (زي في Studio قبل الـ Publish) بتعرض اللاعبين اللي في السيرفر بس.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)
local Build = require(script.Parent.Build)
local DataService = require(script.Parent.DataService)

type Board = {
	Key: string,
	Title: string,
	Color: Color3,
	Value: (data: DataService.PlayerData) -> number,
	Store: OrderedDataStore?,
	Rows: { TextLabel },
	Position: Vector3,
}

local LeaderboardService = {}

local function countLegendary(data: DataService.PlayerData): number
	local count = 0
	for _, monster in data.Monsters do
		if MonsterMath.GetStage(monster.Level).Name == "Legendary" then
			count += 1
		end
	end
	return count
end

local boards: { Board } = {
	{
		Key = "Richest",
		Title = "💰 Richest",
		Color = Color3.fromRGB(255, 210, 70),
		Value = function(data)
			return math.floor(data.Coins)
		end,
		Store = nil,
		Rows = {},
		Position = Vector3.new(44, 0, 55),
	},
	{
		Key = "Thief",
		Title = "🦹 Top Thief",
		Color = Color3.fromRGB(255, 100, 100),
		Value = function(data)
			return data.Stats.Steals
		end,
		Store = nil,
		Rows = {},
		Position = Vector3.new(44, 0, 80),
	},
	{
		Key = "Legendary",
		Title = "👑 Most Legendary",
		Color = Color3.fromRGB(255, 170, 40),
		Value = countLegendary,
		Store = nil,
		Rows = {},
		Position = Vector3.new(44, 0, 105),
	},
}

local names: { [number]: string } = {}

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		names[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, result = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local name = if ok and result then result else "Player"
	names[userId] = name
	return name
end

local function buildBoard(folder: Folder, board: Board)
	local cframe = CFrame.lookAt(board.Position, board.Position + Vector3.new(-1, 0, 0))
	for _, side in { -1, 1 } do
		Build.MakePart({
			Name = "Post",
			Size = Vector3.new(0.8, 16, 0.8),
			CFrame = cframe * CFrame.new(side * 5.6, 8, 0.4),
			Color = Color3.fromRGB(70, 50, 35),
			Material = Enum.Material.Wood,
			Parent = folder,
		})
	end
	local panel = Build.MakePart({
		Name = board.Key .. "Board",
		Size = Vector3.new(11, 12, 0.6),
		CFrame = cframe * CFrame.new(0, 9.5, 0),
		Color = Color3.fromRGB(30, 30, 45),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(440, 480)
	gui.LightInfluence = 0
	gui.Parent = panel

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 60)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = board.Color
	title.Text = board.Title
	title.Parent = gui
	for i = 1, Config.Leaderboards.TopCount do
		local row = Instance.new("TextLabel")
		row.Size = UDim2.new(1, -20, 0, 38)
		row.Position = UDim2.fromOffset(10, 62 + (i - 1) * 41)
		row.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(40, 40, 60) else Color3.fromRGB(48, 48, 70)
		row.Font = Enum.Font.FredokaOne
		row.TextSize = 26
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = Color3.new(1, 1, 1)
		row.Text = ""
		row.Parent = gui
		table.insert(board.Rows, row)
	end
end

local function show(board: Board, entries: { { Name: string, Value: number } })
	for i, row in board.Rows do
		local entry = entries[i]
		if entry then
			local medal = if i == 1 then "🥇" elseif i == 2 then "🥈" elseif i == 3 then "🥉" else "#" .. i
			row.Text = string.format("  %s  %s  ·  %s", medal, entry.Name, MonsterMath.FormatNumber(entry.Value))
		else
			row.Text = ""
		end
	end
end

local function refreshBoard(board: Board)
	-- نحدّث أرقام اللاعبين اللي في السيرفر
	local local_entries = {}
	for _, player in Players:GetPlayers() do
		local profile = DataService.Get(player)
		if profile then
			local value = board.Value(profile.Data)
			table.insert(local_entries, { Name = player.DisplayName, Value = value })
			local store = board.Store
			if store and not profile.LoadFailed then
				pcall(function()
					store:SetAsync(tostring(player.UserId), value)
				end)
			end
		end
	end

	local store = board.Store
	if store then
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, Config.Leaderboards.TopCount)
		end)
		if ok and pages then
			local entries = {}
			for _, item in (pages :: DataStorePages):GetCurrentPage() do
				table.insert(entries, { Name = nameOf(tonumber(item.key) or 0), Value = item.value })
			end
			show(board, entries)
			return
		end
	end
	table.sort(local_entries, function(a, b)
		return a.Value > b.Value
	end)
	show(board, local_entries)
end

function LeaderboardService.Init()
	local folder = Instance.new("Folder")
	folder.Name = "Leaderboards"
	folder.Parent = workspace
	for _, board in boards do
		buildBoard(folder, board)
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore("Leaderboard_" .. board.Key .. "_v1")
		end)
		if ok then
			board.Store = store
		end
	end
	task.spawn(function()
		task.wait(5)
		while true do
			for _, board in boards do
				refreshBoard(board)
			end
			task.wait(Config.Leaderboards.UpdateInterval)
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[--!strict
-- Gamepasses و Developer Products.
-- الـ Ids بتتحط في Config.Gamepasses و Config.Products بعد ما تعملهم من Creator Dashboard.
-- لو Id = 0 وانت في Studio، الزرار بيدّيك الحاجة مجاناً عشان تقدر تجرّبها.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local MonsterService = require(script.Parent.MonsterService)
local CharacterService = require(script.Parent.CharacterService)
local CombatService = require(script.Parent.CombatService)

local MonetizationService = {}

local owned: { [Player]: { [string]: boolean } } = {}
local boostUntil: { [Player]: number } = {}
local lastPrompt: { [Player]: number } = {}

function MonetizationService.HasPass(player: Player, name: string): boolean
	local set = owned[player]
	return set ~= nil and set[name] == true
end

function MonetizationService.GetOwnedPasses(player: Player): { [string]: boolean }
	return owned[player] or {}
end

function MonetizationService.BoostLeft(player: Player): number
	return math.max(0, (boostUntil[player] or 0) - os.clock())
end

-- لما الـ Pass يتفعّل (اشترى أو دخل وهو معاه)
local function onPassGranted(player: Player, name: string)
	if name == "VIPSword" then
		CombatService.GiveWeapons(player, true)
	elseif name == "ExtraSlots" then
		PlotService.SetUnlockedSlots(player, MonsterService.GetUnlockedSlots(player))
	end
	MonsterService.PushState(player)
end

local function grantPass(player: Player, name: string)
	owned[player] = owned[player] or {}
	if owned[player][name] then
		return
	end
	owned[player][name] = true
	onPassGranted(player, name)
end

-- Developer Products: بيرجع true لو اتنفذ
local function grantProduct(player: Player, name: string): boolean
	if name == "InstantHatch" then
		if not MonsterService.HatchAllNow(player) then
			MonsterService.Notify(player, "You have no eggs to hatch right now!", "error")
			return false
		end
		MonsterService.Notify(player, "⚡ All your eggs are hatching now!", "success")
		return true
	elseif name == "LuckyEgg" then
		if not MonsterService.AddEgg(player, "Lucky") then
			MonsterService.Notify(player, "Your base is full! Free a slot first.", "error")
			return false
		end
		return true
	elseif name == "SpeedBoost" then
		local start = math.max(os.clock(), boostUntil[player] or 0)
		boostUntil[player] = start + Config.SpeedBoost.Duration
		CharacterService.SetSpeedFactor(player, "Boost", Config.SpeedBoost.Multiplier)
		MonsterService.Notify(player, "💨 Speed Boost for 10 minutes!", "success")
		return true
	end
	return false
end

local function buyPass(player: Player, name: unknown)
	if type(name) ~= "string" then
		return
	end
	local pass = Config.Gamepasses[name]
	if not pass then
		return
	end
	if MonetizationService.HasPass(player, name) then
		MonsterService.Notify(player, "You already own " .. pass.Name .. "!", "info")
		return
	end
	if pass.Id == 0 then
		if RunService:IsStudio() then
			grantPass(player, name)
			MonsterService.Notify(player, "🧪 Studio test: you got " .. pass.Name .. " for free.", "success")
		else
			MonsterService.Notify(player, pass.Name .. " is coming soon!", "info")
		end
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

local function buyProduct(player: Player, name: unknown)
	if type(name) ~= "string" then
		return
	end
	local product = Config.Products[name]
	if not product then
		return
	end
	local now = os.clock()
	if lastPrompt[player] and now - lastPrompt[player] < 1 then
		return
	end
	lastPrompt[player] = now
	if product.Id == 0 then
		if RunService:IsStudio() then
			if grantProduct(player, name) then
				MonsterService.Notify(player, "🧪 Studio test: " .. product.Name .. " for free.", "success")
			end
		else
			MonsterService.Notify(player, product.Name .. " is coming soon!", "info")
		end
		MonsterService.PushState(player)
		return
	end
	MarketplaceService:PromptProductPurchase(player, product.Id)
end

local function loadPasses(player: Player)
	for name, pass in Config.Gamepasses do
		if pass.Id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and has then
				grantPass(player, name)
			end
		end
	end
end

function MonetizationService.SetupPlayer(player: Player)
	owned[player] = owned[player] or {}
	task.spawn(loadPasses, player)
end

-- بيتنادى كل ما الشخصية تتولد
function MonetizationService.OnCharacter(player: Player)
	if MonetizationService.BoostLeft(player) > 0 then
		CharacterService.SetSpeedFactor(player, "Boost", Config.SpeedBoost.Multiplier)
	end
end

function MonetizationService.CleanupPlayer(player: Player)
	owned[player] = nil
	boostUntil[player] = nil
	lastPrompt[player] = nil
end

function MonetizationService.Init(remotes: { [string]: RemoteEvent })
	remotes.BuyPass.OnServerEvent:Connect(buyPass)
	remotes.BuyProduct.OnServerEvent:Connect(buyProduct)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for name, pass in Config.Gamepasses do
			if pass.Id == passId then
				grantPass(player, name)
				MonsterService.Notify(player, "🎉 Thanks! You now own " .. pass.Name .. "!", "success")
			end
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player or not DataService.Get(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		for name, product in Config.Products do
			if product.Id == receipt.ProductId then
				if grantProduct(player, name) then
					MonsterService.PushState(player)
					task.spawn(DataService.Save, player)
					return Enum.ProductPurchaseDecision.PurchaseGranted
				end
				return Enum.ProductPurchaseDecision.NotProcessedYet
			end
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- الـ Speed Boost بيخلص
	task.spawn(function()
		while true do
			task.wait(1)
			for player, untilTime in boostUntil do
				if os.clock() >= untilTime then
					boostUntil[player] = nil
					CharacterService.SetSpeedFactor(player, "Boost", nil)
					if player.Parent then
						MonsterService.Notify(player, "Your Speed Boost ended.", "info")
					end
				end
			end
		end
	end)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">MonsterService</string>
          <string name="Source"><![CDATA[--!strict
-- الاقتصاد والتربية: شراء البيض، الفقس، الأكل واللعب، الـ XP والتطور، الإنتاج، البيع والترقيات.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)

type Remotes = { [string]: RemoteEvent }

local MonsterService = {}

-- الوحوش اللي حد شايلها دلوقتي (بيتملى من StealService): carried[owner][monsterId] = true
MonsterService.Carried = {} :: { [Player]: { [string]: boolean } }

-- Hooks بتتربط في init.server (عشان مايبقاش فيه require دايري بين الخدمات)
MonsterService.HasPass = function(_player: Player, _name: string): boolean
	return false
end
MonsterService.ExtraState = function(_player: Player): { [string]: any }
	return {}
end

local remotes: Remotes
local lastPlay: { [Player]: { [string]: number } } = {}
local lastAction: { [Player]: number } = {}
local lastCollect: { [Player]: number } = {}

local function rateLimited(player: Player): boolean
	local now = os.clock()
	if lastAction[player] and now - lastAction[player] < 0.15 then
		return true
	end
	lastAction[player] = now
	return false
end

function MonsterService.Notify(player: Player, text: string, kind: string?)
	remotes.Notify:FireClient(player, text, kind or "info")
end

function MonsterService.IsCarried(owner: Player, monsterId: string): boolean
	local set = MonsterService.Carried[owner]
	return set ~= nil and set[monsterId] == true
end

function MonsterService.GetUnlockedSlots(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 0
	end
	local extra = if MonsterService.HasPass(player, "ExtraSlots") then Config.ExtraSlotsAmount else 0
	return math.min(Config.MaxSlots, Config.BaseSlots + profile.Data.SlotUpgrades + extra)
end

function MonsterService.GetFreeSlot(player: Player): number?
	local profile = DataService.Get(player)
	if not profile then
		return nil
	end
	local used: { [number]: boolean } = {}
	for _, monster in profile.Data.Monsters do
		used[monster.Slot] = true
	end
	for _, egg in profile.Data.Eggs do
		used[egg.Slot] = true
	end
	for slot = 1, MonsterService.GetUnlockedSlots(player) do
		if not used[slot] then
			return slot
		end
	end
	return nil
end

function MonsterService.CountMonsters(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 0
	end
	local count = 0
	for _ in profile.Data.Monsters do
		count += 1
	end
	return count
end

-- بيبعت للاعب نسخة من بياناته + أرقام محسوبة عشان الواجهة.
function MonsterService.PushState(player: Player)
	local profile = DataService.Get(player)
	local plot = PlotService.GetPlot(player)
	if not profile or not plot then
		return
	end
	local data = profile.Data
	local now = os.clock()

	local monsters = {}
	for id, monster in data.Monsters do
		local species = Config.Species[monster.Species]
		local played = lastPlay[player] and lastPlay[player][id] or 0
		table.insert(monsters, {
			Id = id,
			Species = monster.Species,
			DisplayName = MonsterMath.GetDisplayName(monster),
			Rarity = species.Rarity,
			Mutation = monster.Mutation,
			Level = monster.Level,
			Xp = monster.Xp,
			XpNeeded = Config.XpForLevel(monster.Level),
			MaxLevel = monster.Level >= Config.MaxLevel,
			Stage = MonsterMath.GetStage(monster.Level).Name,
			Hunger = monster.Hunger,
			Happiness = monster.Happiness,
			Production = MonsterMath.GetProduction(monster),
			SellValue = MonsterMath.GetSellValue(monster),
			FoodCost = MonsterMath.GetFoodCost(monster),
			PlayReadyIn = math.max(0, Config.MiniGames.Cooldown - (now - played)),
			Slot = monster.Slot,
			Hat = monster.Hat,
			Glasses = monster.Glasses,
			Carried = MonsterService.IsCarried(player, id),
		})
	end

	local eggs = {}
	local nowTime = os.time()
	for _, egg in data.Eggs do
		table.insert(eggs, {
			Id = egg.Id,
			EggType = egg.EggType,
			SecondsLeft = math.max(0, egg.HatchAt - nowTime),
		})
	end

	local nextSlotCost = Config.SlotUpgradeCosts[data.SlotUpgrades + 1]
	local nextLockCost = Config.LockUpgradeCosts[data.LockUpgrades + 1]

	local state: { [string]: any } = {
		Coins = data.Coins,
		PendingCoins = data.PendingCoins,
		UnlockedSlots = MonsterService.GetUnlockedSlots(player),
		MaxSlots = Config.MaxSlots,
		NextSlotCost = nextSlotCost,
		LockDuration = Config.LockDuration + data.LockUpgrades * Config.LockDurationPerUpgrade,
		NextLockCost = nextLockCost,
		LockedFor = math.max(0, plot.LockedUntil - now),
		LockCooldown = math.max(0, plot.LockCooldownUntil - now),
		Monsters = monsters,
		Eggs = eggs,
		Stats = data.Stats,
		SaveDisabled = profile.LoadFailed,
		Accessories = data.Accessories,
		CoinMultiplier = MonsterService.GetCoinMultiplier(player),
	}
	for key, value in MonsterService.ExtraState(player) do
		state[key] = value
	end
	remotes.StateUpdate:FireClient(player, state)
end

-- VIP بيضاعف الفلوس
function MonsterService.GetCoinMultiplier(player: Player): number
	return if MonsterService.HasPass(player, "VIP") then Config.VIPCoinMultiplier else 1
end

-- البيض والفقس --------------------------------------------------------------------

local function rollWeighted(weights: { [string]: number }): string
	local total = 0
	for _, weight in weights do
		total += weight
	end
	local roll = math.random() * total
	local last = ""
	for name, weight in weights do
		last = name
		roll -= weight
		if roll <= 0 then
			return name
		end
	end
	return last
end

-- multiplier بيكبّر فرصة الطفرة (الـ Monster Rain مثلاً)
function MonsterService.RollMutation(multiplier: number?): string?
	for _, mutation in Config.Mutations do
		if math.random() < mutation.Chance * (multiplier or 1) then
			return mutation.Name
		end
	end
	return nil
end
local rollMutation = MonsterService.RollMutation

-- إعلان كبير لكل اللي في السيرفر
function MonsterService.Announce(text: string, color: Color3?)
	remotes.Announce:FireAllClients(text, color or Color3.fromRGB(255, 220, 90))
end

local function buyEgg(player: Player, eggType: unknown)
	if rateLimited(player) or type(eggType) ~= "string" then
		return
	end
	local egg = Config.Eggs[eggType]
	local profile = DataService.Get(player)
	if not egg or not profile or not table.find(Config.ShopEggs, eggType) then
		return
	end
	if not MonsterService.GetFreeSlot(player) then
		MonsterService.Notify(player, "Your base is full! Sell a monster or buy a new slot.", "error")
		return
	end
	if not DataService.TrySpend(player, egg.Cost) then
		MonsterService.Notify(player, "Not enough coins!", "error")
		return
	end
	MonsterService.AddEgg(player, eggType)
end

-- بيحط بيضة في أول مكان فاضي في القاعدة
function MonsterService.AddEgg(player: Player, eggType: string): boolean
	local egg = Config.Eggs[eggType]
	local profile = DataService.Get(player)
	local slot = MonsterService.GetFreeSlot(player)
	if not egg or not profile or not slot then
		return false
	end
	local id = DataService.NewId(player)
	profile.Data.Eggs[id] = {
		Id = id,
		EggType = eggType,
		Slot = slot,
		HatchAt = os.time() + egg.HatchTime,
	}
	PlotService.RenderEgg(player, id, eggType, slot)
	MonsterService.Notify(player, "🥚 " .. egg.DisplayName .. " placed in your base! Wait for it to hatch.", "success")
	MonsterService.PushState(player)
	return true
end

-- بيفقس كل البيض دلوقتي (Developer Product)
function MonsterService.HatchAllNow(player: Player): boolean
	local profile = DataService.Get(player)
	if not profile or next(profile.Data.Eggs) == nil then
		return false
	end
	for _, egg in profile.Data.Eggs do
		egg.HatchAt = 0
	end
	return true
end

local function hatch(player: Player, eggData: DataService.EggData)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local egg = Config.Eggs[eggData.EggType]
	local species = if egg then rollWeighted(egg.Weights) else "Blobby"
	-- وحوش Secret: فرصة صغيرة جداً من أي بيضة (وأكبر شوية من بيضة الحظ)
	local secretChance = Config.SecretChance * (if eggData.EggType == "Lucky" then Config.LuckyEggSecretMultiplier else 1)
	if math.random() < secretChance then
		species = Config.SecretSpecies[math.random(1, #Config.SecretSpecies)]
	end
	local monster: MonsterMath.MonsterData = {
		Id = eggData.Id,
		Species = species,
		Mutation = rollMutation(),
		Level = 1,
		Xp = 0,
		Hunger = 100,
		Happiness = 100,
		Slot = eggData.Slot,
	}
	profile.Data.Eggs[eggData.Id] = nil
	profile.Data.Monsters[monster.Id] = monster
	profile.Data.Stats.Hatched += 1

	PlotService.RemoveEgg(player, eggData.Id)
	PlotService.RenderMonster(player, monster)

	local rarity = Config.Species[species].Rarity
	MonsterService.Notify(player, "🐣 Hatched! You got " .. MonsterMath.GetDisplayName(monster) .. " (" .. rarity .. ")", "success")
	if rarity == "Secret" then
		MonsterService.Announce("🌌 " .. player.DisplayName .. " hatched a SECRET monster: " .. MonsterMath.GetDisplayName(monster) .. "!", Color3.fromRGB(200, 120, 255))
	end
end

-- بيدّي اللاعب وحش جديد Level 1 في أول مكان فاضي (لما يوصّل وحش شايله لقاعدته مثلاً).
function MonsterService.AddMonster(player: Player, species: string, mutation: string?): boolean
	local profile = DataService.Get(player)
	local slot = MonsterService.GetFreeSlot(player)
	if not profile or not Config.Species[species] or not slot then
		return false
	end
	local monster: MonsterMath.MonsterData = {
		Id = DataService.NewId(player),
		Species = species,
		Mutation = mutation,
		Level = 1,
		Xp = 0,
		Hunger = 100,
		Happiness = 100,
		Slot = slot,
	}
	profile.Data.Monsters[monster.Id] = monster
	PlotService.RenderMonster(player, monster)
	local rarity = Config.Species[species].Rarity
	MonsterService.Notify(player, "🐾 You got " .. MonsterMath.GetDisplayName(monster) .. " (" .. rarity .. ")! It's in your base.", "success")
	if rarity == "Secret" then
		MonsterService.Announce("🌌 " .. player.DisplayName .. " got a SECRET monster: " .. MonsterMath.GetDisplayName(monster) .. "!", Color3.fromRGB(200, 120, 255))
	end
	MonsterService.PushState(player)
	return true
end

-- بيشيل وحش من بيانات اللاعب ويرجّعه (للـ Trading والـ Arena)
function MonsterService.TakeMonsterData(player: Player, monsterId: string): MonsterMath.MonsterData?
	local profile = DataService.Get(player)
	local monster = profile and profile.Data.Monsters[monsterId]
	if not profile or not monster or MonsterService.IsCarried(player, monsterId) then
		return nil
	end
	profile.Data.Monsters[monsterId] = nil
	PlotService.RemoveMonster(player, monsterId)
	return monster
end

-- بيحط وحش (جاي من لاعب تاني) في أول مكان فاضي، بنفس الـ Level والطفرة
function MonsterService.InsertMonsterData(player: Player, monster: MonsterMath.MonsterData): boolean
	local profile = DataService.Get(player)
	local slot = MonsterService.GetFreeSlot(player)
	if not profile or not slot then
		return false
	end
	local copy: MonsterMath.MonsterData = table.clone(monster)
	copy.Id = DataService.NewId(player)
	copy.Slot = slot
	profile.Data.Monsters[copy.Id] = copy
	PlotService.RenderMonster(player, copy)
	return true
end

-- عدد الأماكن الفاضية (عشان نتأكد قبل الـ Trading)
function MonsterService.CountFreeSlots(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 0
	end
	local used = 0
	for _ in profile.Data.Monsters do
		used += 1
	end
	for _ in profile.Data.Eggs do
		used += 1
	end
	return math.max(0, MonsterService.GetUnlockedSlots(player) - used)
end

-- قوة ضربة اللاعب في الوحوش الأم: كل ما وحوشك تنتج أكتر ضربتك بتبقى أقوى.
function MonsterService.GetAttackDamage(player: Player): number
	local profile = DataService.Get(player)
	local production = 0
	if profile then
		for id, monster in profile.Data.Monsters do
			if not MonsterService.IsCarried(player, id) then
				production += MonsterMath.GetProduction(monster)
			end
		end
	end
	return math.floor(Config.Combat.BaseDamage + production * Config.Combat.DamagePerProduction)
end

-- التربية ---------------------------------------------------------------------------

local function addXp(player: Player, monster: MonsterMath.MonsterData, amount: number)
	if monster.Level >= Config.MaxLevel then
		monster.Xp = 0
		return
	end
	local oldStage = MonsterMath.GetStageIndex(monster.Level)
	monster.Xp += amount
	local leveled = false
	while monster.Level < Config.MaxLevel and monster.Xp >= Config.XpForLevel(monster.Level) do
		monster.Xp -= Config.XpForLevel(monster.Level)
		monster.Level += 1
		leveled = true
	end
	if not leveled then
		return
	end
	local newStage = MonsterMath.GetStageIndex(monster.Level)
	if newStage ~= oldStage then
		if not MonsterService.IsCarried(player, monster.Id) then
			PlotService.UpdateMonster(player, monster, true)
		end
		MonsterService.Notify(
			player,
			"✨ " .. MonsterMath.GetDisplayName(monster) .. " evolved into " .. Config.Stages[newStage].Name .. "!",
			"success"
		)
	else
		PlotService.UpdateMonster(player, monster, false)
	end
end

local function getOwnMonster(player: Player, monsterId: unknown): MonsterMath.MonsterData?
	if type(monsterId) ~= "string" then
		return nil
	end
	local profile = DataService.Get(player)
	if not profile then
		return nil
	end
	local monster = profile.Data.Monsters[monsterId]
	if not monster then
		return nil
	end
	if MonsterService.IsCarried(player, monsterId) then
		MonsterService.Notify(player, "This monster is being stolen! Catch the thief!", "error")
		return nil
	end
	return monster
end

local function feed(player: Player, monsterId: unknown)
	if rateLimited(player) then
		return
	end
	local monster = getOwnMonster(player, monsterId)
	if not monster then
		return
	end
	if monster.Hunger >= 99 then
		MonsterService.Notify(player, "Your monster is already full!", "info")
		return
	end
	if not DataService.TrySpend(player, MonsterMath.GetFoodCost(monster)) then
		MonsterService.Notify(player, "Not enough coins for food!", "error")
		return
	end
	monster.Hunger = math.min(100, monster.Hunger + Config.Food.Hunger)
	addXp(player, monster, Config.Food.Xp)
	PlotService.UpdateMonster(player, monster, false)
	MonsterService.PushState(player)
end

-- ألعاب صغيرة مع الوحش (بدل زرار Play) ----------------------------------------------------
-- Catch: كور بتظهر على الشاشة وانت بتمسكها (الكلاينت بيعدّ والسيرفر بيتأكد من الوقت والحد الأقصى).
-- Run: بتجري مع وحشك، والسيرفر بيقيس المسافة اللي مشيتها بنفسه.

type ActiveGame = { MonsterId: string, Game: string, StartedAt: number, Distance: number }
local activeGames: { [Player]: ActiveGame } = {}

local function finishGame(player: Player, game: ActiveGame, xp: number)
	if activeGames[player] ~= game then
		return
	end
	activeGames[player] = nil
	local profile = DataService.Get(player)
	local monster = profile and profile.Data.Monsters[game.MonsterId]
	if monster then
		monster.Happiness = math.min(100, monster.Happiness + Config.MiniGames.Happiness)
		addXp(player, monster, xp)
		PlotService.UpdateMonster(player, monster, false)
	end
	remotes.MiniGameState:FireClient(player, { Game = game.Game, Done = true, Xp = xp })
	MonsterService.Notify(player, string.format("🎮 Great game! +%d XP", xp), "success")
	MonsterService.PushState(player)
end

local function startMiniGame(player: Player, monsterId: unknown, gameName: unknown)
	if rateLimited(player) or (gameName ~= "Catch" and gameName ~= "Run") then
		return
	end
	local monster = getOwnMonster(player, monsterId)
	if not monster or activeGames[player] then
		return
	end
	lastPlay[player] = lastPlay[player] or {}
	local now = os.clock()
	if now - (lastPlay[player][monster.Id] or 0) < Config.MiniGames.Cooldown then
		MonsterService.Notify(player, "Your monster needs a little rest first!", "info")
		return
	end
	lastPlay[player][monster.Id] = now

	local game: ActiveGame = { MonsterId = monster.Id, Game = gameName :: string, StartedAt = now, Distance = 0 }
	activeGames[player] = game
	if gameName == "Catch" then
		local duration = Config.MiniGames.Catch.Duration
		remotes.MiniGameState:FireClient(player, { Game = "Catch", TimeLeft = duration })
		-- لو الكلاينت مابعتش النتيجة، اللعبة بتخلص لوحدها
		task.delay(duration + 6, function()
			finishGame(player, game, 0)
		end)
		return
	end

	-- Run: نقيس المسافة كل ربع ثانية
	local settings = Config.MiniGames.Run
	remotes.MiniGameState:FireClient(player, { Game = "Run", TimeLeft = settings.Duration, Progress = 0, Target = settings.Target })
	task.spawn(function()
		local lastPosition: Vector3? = nil
		while activeGames[player] == game and os.clock() - game.StartedAt < settings.Duration do
			task.wait(0.25)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local position = Vector3.new(root.Position.X, 0, root.Position.Z)
				if lastPosition then
					-- حد أقصى للخطوة عشان التليبورت مايتحسبش
					game.Distance += math.min((position - lastPosition).Magnitude, 10)
				end
				lastPosition = position
			end
			remotes.MiniGameState:FireClient(player, {
				Game = "Run",
				TimeLeft = math.max(0, settings.Duration - (os.clock() - game.StartedAt)),
				Progress = math.floor(game.Distance),
				Target = settings.Target,
			})
		end
		local xp = math.floor(math.clamp(game.Distance / settings.Target, 0, 1) * settings.MaxXp)
		finishGame(player, game, xp)
	end)
end

local function finishCatch(player: Player, score: unknown)
	local game = activeGames[player]
	if not game or game.Game ~= "Catch" or type(score) ~= "number" then
		return
	end
	local settings = Config.MiniGames.Catch
	local elapsed = os.clock() - game.StartedAt
	if elapsed < settings.Duration - 1.5 then
		return -- بدري أوي
	end
	local catches = math.clamp(math.floor(score), 0, settings.MaxCatches)
	finishGame(player, game, catches * settings.XpPerCatch)
end

-- الإكسسوارات ------------------------------------------------------------------------------

local function buyAccessory(player: Player, name: unknown)
	if rateLimited(player) or type(name) ~= "string" then
		return
	end
	local accessory = Config.Accessories[name]
	local profile = DataService.Get(player)
	if not accessory or not profile then
		return
	end
	if profile.Data.Accessories[name] then
		MonsterService.Notify(player, "You already own " .. accessory.Name .. "!", "info")
		return
	end
	if not DataService.TrySpend(player, accessory.Cost) then
		MonsterService.Notify(player, "Not enough coins!", "error")
		return
	end
	profile.Data.Accessories[name] = true
	MonsterService.Notify(player, "👒 You bought " .. accessory.Name .. "! Put it on any monster.", "success")
	MonsterService.PushState(player)
end

local function equipAccessory(player: Player, monsterId: unknown, slot: unknown, name: unknown)
	if rateLimited(player) or (slot ~= "Hat" and slot ~= "Glasses") then
		return
	end
	local monster = getOwnMonster(player, monsterId)
	local profile = DataService.Get(player)
	if not monster or not profile then
		return
	end
	local chosen: string? = nil
	if name ~= nil then
		if type(name) ~= "string" then
			return
		end
		local accessory = Config.Accessories[name]
		if not accessory or accessory.Slot ~= slot or not profile.Data.Accessories[name] then
			return
		end
		chosen = name
	end
	if slot == "Hat" then
		monster.Hat = chosen
	else
		monster.Glasses = chosen
	end
	PlotService.UpdateMonster(player, monster, true)
	MonsterService.PushState(player)
end

local function sell(player: Player, monsterId: unknown)
	if rateLimited(player) then
		return
	end
	local monster = getOwnMonster(player, monsterId)
	local profile = DataService.Get(player)
	if not monster or not profile then
		return
	end
	local value = MonsterMath.GetSellValue(monster)
	profile.Data.Monsters[monster.Id] = nil
	DataService.AddCoins(player, value)
	PlotService.RemoveMonster(player, monster.Id)
	MonsterService.Notify(player, "Sold " .. MonsterMath.GetDisplayName(monster) .. " for " .. MonsterMath.FormatNumber(value) .. " 💰", "success")
	MonsterService.PushState(player)
end

local function buyUpgrade(player: Player, upgrade: unknown)
	if rateLimited(player) then
		return
	end
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local data = profile.Data
	if upgrade == "Slots" then
		local cost = Config.SlotUpgradeCosts[data.SlotUpgrades + 1]
		if not cost or MonsterService.GetUnlockedSlots(player) >= Config.MaxSlots then
			MonsterService.Notify(player, "You already have the max number of slots!", "info")
			return
		end
		if not DataService.TrySpend(player, cost) then
			MonsterService.Notify(player, "Not enough coins!", "error")
			return
		end
		data.SlotUpgrades += 1
		PlotService.SetUnlockedSlots(player, MonsterService.GetUnlockedSlots(player))
		MonsterService.Notify(player, "🏠 New slot unlocked!", "success")
	elseif upgrade == "Lock" then
		local cost = Config.LockUpgradeCosts[data.LockUpgrades + 1]
		if not cost then
			MonsterService.Notify(player, "Your lock is already max level!", "info")
			return
		end
		if not DataService.TrySpend(player, cost) then
			MonsterService.Notify(player, "Not enough coins!", "error")
			return
		end
		data.LockUpgrades += 1
		MonsterService.Notify(player, "🔒 Your base lock now lasts longer!", "success")
	else
		return
	end
	MonsterService.PushState(player)
end

-- القاعدة -------------------------------------------------------------------------------

function MonsterService.Collect(player: Player)
	local now = os.clock()
	if lastCollect[player] and now - lastCollect[player] < 0.5 then
		return
	end
	lastCollect[player] = now
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local amount = math.floor(profile.Data.PendingCoins)
	if amount <= 0 then
		return
	end
	profile.Data.PendingCoins -= amount
	DataService.AddCoins(player, amount)
	PlotService.SetPending(player, profile.Data.PendingCoins)
	MonsterService.Notify(player, "+" .. MonsterMath.FormatNumber(amount) .. " 💰", "coins")
	MonsterService.PushState(player)
end

function MonsterService.Lock(player: Player)
	local plot = PlotService.GetPlot(player)
	local profile = DataService.Get(player)
	if not plot or not profile then
		return
	end
	local now = os.clock()
	if now < plot.LockedUntil then
		MonsterService.Notify(player, "Your base is already locked.", "info")
		return
	end
	if now < plot.LockCooldownUntil then
		MonsterService.Notify(player, string.format("Wait %ds before locking again.", math.ceil(plot.LockCooldownUntil - now)), "error")
		return
	end
	local duration = Config.LockDuration + profile.Data.LockUpgrades * Config.LockDurationPerUpgrade
	plot.LockedUntil = now + duration
	plot.LockCooldownUntil = plot.LockedUntil + Config.LockCooldown
	MonsterService.Notify(player, "🔒 Base locked for " .. duration .. " seconds!", "success")
	MonsterService.PushState(player)
end

local function updateLockVisual(player: Player)
	local plot = PlotService.GetPlot(player)
	if not plot then
		return
	end
	local now = os.clock()
	if now < plot.LockedUntil then
		PlotService.SetLockVisual(plot, true, string.format("🔒 Locked %ds", math.ceil(plot.LockedUntil - now)))
	elseif now < plot.LockCooldownUntil then
		PlotService.SetLockVisual(plot, false, string.format("⏳ Ready in %ds", math.ceil(plot.LockCooldownUntil - now)))
	else
		PlotService.SetLockVisual(plot, false, "🔓 Lock Base")
	end
end

-- اللوب الأساسي ------------------------------------------------------------------------

local function tickPlayer(player: Player, dt: number)
	local profile = DataService.Get(player)
	if not profile or not PlotService.GetPlot(player) then
		return
	end
	local data = profile.Data
	local multiplier = MonsterService.GetCoinMultiplier(player)

	for id, monster in data.Monsters do
		monster.Hunger = math.max(0, monster.Hunger - Config.HungerDecayPerSecond * dt)
		monster.Happiness = math.max(0, monster.Happiness - Config.HappinessDecayPerSecond * dt)
		if not MonsterService.IsCarried(player, id) then
			data.PendingCoins += MonsterMath.GetProduction(monster) * multiplier * dt
			if monster.Hunger >= 50 and monster.Happiness >= 50 then
				addXp(player, monster, Config.PassiveXpPerSecond * dt)
			end
			PlotService.UpdateMonster(player, monster, false)
		end
	end

	local now = os.time()
	for _, egg in data.Eggs do
		if now >= egg.HatchAt then
			hatch(player, egg)
		else
			PlotService.UpdateEggTimer(player, egg.Id, egg.EggType, egg.HatchAt - now)
		end
	end

	-- ضمان إن مفيش لاعب يعلق من غير وحوش ولا فلوس.
	if next(data.Monsters) == nil and next(data.Eggs) == nil and data.Coins + data.PendingCoins < Config.Eggs.Basic.Cost then
		local id = DataService.NewId(player)
		data.Eggs[id] = { Id = id, EggType = "Basic", Slot = 1, HatchAt = os.time() + 5 }
		PlotService.RenderEgg(player, id, "Basic", 1)
		MonsterService.Notify(player, "🎁 Here is a free egg to get you back on your feet!", "success")
	end

	-- Auto-Collect: الفلوس بتروح المحفظة لوحدها
	if MonsterService.HasPass(player, "AutoCollect") and data.PendingCoins >= 1 then
		local amount = math.floor(data.PendingCoins)
		data.PendingCoins -= amount
		DataService.AddCoins(player, amount)
	end

	PlotService.SetPending(player, data.PendingCoins)
	updateLockVisual(player)
	MonsterService.PushState(player)
end

-- بيرسم كل حاجة اللاعب يملكها لما يدخل.
function MonsterService.SetupPlayer(player: Player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local data = profile.Data

	-- أول مرة يلعب: بيضة مجانية عشان يبدأ على طول.
	if next(data.Monsters) == nil and next(data.Eggs) == nil and data.Stats.Hatched == 0 then
		local id = DataService.NewId(player)
		data.Eggs[id] = { Id = id, EggType = "Basic", Slot = 1, HatchAt = os.time() + 5 }
	end

	PlotService.SetUnlockedSlots(player, MonsterService.GetUnlockedSlots(player))
	for _, monster in data.Monsters do
		PlotService.RenderMonster(player, monster)
	end
	for _, egg in data.Eggs do
		PlotService.RenderEgg(player, egg.Id, egg.EggType, egg.Slot)
	end
	PlotService.SetPending(player, data.PendingCoins)
	MonsterService.PushState(player)
end

function MonsterService.CleanupPlayer(player: Player)
	lastPlay[player] = nil
	activeGames[player] = nil
	lastAction[player] = nil
	lastCollect[player] = nil
	MonsterService.Carried[player] = nil
end

function MonsterService.OpenMonster(who: Player, owner: Player, monsterId: string)
	if who ~= owner then
		return
	end
	remotes.OpenMonster:FireClient(who, monsterId)
end

function MonsterService.Init(allRemotes: Remotes)
	remotes = allRemotes
	remotes.BuyEgg.OnServerEvent:Connect(buyEgg)
	remotes.FeedMonster.OnServerEvent:Connect(feed)
	remotes.MiniGameStart.OnServerEvent:Connect(startMiniGame)
	remotes.MiniGameFinish.OnServerEvent:Connect(finishCatch)
	remotes.BuyAccessory.OnServerEvent:Connect(buyAccessory)
	remotes.EquipAccessory.OnServerEvent:Connect(equipAccessory)
	remotes.SellMonster.OnServerEvent:Connect(sell)
	remotes.BuyUpgrade.OnServerEvent:Connect(buyUpgrade)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(Config.NeedsTickInterval)
			local now = os.clock()
			local dt = now - last
			last = now
			for _, player in Players:GetPlayers() do
				task.spawn(tickPlayer, player, dt)
			end
		end
	end)
end

return MonsterService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[--!strict
-- بيبني الخريطة بالكود (أرض + متجر بيض + قواعد اللاعبين) وبيرسم الوحوش والبيض.
-- كده الماب تشتغل في أي Baseplate فاضي من غير ما تبني حاجة بإيدك.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)
local Build = require(script.Parent.Build)

local PLOT_SIZE = 60
local HALF = PLOT_SIZE / 2
local FLOOR_TOP = 0.6 -- المنصة قاعدة على الأرض، مش طايرة
local PAD_SIZE = 7

-- شكل الماب: القواعد جنب بعض في عمود على الشمال (X سالب) وبتبص ناحية +X،
-- قدامها ساحة فيها متجر البيض، وبعدها الطريق اللي داخل على مناطق الوحوش.
local BASE_X = -40
local PLOT_SPACING = PLOT_SIZE + 8
local ISLAND_MIN_X = -80
local PLAZA_MIN_X = -10
local PLAZA_HALF_Z = 220

local theme = Config.BaseThemes[Config.BaseTheme] or Config.BaseThemes.Normal

export type Plot = {
	Index: number,
	Model: Model,
	CFrame: CFrame,
	Owner: Player?,
	LockedUntil: number,
	LockCooldownUntil: number,
	Pedestals: { BasePart },
	MonstersFolder: Folder,
	EggsFolder: Folder,
	Barrier: BasePart,
	CollectorLabel: TextLabel,
	LockLabel: TextLabel?, -- مش موجودين لما السرقة تبقى مقفولة
	SignLabel: TextLabel,
	LockPrompt: ProximityPrompt?,
	SpawnCFrame: CFrame,
}

type Callbacks = {
	Collect: (player: Player) -> (),
	Lock: (player: Player) -> (),
	OpenShop: (player: Player) -> (),
	Care: (player: Player, owner: Player, monsterId: string) -> (),
	Steal: (player: Player, owner: Player, monsterId: string) -> (),
}

local PlotService = {}

-- أول المناطق (آخر الساحة) بالـ X
PlotService.ZonesStartX = 50
-- حدود منطقة القواعد والساحة (الجبال بتلف حواليها)
PlotService.IslandMinX = ISLAND_MIN_X
PlotService.PlazaHalfZ = PLAZA_HALF_Z

PlotService.Callbacks = {
	Collect = function() end,
	Lock = function() end,
	OpenShop = function() end,
	Care = function() end,
	Steal = function() end,
} :: Callbacks

local plots: { Plot } = {}
local plotByPlayer: { [Player]: Plot } = {}
local mapFolder: Folder

local makePart = Build.MakePart
local makeBillboard = Build.MakeBillboard
local makePrompt = Build.MakePrompt
local colorToHex = Build.ColorToHex

-- الخريطة ----------------------------------------------------------------------

local function buildGround()
	-- الجزيرة اللي عليها القواعد والساحة (المناطق بتبني أرضها في ZoneService)
	makePart({
		Name = "Ground",
		Size = Vector3.new(PlotService.ZonesStartX - ISLAND_MIN_X, 2, PLAZA_HALF_Z * 2),
		Position = Vector3.new((ISLAND_MIN_X + PlotService.ZonesStartX) / 2, -1, 0),
		Color = Color3.fromRGB(95, 160, 80),
		Material = Enum.Material.Grass,
		Parent = mapFolder,
	})
	makePart({
		Name = "Plaza",
		Size = Vector3.new(PlotService.ZonesStartX - PLAZA_MIN_X, 0.2, PLAZA_HALF_Z * 2 - 20),
		Position = Vector3.new((PLAZA_MIN_X + PlotService.ZonesStartX) / 2, 0.1, 0),
		Color = Color3.fromRGB(150, 150, 155),
		Material = Enum.Material.Cobblestone,
		Parent = mapFolder,
	})
	-- مية حوالين الماب كلها
	makePart({
		Name = "Water",
		Size = Vector3.new(2000, 1, 1000),
		Position = Vector3.new(300, -4, 0),
		Color = Color3.fromRGB(40, 110, 200),
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		Parent = mapFolder,
	})
end

local SHOP_ORIGIN = Vector3.new(20, 0, -100)
PlotService.ShopPosition = SHOP_ORIGIN

local function buildShop()
	local shopModel = Instance.new("Model")
	shopModel.Name = "EggShop"
	shopModel.Parent = mapFolder

	local counter = makePart({
		Name = "Counter",
		Size = Vector3.new(16, 4, 6),
		Position = SHOP_ORIGIN + Vector3.new(0, 2, 0),
		Color = Color3.fromRGB(120, 80, 50),
		Material = Enum.Material.Wood,
		Parent = shopModel,
	})
	makePart({
		Name = "Roof",
		Size = Vector3.new(20, 1, 10),
		Position = SHOP_ORIGIN + Vector3.new(0, 11, 0),
		Color = Color3.fromRGB(230, 80, 80),
		Parent = shopModel,
	})
	for _, x in { -9, 9 } do
		makePart({
			Name = "Pole",
			Size = Vector3.new(1, 7, 1),
			Position = SHOP_ORIGIN + Vector3.new(x, 7.5, 0),
			Color = Color3.fromRGB(240, 240, 240),
			Parent = shopModel,
		})
	end

	-- البيض المعروض على الكاونتر = اللي بيتباع في المتجر بس
	local sortedEggs = {}
	for _, eggType in Config.ShopEggs do
		local egg = Config.Eggs[eggType]
		if egg then
			table.insert(sortedEggs, egg)
		end
	end
	for i, egg in sortedEggs do
		local eggPart = makePart({
			Name = "DisplayEgg",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.4, 2.4, 2.4),
			Position = SHOP_ORIGIN + Vector3.new((i - 2) * 5, 5.4, 0),
			Color = egg.Color,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = shopModel,
		})
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.new(1, 1.3, 1)
		mesh.Parent = eggPart
	end

	local _, title = makeBillboard(counter, UDim2.fromOffset(260, 60), Vector3.new(0, 10, 0))
	title.Text = "🥚 EGG SHOP 🥚"
	title.TextColor3 = Color3.fromRGB(255, 230, 120)

	local prompt = makePrompt(counter, "ShopPrompt", "Open Shop", Enum.KeyCode.E, 0)
	prompt.ObjectText = "Egg Shop"
	prompt.MaxActivationDistance = 14
	prompt.Triggered:Connect(function(player)
		PlotService.Callbacks.OpenShop(player)
	end)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "CenterSpawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.Position = Vector3.new(20, 0.5, 40)
	spawn.Color = Color3.fromRGB(255, 255, 255)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = mapFolder
end

-- القواعد جنب بعض في عمود واحد، ومداخلها بتبص على الساحة (+X).
local function plotCFrames(): { CFrame }
	local result = {}
	local facing = Vector3.new(1, 0, 0)
	for index = 1, Config.MaxPlots do
		local z = (index - (Config.MaxPlots + 1) / 2) * PLOT_SPACING
		local position = Vector3.new(BASE_X, 0, z)
		table.insert(result, CFrame.lookAt(position, position + facing))
	end
	return result
end

-- القاعدة: منصة مفتوحة على الأرض (مش طايرة).
-- محلياً: -Z هو قدام القاعدة (ناحية الساحة)، +Z ورا.
-- 10 أماكن للوحوش حوالين الأطراف: 4 ورا، و2 على كل جنب، و2 قدام. كلها بتبص على النص.
local SLOT_POSITIONS = {
	Vector3.new(-6.5, 0, 20.5),
	Vector3.new(6.5, 0, 20.5),
	Vector3.new(-19.5, 0, 20.5),
	Vector3.new(19.5, 0, 20.5),
	Vector3.new(-22, 0, 6),
	Vector3.new(22, 0, 6),
	Vector3.new(-22, 0, -8),
	Vector3.new(22, 0, -8),
	Vector3.new(-14, 0, -21),
	Vector3.new(14, 0, -21),
}

local function slotLocalCFrame(slot: number): CFrame
	local position = SLOT_POSITIONS[slot] + Vector3.new(0, FLOOR_TOP + 0.75, 0)
	return CFrame.lookAt(position, Vector3.new(0, position.Y, 0))
end

local LOCKED_PAD_COLOR = Color3.fromRGB(60, 60, 66)

local function setPadState(pad: BasePart, unlocked: boolean)
	pad.Color = if unlocked then theme.PadColor else LOCKED_PAD_COLOR
	pad.Material = if unlocked then Enum.Material.Neon else Enum.Material.SmoothPlastic
	pad.Transparency = if unlocked then 0 else 0.4
end

local function buildPlot(index: number, cframe: CFrame): Plot
	local model = Instance.new("Model")
	model.Name = "Plot_" .. index
	model.Parent = mapFolder

	local function at(localPosition: Vector3): CFrame
		return cframe * CFrame.new(localPosition)
	end
	local function block(name: string, size: Vector3, localPosition: Vector3, props: { [string]: any }?): Part
		local all: { [string]: any } = {
			Name = name,
			Size = size,
			CFrame = at(localPosition),
			Color = theme.StoneColor,
			Material = theme.StoneMaterial,
			Parent = model,
		}
		if props then
			for key, value in props do
				all[key] = value
			end
		end
		return makePart(all)
	end
	local function glow(part: BasePart, color: Color3, range: number)
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = range
		light.Brightness = 1.5
		light.Parent = part
	end
	local function neon(color: Color3): { [string]: any }
		return { Color = color, Material = Enum.Material.Neon, CanCollide = false }
	end

	-- فانوس صغير على عمود
	local function lantern(position: Vector3)
		block("LanternPost", Vector3.new(0.6, 3, 0.6), position + Vector3.new(0, FLOOR_TOP + 1.5, 0), {
			Color = Color3.fromRGB(70, 50, 35),
			Material = Enum.Material.Wood,
		})
		block("LanternCap", Vector3.new(1.6, 0.4, 1.6), position + Vector3.new(0, FLOOR_TOP + 4.6, 0), {
			Color = Color3.fromRGB(45, 40, 40),
			Material = Enum.Material.Metal,
		})
		local light = block("Lantern", Vector3.new(1.2, 1.4, 1.2), position + Vector3.new(0, FLOOR_TOP + 3.7, 0), neon(theme.LanternColor))
		glow(light, theme.LanternColor, 12)
	end

	-- شجرة على حسب النسخة (بلوكات زي التصميم)
	local function tree(position: Vector3, scale: number)
		local base = position + Vector3.new(0, FLOOR_TOP, 0)
		local trunkColor = Color3.fromRGB(105, 70, 40)
		if theme.Foliage == "Oak" then
			block("Trunk", Vector3.new(1.4, 5, 1.4) * scale, base + Vector3.new(0, 2.5 * scale, 0), { Color = trunkColor, Material = Enum.Material.Wood })
			block("Leaves", Vector3.new(5, 4, 5) * scale, base + Vector3.new(0, 6 * scale, 0), { Color = theme.FoliageColor, Material = Enum.Material.Grass, CanCollide = false })
			block("Leaves", Vector3.new(3.4, 2.4, 3.4) * scale, base + Vector3.new(0.6 * scale, 8.6 * scale, -0.4 * scale), { Color = theme.FoliageColor:Lerp(Color3.new(1, 1, 1), 0.1), Material = Enum.Material.Grass, CanCollide = false })
		elseif theme.Foliage == "Pine" then
			block("Trunk", Vector3.new(1, 2, 1) * scale, base + Vector3.new(0, 1 * scale, 0), { Color = trunkColor, Material = Enum.Material.Wood })
			for i, width in { 5, 3.8, 2.6, 1.4 } do
				block("Pine", Vector3.new(width, 1.6, width) * scale, base + Vector3.new(0, (1.6 + i * 1.5) * scale, 0), { Color = if i % 2 == 0 then Color3.fromRGB(60, 120, 80) else theme.FoliageColor, Material = Enum.Material.Snow, CanCollide = false })
			end
		elseif theme.Foliage == "Palm" then
			block("Trunk", Vector3.new(0.9, 8, 0.9) * scale, base + Vector3.new(0, 4 * scale, 0), { Color = Color3.fromRGB(150, 110, 60), Material = Enum.Material.Wood })
			for i = 0, 3 do
				local leafCFrame = at(base + Vector3.new(0, 8 * scale, 0)) * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0, 0, -1.8 * scale) * CFrame.Angles(math.rad(-20), 0, 0)
				makePart({ Name = "PalmLeaf", Size = Vector3.new(1.4, 0.3, 4) * scale, CFrame = leafCFrame, Color = theme.FoliageColor, Material = Enum.Material.Grass, CanCollide = false, Parent = model })
			end
		elseif theme.Foliage == "Spikes" then
			for i, height in { 4, 2.6, 2.2 } do
				local offset = Vector3.new((i - 2) * 1.2, height / 2, (i % 2) * 0.8)
				makePart({ Name = "Spike", Size = Vector3.new(1, height, 1) * scale, CFrame = at(base + offset * scale) * CFrame.Angles(0, math.rad(45), math.rad((i - 2) * 12)), Color = theme.FoliageColor, Material = Enum.Material.Neon, Parent = model })
			end
		elseif theme.Foliage == "Dead" then
			block("Trunk", Vector3.new(1, 5, 1) * scale, base + Vector3.new(0, 2.5 * scale, 0), { Color = theme.FoliageColor, Material = Enum.Material.Wood })
			for _, side in { -1, 1 } do
				makePart({ Name = "Branch", Size = Vector3.new(0.5, 2.6, 0.5) * scale, CFrame = at(base + Vector3.new(side * 0.9, 5 * scale, 0)) * CFrame.Angles(0, 0, side * -0.7), Color = theme.FoliageColor, Material = Enum.Material.Wood, Parent = model })
			end
		end
	end

	local baseColor = Config.PlotColors[index] or Color3.fromRGB(110, 120, 140)

	-- المنصة: حافة (عشب) وجواها البلاط، قاعدة على الأرض على طول
	block("Rim", Vector3.new(PLOT_SIZE, FLOOR_TOP, PLOT_SIZE), Vector3.new(0, FLOOR_TOP / 2, 0), {
		Color = theme.RimColor,
		Material = theme.RimMaterial,
	})
	block("Floor", Vector3.new(PLOT_SIZE - 4, 0.1, PLOT_SIZE - 4), Vector3.new(0, FLOOR_TOP + 0.05, 0), {
		Color = theme.FloorColor,
		Material = theme.FloorMaterial,
	})

	-- 4 أعمدة في الأركان وفوقها كريستالة أو شعلة أو فانوس، وعليها راية
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local corner = Vector3.new(sx * 26.5, 0, sz * 26.5)
			block("Pillar", Vector3.new(5, 8, 5), corner + Vector3.new(0, FLOOR_TOP + 4, 0))
			block("PillarCap", Vector3.new(6, 1, 6), corner + Vector3.new(0, FLOOR_TOP + 8.5, 0))
			block("Banner", Vector3.new(0.2, 4, 2.6), corner + Vector3.new(-sx * 2.6, FLOOR_TOP + 4.5, 0), {
				Color = theme.BannerColor,
				Material = Enum.Material.Fabric,
			})
			block("BannerEmblem", Vector3.new(0.25, 1.4, 1.2), corner + Vector3.new(-sx * 2.65, FLOOR_TOP + 5, 0), {
				Color = Color3.fromRGB(240, 190, 60),
				Material = Enum.Material.Foil,
			})
			local topY = FLOOR_TOP + 9
			local top: BasePart
			if theme.PillarTop == "Crystal" then
				top = makePart({
					Name = "Crystal",
					Size = Vector3.new(1.8, 4, 1.8),
					CFrame = at(corner + Vector3.new(0, topY + 2, 0)) * CFrame.Angles(0, math.rad(45), 0),
					Color = theme.PillarTopColor,
					Material = Enum.Material.Neon,
					Parent = model,
				})
				for i = 0, 3 do
					makePart({
						Name = "Crystal",
						Size = Vector3.new(0.9, 2.2, 0.9),
						CFrame = at(corner + Vector3.new(0, topY + 1, 0)) * CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0, 0, -1.4) * CFrame.Angles(math.rad(-25), 0, 0),
						Color = theme.PillarTopColor,
						Material = Enum.Material.Neon,
						Parent = model,
					})
				end
			elseif theme.PillarTop == "Flame" then
				block("Brazier", Vector3.new(3, 1, 3), corner + Vector3.new(0, topY + 0.5, 0), { Color = Color3.fromRGB(40, 35, 35), Material = Enum.Material.Metal })
				top = block("FlameCore", Vector3.new(1.6, 1.6, 1.6), corner + Vector3.new(0, topY + 1.8, 0), neon(theme.PillarTopColor))
				local fire = Instance.new("Fire")
				fire.Color = theme.PillarTopColor
				fire.SecondaryColor = theme.PillarTopColor:Lerp(Color3.new(1, 1, 1), 0.4)
				fire.Size = 4
				fire.Heat = 6
				fire.Parent = top
			else
				block("LanternFrame", Vector3.new(2.6, 0.5, 2.6), corner + Vector3.new(0, topY + 3.4, 0), { Color = Color3.fromRGB(45, 40, 40), Material = Enum.Material.Metal })
				top = block("Lantern", Vector3.new(2, 2.6, 2), corner + Vector3.new(0, topY + 1.8, 0), neon(theme.PillarTopColor))
			end
			glow(top, theme.PillarTopColor, 18)
		end
	end

	-- النص: قاعدة حجر بدرجتين وعليها شجرة كبيرة أو كريستالة أو كورة، وفوانيس على الأركان
	block("CenterBase", Vector3.new(14, 1.2, 14), Vector3.new(0, FLOOR_TOP + 0.6, 0))
	block("CenterTop", Vector3.new(10, 1.2, 10), Vector3.new(0, FLOOR_TOP + 1.8, 0))
	local centerY = FLOOR_TOP + 2.4
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local post = block("CenterLantern", Vector3.new(0.9, 1.2, 0.9), Vector3.new(sx * 6, FLOOR_TOP + 1.8, sz * 6), neon(theme.LanternColor))
			glow(post, theme.LanternColor, 8)
		end
	end
	if theme.Center == "Tree" or theme.Center == "GoldenTree" then
		local golden = theme.Center == "GoldenTree"
		if not golden then
			block("Water", Vector3.new(9, 0.2, 9), Vector3.new(0, centerY + 0.1, 0), {
				Color = theme.CenterColor,
				Material = Enum.Material.Glass,
				Transparency = 0.2,
				CanCollide = false,
			})
		end
		block("CenterTrunk", Vector3.new(2, 7, 2), Vector3.new(0, centerY + 3.5, 0), {
			Color = if golden then theme.CenterColor else Color3.fromRGB(105, 70, 40),
			Material = if golden then Enum.Material.Foil else Enum.Material.Wood,
		})
		local leafColor = if golden then theme.CenterColor:Lerp(Color3.new(1, 1, 0.6), 0.2) else theme.FoliageColor
		local leafMaterial = if golden then Enum.Material.Foil else Enum.Material.Grass
		for _, leaf in {
			{ Vector3.new(8, 4, 8), Vector3.new(0, 8.5, 0) },
			{ Vector3.new(5, 3, 5), Vector3.new(1, 11.5, -0.5) },
			{ Vector3.new(4, 3, 4), Vector3.new(-2.5, 9.5, 2) },
		} do
			block("CenterLeaves", leaf[1], Vector3.new(0, centerY, 0) + leaf[2], { Color = leafColor, Material = leafMaterial, CanCollide = false })
		end
	elseif theme.Center == "Crystal" or theme.Center == "Flame" then
		local crystal = makePart({
			Name = "CenterCrystal",
			Size = Vector3.new(3, 8, 3),
			CFrame = at(Vector3.new(0, centerY + 4, 0)) * CFrame.Angles(0, math.rad(45), 0),
			Color = theme.CenterColor,
			Material = Enum.Material.Neon,
			Parent = model,
		})
		for i = 0, 3 do
			makePart({
				Name = "CenterCrystal",
				Size = Vector3.new(1.4, 4, 1.4),
				CFrame = at(Vector3.new(0, centerY + 2, 0)) * CFrame.Angles(0, i * math.pi / 2 + 0.4, 0) * CFrame.new(0, 0, -2.4) * CFrame.Angles(math.rad(-22), 0, 0),
				Color = theme.CenterColor,
				Material = Enum.Material.Neon,
				Parent = model,
			})
		end
		glow(crystal, theme.CenterColor, 22)
		if theme.Center == "Flame" then
			local fire = Instance.new("Fire")
			fire.Color = theme.CenterColor
			fire.Size = 8
			fire.Parent = crystal
		end
	else -- Orb
		block("OrbStand", Vector3.new(3, 2, 3), Vector3.new(0, centerY + 1, 0))
		local orb = block("Orb", Vector3.new(4.5, 4.5, 4.5), Vector3.new(0, centerY + 4.4, 0), {
			Shape = Enum.PartType.Ball,
			Color = theme.CenterColor,
			Material = Enum.Material.Neon,
		})
		glow(orb, theme.CenterColor, 22)
	end

	-- 4 جناين صغيرة بين النص والأطراف
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local patch = Vector3.new(sx * 13, 0, sz * 11)
			block("Garden", Vector3.new(8, 0.4, 8), patch + Vector3.new(0, FLOOR_TOP + 0.2, 0), {
				Color = theme.GardenColor,
				Material = theme.GardenMaterial,
			})
			block("Bush", Vector3.new(2.6, 2, 2.6), patch + Vector3.new(sx * 1.5, FLOOR_TOP + 1.2, sz * 1.5), {
				Color = theme.FoliageColor:Lerp(Color3.new(0, 0, 0), 0.15),
				Material = Enum.Material.Grass,
				CanCollide = false,
			})
			block("Bush", Vector3.new(1.6, 1.4, 1.6), patch + Vector3.new(-sx * 1.6, FLOOR_TOP + 0.9, -sz * 1.2), {
				Color = theme.FoliageColor,
				Material = Enum.Material.Grass,
				CanCollide = false,
			})
		end
	end

	-- ديكور الأطراف: شجر ورا وفوانيس وسور حجر واطي متكسّر
	tree(Vector3.new(-14, 0, 27.5), 1)
	tree(Vector3.new(14, 0, 27.5), 1)
	tree(Vector3.new(-27.5, 0, 14), 0.8)
	tree(Vector3.new(27.5, 0, -1), 0.8)
	for _, position in {
		Vector3.new(0, 0, 27.5),
		Vector3.new(-27.5, 0, -1),
		Vector3.new(27.5, 0, 14),
		Vector3.new(-27.5, 0, -15),
		Vector3.new(27.5, 0, -15),
		Vector3.new(-9.5, 0, -27.5),
		Vector3.new(9.5, 0, -27.5),
	} do
		lantern(position)
	end
	for _, piece in {
		{ Vector3.new(7, 1.6, 1.4), Vector3.new(-20.5, 0, 28.4) },
		{ Vector3.new(7, 1.6, 1.4), Vector3.new(20.5, 0, 28.4) },
		{ Vector3.new(1.4, 1.6, 6), Vector3.new(-28.4, 0, 21) },
		{ Vector3.new(1.4, 1.6, 6), Vector3.new(28.4, 0, 21) },
	} do
		block("LowWall", piece[1], piece[2] + Vector3.new(0, FLOOR_TOP + 0.8, 0))
	end

	-- أماكن الوحوش: قاعدة حجر وعليها إطار نيون وجواه بلاطة غامقة
	local pedestals: { BasePart } = {}
	for slot = 1, Config.MaxSlots do
		local slotCFrame = cframe * slotLocalCFrame(slot)
		makePart({
			Name = "PadBase",
			Size = Vector3.new(PAD_SIZE + 1.2, 0.6, PAD_SIZE + 1.2),
			CFrame = slotCFrame * CFrame.new(0, -0.45, 0),
			Color = theme.StoneColor,
			Material = theme.StoneMaterial,
			Parent = model,
		})
		local pad = makePart({
			Name = "Pedestal_" .. slot,
			Size = Vector3.new(PAD_SIZE, 0.3, PAD_SIZE),
			CFrame = slotCFrame,
			Parent = model,
		})
		setPadState(pad, true)
		makePart({
			Name = "PadInner",
			Size = Vector3.new(PAD_SIZE - 1, 0.34, PAD_SIZE - 1),
			CFrame = slotCFrame,
			Color = Color3.fromRGB(25, 30, 40),
			Material = Enum.Material.SmoothPlastic,
			Parent = model,
		})
		pedestals[slot] = pad
	end

	-- قدام: صندوق تجميع الفلوس، ويافطة بلون القاعدة عليها اسم صاحبها
	local collector = block("Collector", Vector3.new(6, 0.4, 6), Vector3.new(0, FLOOR_TOP + 0.2, -22), {
		Color = Color3.fromRGB(60, 230, 90),
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	block("Chest", Vector3.new(3, 1.8, 2), Vector3.new(0, FLOOR_TOP + 0.9, -19.4), {
		Color = Color3.fromRGB(120, 75, 40),
		Material = Enum.Material.Wood,
	})
	block("ChestLid", Vector3.new(3.2, 0.6, 2.2), Vector3.new(0, FLOOR_TOP + 2.1, -19.4), {
		Color = Color3.fromRGB(240, 190, 60),
		Material = Enum.Material.Foil,
	})
	local collectorGui, collectorLabel = makeBillboard(collector, UDim2.fromOffset(200, 50), Vector3.new(0, 5, 0), 80)
	collectorGui.AlwaysOnTop = false -- مايبانش من ورا القواعد التانية
	collectorLabel.Text = "💰 0"

	for _, side in { -1, 1 } do
		block("SignPost", Vector3.new(0.6, 6, 0.6), Vector3.new(side * 5, FLOOR_TOP + 3, -29), {
			Color = Color3.fromRGB(70, 50, 35),
			Material = Enum.Material.Wood,
		})
	end
	local signBoard = block("SignBoard", Vector3.new(10.6, 2.2, 0.4), Vector3.new(0, FLOOR_TOP + 5, -29), {
		Color = baseColor,
		Material = Enum.Material.SmoothPlastic,
	})
	local signGui, signLabel = makeBillboard(signBoard, UDim2.fromScale(22, 3.5), Vector3.new(0, 3.2, 0), 200)
	signGui.AlwaysOnTop = false -- عشان لافتات القواعد مايركبوش على بعض
	signLabel.Text = "Empty Base"
	signLabel.TextColor3 = baseColor:Lerp(Color3.new(1, 1, 1), 0.4)

	-- حاجز القفل على حافة القاعدة القدامية (بيشتغل بس لو السرقة مفتوحة)
	local barrier = block("LockBarrier", Vector3.new(PLOT_SIZE, 10, 1), Vector3.new(0, FLOOR_TOP + 5, -HALF), {
		Color = Color3.fromRGB(255, 40, 40),
		Material = Enum.Material.ForceField,
		Transparency = 1,
		CanCollide = false,
	})

	-- زرار القفل بيتعمل بس لو السرقة شغالة
	local lockLabel: TextLabel? = nil
	local lockPrompt: ProximityPrompt? = nil
	if Config.Steal.Enabled then
		local lockButton = block("LockButton", Vector3.new(4, 1, 4), Vector3.new(-7, FLOOR_TOP + 0.5, -21), {
			Color = Color3.fromRGB(230, 50, 50),
			Material = Enum.Material.SmoothPlastic,
		})
		local _, label = makeBillboard(lockButton, UDim2.fromOffset(200, 50), Vector3.new(0, 4, 0))
		label.Text = "🔓 Lock Base"
		lockLabel = label
		lockPrompt = makePrompt(lockButton, "LockPrompt", "Lock Base", Enum.KeyCode.E, 0.5)
	end

	local monstersFolder = Instance.new("Folder")
	monstersFolder.Name = "Monsters"
	monstersFolder.Parent = model

	local eggsFolder = Instance.new("Folder")
	eggsFolder.Name = "Eggs"
	eggsFolder.Parent = model

	local plot: Plot = {
		Index = index,
		Model = model,
		CFrame = cframe,
		Owner = nil,
		LockedUntil = 0,
		LockCooldownUntil = 0,
		Pedestals = pedestals,
		MonstersFolder = monstersFolder,
		EggsFolder = eggsFolder,
		Barrier = barrier,
		CollectorLabel = collectorLabel,
		LockLabel = lockLabel,
		SignLabel = signLabel,
		LockPrompt = lockPrompt,
		SpawnCFrame = at(Vector3.new(0, FLOOR_TOP + 3, -14)) * CFrame.Angles(0, math.pi, 0),
	}

	collector.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player and player == plot.Owner then
			PlotService.Callbacks.Collect(player)
		end
	end)

	if lockPrompt then
		lockPrompt.Triggered:Connect(function(player)
			if player == plot.Owner then
				PlotService.Callbacks.Lock(player)
			end
		end)
	end

	-- لو القاعدة مقفولة، أي حد غير صاحبها بيترمي برّه.
	barrier.Touched:Connect(function(hit)
		if os.clock() >= plot.LockedUntil then
			return
		end
		local character = hit.Parent
		local player = Players:GetPlayerFromCharacter(character)
		if not player or player == plot.Owner or not character then
			return
		end
		local root = (character :: Model):FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.CFrame = cframe * CFrame.new(0, 3, -HALF - 10)
		end
	end)

	return plot
end

-- رسم الوحوش ----------------------------------------------------------------

function PlotService.BuildMonsterModel(monster: MonsterMath.MonsterData): Model
	local species = Config.Species[monster.Species]
	local stage = MonsterMath.GetStage(monster.Level)
	local mutation = MonsterMath.GetMutation(monster.Mutation)
	local scale = stage.Scale
	local color = if mutation and mutation.Color then mutation.Color else species.Color

	local model = Instance.new("Model")
	model.Name = monster.Id

	local material = Enum.Material.SmoothPlastic
	local isSecret = species.Rarity == "Secret"
	if isSecret then
		material = Enum.Material.Neon
		scale *= 1.2
	end
	if monster.Mutation == "Golden" then
		material = Enum.Material.Foil
	elseif monster.Mutation == "Toxic" or monster.Mutation == "Rainbow" then
		material = Enum.Material.Neon
	end

	local bodySize = 3 * scale
	local body = makePart({
		Name = "Body",
		Shape = if species.Placeholder then Enum.PartType.Block else Enum.PartType.Ball,
		Size = Vector3.new(bodySize, bodySize, bodySize),
		Color = color,
		Material = material,
		CanCollide = false,
		CanQuery = true,
		Massless = true,
		Parent = model,
	})
	model.PrimaryPart = body

	local parts: { BasePart } = { body }
	local function attach(part: BasePart, offset: CFrame)
		part.CFrame = body.CFrame * offset
		part.CanCollide = false
		part.Massless = true
		part.Parent = model
		table.insert(parts, part)
	end

	-- الوحوش اللي لسه ملهاش Skin بتفضل مكعب واسمها فوقه بس
	local hasFace = not species.Placeholder

	-- العيون (الوش ناحية -Z)
	for _, side in if hasFace then { -1, 1 } else {} do
		local eye = makePart({
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.9, 0.9, 0.9) * scale,
			Color = Color3.new(1, 1, 1),
		})
		attach(eye, CFrame.new(side * 0.6 * scale, 0.4 * scale, -1.25 * scale))
		local pupil = makePart({
			Name = "Pupil",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.45, 0.45, 0.45) * scale,
			Color = Color3.new(0, 0, 0),
		})
		attach(pupil, CFrame.new(side * 0.6 * scale, 0.4 * scale, -1.6 * scale))
	end

	-- رجلين
	for _, side in if hasFace then { -1, 1 } else {} do
		local foot = makePart({
			Name = "Foot",
			Size = Vector3.new(0.9, 0.6, 1.2) * scale,
			Color = color,
			Material = material,
		})
		attach(foot, CFrame.new(side * 0.8 * scale, -1.4 * scale, -0.2 * scale))
	end

	if species.Horns and hasFace then
		for _, side in { -1, 1 } do
			local horn = makePart({
				Name = "Horn",
				Size = Vector3.new(0.4, 1.2, 0.4) * scale,
				Color = Color3.fromRGB(250, 245, 230),
			})
			attach(horn, CFrame.new(side * 0.8 * scale, 1.6 * scale, 0) * CFrame.Angles(0, 0, side * -0.4))
		end
	end

	-- المراحل الأعلى بتاخد شكل مميز
	if stage.Name == "Adult" or stage.Name == "Legendary" then
		for _, side in { -1, 1 } do
			local wing = makePart({
				Name = "Wing",
				Size = Vector3.new(0.2, 1.6, 2.2) * scale,
				Color = color:Lerp(Color3.new(1, 1, 1), 0.3),
				Material = material,
				Transparency = 0.1,
			})
			attach(wing, CFrame.new(side * 1.6 * scale, 0.3 * scale, 0.6 * scale) * CFrame.Angles(0, 0, side * 0.5))
		end
	end
	if stage.Name == "Legendary" and not monster.Hat then
		local crown = makePart({
			Name = "Crown",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, 1.4, 1.4) * scale,
			Color = Color3.fromRGB(255, 210, 40),
			Material = Enum.Material.Neon,
		})
		attach(crown, CFrame.new(0, 1.65 * scale, 0) * CFrame.Angles(0, 0, math.rad(90)))
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = Color3.fromRGB(255, 230, 120)
		sparkle.Parent = body
	end

	-- إكسسوارات: القبعة فوق الراس، والنضارة على العينين
	local top = 1.5 * scale
	local hat = monster.Hat and Config.Accessories[monster.Hat]
	if hat then
		local hatProps = { Color = hat.Color, Material = Enum.Material.SmoothPlastic }
		if monster.Hat == "TopHat" then
			attach(makePart({ Name = "Hat", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 2.4, 2.4) * scale, Color = hat.Color }), CFrame.new(0, top + 0.1 * scale, 0) * CFrame.Angles(0, 0, math.rad(90)))
			attach(makePart({ Name = "Hat", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 1.5, 1.5) * scale, Color = hat.Color }), CFrame.new(0, top + 0.9 * scale, 0) * CFrame.Angles(0, 0, math.rad(90)))
		elseif monster.Hat == "WizardHat" then
			for i, width in { 2.2, 1.5, 0.9, 0.4 } do
				attach(makePart({ Name = "Hat", Size = Vector3.new(width, 0.6, width) * scale, Color = hat.Color, Material = hatProps.Material }), CFrame.new(0, top + (0.2 + (i - 1) * 0.55) * scale, 0) * CFrame.Angles(0, i * 0.3, 0))
			end
		elseif monster.Hat == "Crown" then
			attach(makePart({ Name = "Hat", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 1.6, 1.6) * scale, Color = hat.Color, Material = Enum.Material.Foil }), CFrame.new(0, top + 0.3 * scale, 0) * CFrame.Angles(0, 0, math.rad(90)))
			for i = 0, 3 do
				attach(makePart({ Name = "Hat", Size = Vector3.new(0.25, 0.6, 0.25) * scale, Color = hat.Color, Material = Enum.Material.Foil }), CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(0, top + 0.8 * scale, -0.65 * scale))
			end
		else -- PartyHat
			attach(makePart({ Name = "Hat", Size = Vector3.new(1, 1.6, 1) * scale, Color = hat.Color }), CFrame.new(0, top + 0.8 * scale, 0) * CFrame.Angles(0, math.rad(45), 0))
			attach(makePart({ Name = "Hat", Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5) * scale, Color = Color3.new(1, 1, 1) }), CFrame.new(0, top + 1.75 * scale, 0))
		end
	end
	local glasses = monster.Glasses and Config.Accessories[monster.Glasses]
	if glasses then
		local front = -1.7 * scale
		local eyeY = 0.4 * scale
		if monster.Glasses == "Monocle" then
			attach(makePart({ Name = "Glasses", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1, 0.9, 0.9) * scale, Color = glasses.Color, Material = Enum.Material.Foil }), CFrame.new(0.6 * scale, eyeY, front) * CFrame.Angles(0, math.rad(90), 0))
		else
			for _, side in { -1, 1 } do
				local lens = makePart({ Name = "Glasses", Size = Vector3.new(0.85, 0.6, 0.1) * scale, Color = glasses.Color, Material = if monster.Glasses == "StarGlasses" then Enum.Material.Neon else Enum.Material.Glass })
				attach(lens, CFrame.new(side * 0.6 * scale, eyeY, front) * (if monster.Glasses == "StarGlasses" then CFrame.Angles(0, 0, math.rad(45)) else CFrame.new()))
			end
			attach(makePart({ Name = "Glasses", Size = Vector3.new(0.4, 0.12, 0.1) * scale, Color = glasses.Color }), CFrame.new(0, eyeY, front))
		end
	end

	if isSecret then
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = Color3.fromRGB(200, 120, 255)
		sparkle.Parent = body
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(200, 120, 255)
		light.Range = 12
		light.Parent = body
	end

	if monster.Mutation == "Rainbow" then
		for _, part in parts do
			if part.Name == "Body" or part.Name == "Foot" or part.Name == "Wing" then
				CollectionService:AddTag(part, "RainbowPart")
			end
		end
	end

	-- كل الأجزاء ملزوقة في الجسم عشان نقدر نشيله على راس الحرامي
	for _, part in parts do
		if part ~= body then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = body
			weld.Part1 = part
			weld.Parent = part
		end
	end

	local gui, label = makeBillboard(body, UDim2.fromOffset(220, 70), Vector3.new(0, bodySize / 2 + 2.5, 0), 70)
	gui.Name = "Info"
	label.Name = "Label"
	PlotService.UpdateMonsterLabelOn(label, monster)

	return model
end

function PlotService.UpdateMonsterLabelOn(label: TextLabel, monster: MonsterMath.MonsterData)
	local species = Config.Species[monster.Species]
	local rarity = Config.Rarities[species.Rarity]
	local stage = MonsterMath.GetStage(monster.Level)
	local warning = ""
	if monster.Hunger < Config.LowNeedsThreshold then
		warning = " 🍖"
	elseif monster.Happiness < Config.LowNeedsThreshold then
		warning = " 😢"
	end
	label.Text = string.format(
		'<font color="%s">%s</font>%s\nLv %d · %s · +%s/s',
		colorToHex(rarity.Color),
		MonsterMath.GetDisplayName(monster),
		warning,
		monster.Level,
		stage.Name,
		MonsterMath.FormatNumber(MonsterMath.GetProduction(monster))
	)
end

function PlotService.GetSlotCFrame(plot: Plot, slot: number): CFrame
	return plot.CFrame * slotLocalCFrame(slot) * CFrame.new(0, 0.5, 0)
end

function PlotService.RenderMonster(player: Player, monster: MonsterMath.MonsterData)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	PlotService.RemoveMonster(player, monster.Id)

	local model = PlotService.BuildMonsterModel(monster)
	local body = model.PrimaryPart :: BasePart
	local slotCFrame = PlotService.GetSlotCFrame(plot, monster.Slot)
	model:PivotTo(slotCFrame * CFrame.new(0, body.Size.Y / 2 + 0.3 + body.Size.Y * 0.1, 0))
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("MonsterId", monster.Id)

	local name = MonsterMath.GetDisplayName(monster)
	local care = makePrompt(body, "CarePrompt", "Care", Enum.KeyCode.E, 0)
	care.ObjectText = name
	care.MaxActivationDistance = 8 + body.Size.Y
	local monsterId = monster.Id
	care.Triggered:Connect(function(who)
		PlotService.Callbacks.Care(who, player, monsterId)
	end)

	if Config.Steal.Enabled then
		local steal = makePrompt(body, "StealPrompt", "Steal", Enum.KeyCode.F, Config.Steal.HoldDuration)
		steal.ObjectText = name
		steal.MaxActivationDistance = 8 + body.Size.Y
		steal.Triggered:Connect(function(who)
			PlotService.Callbacks.Steal(who, player, monsterId)
		end)
	end

	model.Parent = plot.MonstersFolder
end

function PlotService.RemoveMonster(player: Player, monsterId: string)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	local existing = plot.MonstersFolder:FindFirstChild(monsterId)
	if existing then
		existing:Destroy()
	end
end

function PlotService.UpdateMonster(player: Player, monster: MonsterMath.MonsterData, rebuild: boolean)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	local model = plot.MonstersFolder:FindFirstChild(monster.Id) :: Model?
	if not model or rebuild then
		PlotService.RenderMonster(player, monster)
		return
	end
	local body = model.PrimaryPart
	local info = body and body:FindFirstChild("Info")
	local label = info and info:FindFirstChild("Label")
	if label then
		PlotService.UpdateMonsterLabelOn(label :: TextLabel, monster)
	end
end

-- البيض --------------------------------------------------------------------------

function PlotService.RenderEgg(player: Player, eggId: string, eggType: string, slot: number)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	PlotService.RemoveEgg(player, eggId)
	local egg = Config.Eggs[eggType]
	local part = makePart({
		Name = eggId,
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.6, 2.6, 2.6),
		CFrame = PlotService.GetSlotCFrame(plot, slot) * CFrame.new(0, 2, 0),
		Color = egg.Color,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	})
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.3, 1)
	mesh.Parent = part
	local gui, label = makeBillboard(part, UDim2.fromOffset(160, 40), Vector3.new(0, 3, 0), 70)
	gui.Name = "Info"
	label.Text = egg.DisplayName
	part.Parent = plot.EggsFolder
end

function PlotService.UpdateEggTimer(player: Player, eggId: string, eggType: string, secondsLeft: number)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	local part = plot.EggsFolder:FindFirstChild(eggId)
	local info = part and part:FindFirstChild("Info")
	local label = info and info:FindFirstChild("Label") :: TextLabel?
	if label then
		label.Text = string.format("%s\n⏳ %ds", Config.Eggs[eggType].DisplayName, math.max(0, math.ceil(secondsLeft)))
	end
end

function PlotService.RemoveEgg(player: Player, eggId: string)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	local existing = plot.EggsFolder:FindFirstChild(eggId)
	if existing then
		existing:Destroy()
	end
end

-- حالة القاعدة -------------------------------------------------------------------

function PlotService.SetUnlockedSlots(player: Player, count: number)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	for slot, pedestal in plot.Pedestals do
		setPadState(pedestal, slot <= count)
	end
end

function PlotService.SetPending(player: Player, amount: number)
	local plot = plotByPlayer[player]
	if plot then
		plot.CollectorLabel.Text = "💰 " .. MonsterMath.FormatNumber(amount) .. "\nStep here to collect"
	end
end

function PlotService.SetLockVisual(plot: Plot, locked: boolean, text: string)
	plot.Barrier.Transparency = if locked then 0.35 else 1
	if plot.LockLabel then
		plot.LockLabel.Text = text
	end
end

function PlotService.IsInsidePlot(plot: Plot, position: Vector3): boolean
	local localPos = plot.CFrame:PointToObjectSpace(position)
	return math.abs(localPos.X) <= HALF and math.abs(localPos.Z) <= HALF and localPos.Y > -5 and localPos.Y < 40
end

function PlotService.GetPlot(player: Player): Plot?
	return plotByPlayer[player]
end

function PlotService.GetPlots(): { Plot }
	return plots
end

function PlotService.SendHome(player: Player)
	local plot = plotByPlayer[player]
	local character = player.Character
	if plot and character then
		character:PivotTo(plot.SpawnCFrame)
	end
end

function PlotService.Assign(player: Player): Plot?
	for _, plot in plots do
		if not plot.Owner then
			plot.Owner = player
			plot.LockedUntil = 0
			plot.LockCooldownUntil = 0
			plot.SignLabel.Text = player.DisplayName .. "'s Base"
			if plot.LockPrompt then
				plot.LockPrompt:SetAttribute("OwnerUserId", player.UserId)
			end
			plotByPlayer[player] = plot
			return plot
		end
	end
	return nil
end

function PlotService.Release(player: Player)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	plot.MonstersFolder:ClearAllChildren()
	plot.EggsFolder:ClearAllChildren()
	plot.Owner = nil
	plot.LockedUntil = 0
	plot.SignLabel.Text = "Empty Base"
	plot.CollectorLabel.Text = "💰 0"
	if plot.LockPrompt then
		plot.LockPrompt:SetAttribute("OwnerUserId", nil)
	end
	PlotService.SetLockVisual(plot, false, "🔓 Lock Base")
	for _, pedestal in plot.Pedestals do
		setPadState(pedestal, true)
	end
	plotByPlayer[player] = nil
end

function PlotService.Init()
	mapFolder = Instance.new("Folder")
	mapFolder.Name = "Map"
	mapFolder.Parent = workspace

	buildGround()
	buildShop()
	for index, cframe in plotCFrames() do
		table.insert(plots, buildPlot(index, cframe))
	end
end

return PlotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">RewardService</string>
          <string name="Source"><![CDATA[--!strict
-- الهدية اليومية (بتكبر مع الـ Streak) وعجلة الحظ (لفة مجانية كل يوم وفيها بيض نادر).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)
local DataService = require(script.Parent.DataService)
local MonsterService = require(script.Parent.MonsterService)

local RewardService = {}

local remotes: { [string]: RemoteEvent }
local busy: { [Player]: boolean } = {}

function RewardService.DailyReadyIn(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 0
	end
	return math.max(0, profile.Data.Daily.LastClaim + Config.Daily.Cooldown - os.time())
end

function RewardService.SpinReadyIn(player: Player): number
	local profile = DataService.Get(player)
	if not profile then
		return 0
	end
	return math.max(0, profile.Data.LastSpin + Config.Spin.Cooldown - os.time())
end

-- البيضة بتروح القاعدة، ولو مفيش مكان بتتحول فلوس
local function giveEgg(player: Player, eggType: string)
	if not MonsterService.AddEgg(player, eggType) then
		local fallback = 1000
		DataService.AddCoins(player, fallback)
		MonsterService.Notify(player, "Your base is full, so you got 💰 " .. MonsterMath.FormatNumber(fallback) .. " instead!", "coins")
	end
end

local function claimDaily(player: Player)
	local profile = DataService.Get(player)
	if not profile or busy[player] then
		return
	end
	if RewardService.DailyReadyIn(player) > 0 then
		MonsterService.Notify(player, "Come back later for your next daily reward!", "info")
		return
	end
	local daily = profile.Data.Daily
	local now = os.time()
	if daily.LastClaim > 0 and now - daily.LastClaim <= Config.Daily.StreakReset then
		daily.Streak = math.min(daily.Streak + 1, Config.Daily.MaxStreak)
	else
		daily.Streak = 1
	end
	daily.LastClaim = now
	local coins = Config.Daily.CoinsPerDay * daily.Streak
	DataService.AddCoins(player, coins)
	MonsterService.Notify(player, string.format("🎁 Day %d reward: +%s coins!", daily.Streak, MonsterMath.FormatNumber(coins)), "coins")
	if daily.Streak >= Config.Daily.MaxStreak then
		giveEgg(player, Config.Daily.Day7Egg)
		daily.Streak = 0 -- بعد اليوم السابع بتبدأ من الأول
	end
	MonsterService.PushState(player)
end

local function pickPrize(): number
	local total = 0
	for _, prize in Config.Spin.Prizes do
		total += prize.Weight
	end
	local roll = math.random() * total
	for index, prize in Config.Spin.Prizes do
		roll -= prize.Weight
		if roll <= 0 then
			return index
		end
	end
	return 1
end

local function spin(player: Player)
	local profile = DataService.Get(player)
	if not profile or busy[player] then
		return
	end
	if RewardService.SpinReadyIn(player) > 0 then
		MonsterService.Notify(player, "Your free spin isn't ready yet!", "info")
		return
	end
	busy[player] = true
	profile.Data.LastSpin = os.time()
	local index = pickPrize()
	local prize = Config.Spin.Prizes[index]
	remotes.SpinResult:FireClient(player, index)
	MonsterService.PushState(player)

	-- نستنى العجلة تخلص لفّ قبل ما ندّي الجايزة
	task.delay(4.5, function()
		busy[player] = nil
		if not player.Parent then
			return
		end
		if prize.Coins then
			DataService.AddCoins(player, prize.Coins)
			MonsterService.Notify(player, "🎡 You won " .. prize.Name .. "!", "coins")
		elseif prize.Egg then
			MonsterService.Notify(player, "🎡 You won a " .. prize.Name .. "!", "success")
			giveEgg(player, prize.Egg)
		end
		MonsterService.PushState(player)
	end)
end

function RewardService.CleanupPlayer(player: Player)
	busy[player] = nil
end

function RewardService.Init(allRemotes: { [string]: RemoteEvent })
	remotes = allRemotes
	remotes.ClaimDaily.OnServerEvent:Connect(claimDaily)
	remotes.Spin.OnServerEvent:Connect(spin)
end

return RewardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">StealService</string>
          <string name="Source"><![CDATA[--!strict
-- سرقة الوحوش بستايل Steal a Brainrot:
-- تدخل قاعدة لاعب، تدوس مطوّل على وحش، تشيله فوق راسك وتجري بيه لقاعدتك.
-- لو صاحبه لحقك ولمسك، أو مُتّ، أو الوقت خلص → الوحش بيرجع لصاحبه.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)
local DataService = require(script.Parent.DataService)
local PlotService = require(script.Parent.PlotService)
local MonsterService = require(script.Parent.MonsterService)

type Carry = {
	Thief: Player,
	Owner: Player,
	MonsterId: string,
	Model: Model,
	StartedAt: number,
	OldWalkSpeed: number,
	DiedConnection: RBXScriptConnection?,
}

local StealService = {}

local carries: { [Player]: Carry } = {} -- thief → carry

local function getRoot(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function setCarried(owner: Player, monsterId: string, value: boolean)
	local set = MonsterService.Carried[owner]
	if not set then
		set = {}
		MonsterService.Carried[owner] = set
	end
	if value then
		set[monsterId] = true
	else
		set[monsterId] = nil
	end
end

local function endCarry(carry: Carry)
	carries[carry.Thief] = nil
	setCarried(carry.Owner, carry.MonsterId, false)
	if carry.DiedConnection then
		carry.DiedConnection:Disconnect()
	end
	carry.Model:Destroy()
	local humanoid = getHumanoid(carry.Thief)
	if humanoid then
		humanoid.WalkSpeed = carry.OldWalkSpeed
	end
end

-- الوحش يرجع لصاحبه
local function failCarry(carry: Carry, thiefMessage: string, ownerMessage: string?)
	endCarry(carry)
	local ownerProfile = DataService.Get(carry.Owner)
	local monster = ownerProfile and ownerProfile.Data.Monsters[carry.MonsterId]
	if monster then
		PlotService.RenderMonster(carry.Owner, monster)
		MonsterService.PushState(carry.Owner)
		if ownerMessage then
			MonsterService.Notify(carry.Owner, ownerMessage, "success")
		end
	end
	if carry.Thief.Parent and thiefMessage ~= "" then
		MonsterService.Notify(carry.Thief, thiefMessage, "error")
		MonsterService.PushState(carry.Thief)
	end
end

local function completeCarry(carry: Carry)
	local ownerProfile = DataService.Get(carry.Owner)
	local thiefProfile = DataService.Get(carry.Thief)
	local monster = ownerProfile and ownerProfile.Data.Monsters[carry.MonsterId]
	local slot = MonsterService.GetFreeSlot(carry.Thief)
	if not ownerProfile or not thiefProfile or not monster or not slot then
		failCarry(carry, "No free slot in your base! The monster went back to its owner.")
		return
	end

	endCarry(carry)

	ownerProfile.Data.Monsters[carry.MonsterId] = nil
	ownerProfile.Data.Stats.TimesRobbed += 1

	local newId = DataService.NewId(carry.Thief)
	local stolen: MonsterMath.MonsterData = table.clone(monster)
	stolen.Id = newId
	stolen.Slot = slot
	thiefProfile.Data.Monsters[newId] = stolen
	thiefProfile.Data.Stats.Steals += 1

	PlotService.RenderMonster(carry.Thief, stolen)

	local name = MonsterMath.GetDisplayName(stolen)
	MonsterService.Notify(carry.Thief, "🦹 You stole " .. name .. "!", "success")
	MonsterService.Notify(carry.Owner, "😱 " .. carry.Thief.DisplayName .. " stole your " .. name .. "!", "error")
	MonsterService.PushState(carry.Thief)
	MonsterService.PushState(carry.Owner)

	-- نحفظ الاتنين على طول عشان مفيش حد يخسر أو يكرر الوحش لو السيرفر وقع.
	task.spawn(DataService.Save, carry.Owner)
	task.spawn(DataService.Save, carry.Thief)
end

local function tryStartSteal(thief: Player, owner: Player, monsterId: string)
	if not Config.Steal.Enabled or thief == owner or carries[thief] then
		return
	end
	local ownerPlot = PlotService.GetPlot(owner)
	local thiefRoot = getRoot(thief)
	local humanoid = getHumanoid(thief)
	local ownerProfile = DataService.Get(owner)
	if not ownerPlot or not thiefRoot or not humanoid or humanoid.Health <= 0 or not ownerProfile then
		return
	end
	if not PlotService.GetPlot(thief) then
		return
	end
	if os.clock() < ownerPlot.LockedUntil then
		MonsterService.Notify(thief, "This base is locked! 🔒", "error")
		return
	end
	if not ownerProfile.Data.Monsters[monsterId] or MonsterService.IsCarried(owner, monsterId) then
		return
	end
	if Config.Steal.ProtectLastMonster and MonsterService.CountMonsters(owner) <= 1 then
		MonsterService.Notify(thief, "You can't steal a player's last monster.", "error")
		return
	end
	if not MonsterService.GetFreeSlot(thief) then
		MonsterService.Notify(thief, "Your base is full! Free up a slot first.", "error")
		return
	end

	local monster = ownerProfile.Data.Monsters[monsterId]
	setCarried(owner, monsterId, true)
	PlotService.RemoveMonster(owner, monsterId)

	-- نسخة من الوحش فوق راس الحرامي
	local model = PlotService.BuildMonsterModel(monster)
	local body = model.PrimaryPart :: BasePart
	local scale = math.min(1, 3 / body.Size.Y) -- الوحوش الكبيرة بتتشال أصغر شوية
	if scale < 1 then
		model:ScaleTo(scale)
	end
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.Massless = true
		end
	end
	model:PivotTo(thiefRoot.CFrame * CFrame.new(0, 3.5 + body.Size.Y / 2, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = thiefRoot
	weld.Part1 = body
	weld.Parent = body
	model.Name = "CarriedMonster"
	model.Parent = thief.Character

	local carry: Carry = {
		Thief = thief,
		Owner = owner,
		MonsterId = monsterId,
		Model = model,
		StartedAt = os.clock(),
		OldWalkSpeed = humanoid.WalkSpeed,
		DiedConnection = nil,
	}
	carry.DiedConnection = humanoid.Died:Connect(function()
		if carries[thief] == carry then
			failCarry(carry, "You dropped the monster! It went back to its owner.", "🛡️ The thief was knocked out. Your monster is back!")
		end
	end)
	carries[thief] = carry
	humanoid.WalkSpeed = Config.Steal.CarryWalkSpeed

	local name = MonsterMath.GetDisplayName(monster)
	MonsterService.Notify(thief, "🏃 You grabbed " .. name .. "! Run back to your base!", "warning")
	MonsterService.Notify(owner, "🚨 " .. thief.DisplayName .. " is stealing your " .. name .. "! Chase them and touch them!", "warning")
	MonsterService.PushState(owner)
end

local function update()
	for _, carry in carries do
		local thiefRoot = getRoot(carry.Thief)
		local thiefPlot = PlotService.GetPlot(carry.Thief)
		if not thiefRoot or not thiefPlot or not carry.Model.Parent then
			failCarry(carry, "You dropped the monster! It went back to its owner.")
			continue
		end
		if os.clock() - carry.StartedAt > Config.Steal.MaxCarryTime then
			failCarry(carry, "Time's up! The monster went back to its owner.")
			continue
		end
		local ownerRoot = getRoot(carry.Owner)
		local ownerHumanoid = getHumanoid(carry.Owner)
		if
			ownerRoot
			and ownerHumanoid
			and ownerHumanoid.Health > 0
			and (ownerRoot.Position - thiefRoot.Position).Magnitude <= Config.Steal.CatchRadius
		then
			failCarry(carry, "🚓 " .. carry.Owner.DisplayName .. " caught you! The monster went back.", "🛡️ You caught the thief and got your monster back!")
			continue
		end
		if PlotService.IsInsidePlot(thiefPlot, thiefRoot.Position) then
			completeCarry(carry)
		end
	end
end

-- لازم تتنادى قبل ما بيانات اللاعب تتمسح.
function StealService.CleanupPlayer(player: Player)
	local own = carries[player]
	if own then
		failCarry(own, "")
	end
	for _, carry in carries do
		if carry.Owner == player then
			-- صاحب الوحش خرج: نلغي السرقة والوحش يفضل في بياناته المحفوظة.
			endCarry(carry)
			MonsterService.Notify(carry.Thief, "The owner left the server, so the monster vanished.", "error")
		end
	end
end

function StealService.Init()
	PlotService.Callbacks.Steal = tryStartSteal
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.15 then
			accumulator = 0
			update()
		end
	end)
end

return StealService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">TerrainService</string>
          <string name="Source"><![CDATA[--!strict
-- جبال حوالين الماب كلها (Terrain) عشان من بعيد تبان تضاريس طبيعية مش حيطة،
-- ومعاها حاجز مخفي على الحدود يمنع اللاعبين يطلعوا برّه أو يقعوا في الـ Void.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Build = require(script.Parent.Build)
local PlotService = require(script.Parent.PlotService)
local ZoneService = require(script.Parent.ZoneService)

type Style = {
	Body: Enum.Material, -- سفح الجبل
	Peak: Enum.Material, -- القمم اللي ورا
	Cap: Enum.Material?, -- تلج فوق القمم العالية
	Lava: boolean, -- خطوط حمم نازلة على السفح
}

-- ورا القواعد والساحة
local BASE_STYLE: Style = { Body = Enum.Material.Grass, Peak = Enum.Material.Rock, Cap = Enum.Material.Snow, Lava = false }
-- بالترتيب زي Config.Zones
local ZONE_STYLES: { Style } = {
	{ Body = Enum.Material.Grass, Peak = Enum.Material.Grass, Cap = Enum.Material.Snow, Lava = false }, -- Meadow: تلال خضرا
	{ Body = Enum.Material.Grass, Peak = Enum.Material.Rock, Cap = Enum.Material.Snow, Lava = false }, -- Forest: صخور
	{ Body = Enum.Material.Basalt, Peak = Enum.Material.Basalt, Cap = nil, Lava = true }, -- Lava Canyon: منحدرات وحمم
	{ Body = Enum.Material.Slate, Peak = Enum.Material.Slate, Cap = nil, Lava = false }, -- Shadow Realm: قمم بنفسجي
}

local SPACING = 26 -- المسافة بين الجبال على الحدود
local CORNER_EXTENSION = 30 -- قد إيه الجبال بتكمّل بعد الأركان اللي لبرّه
local BARRIER_HEIGHT = 400

type Segment = {
	From: Vector3,
	To: Vector3,
	Normal: Vector3, -- لبرّه الماب
	ExtendStart: boolean, -- ركن لبرّه: الجبال تكمّل بعده
	ExtendEnd: boolean,
}

local TerrainService = {}

local function styleAt(x: number): Style
	if x < PlotService.ZonesStartX then
		return BASE_STYLE
	end
	local zoneLength = (ZoneService.ZonesEndX - PlotService.ZonesStartX) / #Config.Zones
	local index = math.clamp(math.floor((x - PlotService.ZonesStartX) / zoneLength) + 1, 1, #ZONE_STYLES)
	return ZONE_STYLES[index]
end

-- حدود الماب: منطقة القواعد عريضة، والمناطق أضيق (وادي بين الجبال).
local function boundary(): ({ Segment }, { { Corner: Vector3, A: Vector3, B: Vector3 } })
	local minX = PlotService.IslandMinX
	local midX = PlotService.ZonesStartX
	local maxX = ZoneService.ZonesEndX
	local bigZ = PlotService.PlazaHalfZ
	local smallZ = ZoneService.ZoneHalfZ
	local function v(x: number, z: number): Vector3
		return Vector3.new(x, 0, z)
	end
	local segments: { Segment } = {
		{ From = v(minX, -bigZ), To = v(minX, bigZ), Normal = v(-1, 0), ExtendStart = true, ExtendEnd = true },
		{ From = v(minX, -bigZ), To = v(midX, -bigZ), Normal = v(0, -1), ExtendStart = true, ExtendEnd = true },
		{ From = v(minX, bigZ), To = v(midX, bigZ), Normal = v(0, 1), ExtendStart = true, ExtendEnd = true },
		{ From = v(midX, -bigZ), To = v(midX, -smallZ), Normal = v(1, 0), ExtendStart = true, ExtendEnd = false },
		{ From = v(midX, bigZ), To = v(midX, smallZ), Normal = v(1, 0), ExtendStart = true, ExtendEnd = false },
		{ From = v(midX, -smallZ), To = v(maxX, -smallZ), Normal = v(0, -1), ExtendStart = false, ExtendEnd = true },
		{ From = v(midX, smallZ), To = v(maxX, smallZ), Normal = v(0, 1), ExtendStart = false, ExtendEnd = true },
		{ From = v(maxX, -smallZ), To = v(maxX, smallZ), Normal = v(1, 0), ExtendStart = true, ExtendEnd = true },
	}
	-- الأركان اللي لجوه (بين منطقة القواعد والمناطق) محتاجة جبال صغيرة تقفلها
	local innerCorners = {
		{ Corner = v(midX, -smallZ), A = v(1, 0), B = v(0, -1) },
		{ Corner = v(midX, smallZ), A = v(1, 0), B = v(0, 1) },
	}
	return segments, innerCorners
end

local function buildMountains(terrain: Terrain)
	local random = Random.new(2026)
	local segments, innerCorners = boundary()
	local up = Vector3.new(0, 1, 0)
	local filled = 0

	for _, segment in segments do
		local offset = segment.To - segment.From
		local length = offset.Magnitude
		local direction = offset.Unit
		local t = if segment.ExtendStart then -CORNER_EXTENSION else 0
		local stop = length + (if segment.ExtendEnd then CORNER_EXTENSION else 0)
		while t <= stop do
			local point = segment.From + direction * t
			local style = styleAt(point.X)

			-- قرب الأركان اللي لجوه الجبل بيصغر عشان مايدخلش جوه الماب
			local cap = math.huge
			if not segment.ExtendStart then
				cap = math.min(cap, t - 1)
			end
			if not segment.ExtendEnd then
				cap = math.min(cap, length - t - 1)
			end

			local radius = math.min(random:NextNumber(38, 58), cap)
			if radius >= 6 then
				-- السفح: بيبدأ من حدود الماب بالظبط
				local slope = point + segment.Normal * (radius * 0.95 + 2) - up * (radius * 0.3)
				terrain:FillBall(slope, radius, style.Body)

				-- قمة عالية ورا السفح
				local peakRadius = math.min(random:NextNumber(34, 52), cap)
				local back = math.max(radius * 0.95 + 2 + random:NextNumber(18, 34), peakRadius + 2)
				local peak = point + segment.Normal * back + up * random:NextNumber(peakRadius * 0.7, peakRadius * 1.5)
				terrain:FillBall(peak, peakRadius, style.Peak)
				if style.Cap and peak.Y + peakRadius > 85 then
					terrain:FillBall(peak + up * (peakRadius * 0.8), peakRadius * 0.35, style.Cap)
				end

				-- خطوط حمم نازلة على السفح ناحية الماب
				if style.Lava and random:NextNumber() < 0.6 then
					for angle = 0.35, 1.2, 0.17 do
						local surface = slope + (-segment.Normal * math.cos(angle) + up * math.sin(angle)) * radius
						terrain:FillBall(surface, 3.5, Enum.Material.CrackedLava)
					end
				end
			end

			filled += 1
			if filled % 6 == 0 then
				task.wait()
			end
			t += SPACING * random:NextNumber(0.8, 1.2)
		end
	end

	for _, inner in innerCorners do
		for _, size in { 34, 20, 11 } do
			local center = inner.Corner + (inner.A + inner.B) * (size + 1) - up * (size * 0.2)
			terrain:FillBall(center, size, BASE_STYLE.Body)
		end
	end
end

-- حاجز مخفي على حدود الماب: محدش يطلع على الجبال أو يقع برّه
local function buildBarrier(folder: Folder)
	local segments = boundary()
	for _, segment in segments do
		local offset = segment.To - segment.From
		local middle = (segment.From + segment.To) / 2 + segment.Normal * 2
		local alongX = math.abs(offset.X) > math.abs(offset.Z)
		local length = offset.Magnitude + 8
		Build.MakePart({
			Name = "Barrier",
			Size = if alongX then Vector3.new(length, BARRIER_HEIGHT, 4) else Vector3.new(4, BARRIER_HEIGHT, length),
			Position = middle + Vector3.new(0, BARRIER_HEIGHT / 2 - 10, 0),
			Transparency = 1,
			CanCollide = true,
			CanTouch = false,
			CanQuery = false,
			Parent = folder,
		})
	end
end

function TerrainService.Init()
	local terrain = workspace.Terrain
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(100, 165, 75))
	terrain:SetMaterialColor(Enum.Material.Slate, Color3.fromRGB(90, 60, 130))
	terrain:SetMaterialColor(Enum.Material.Basalt, Color3.fromRGB(60, 45, 45))

	local folder = Instance.new("Folder")
	folder.Name = "MapBorder"
	folder.Parent = workspace
	buildBarrier(folder)
	task.spawn(buildMountains, terrain)
end

return TerrainService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">TradeService</string>
          <string name="Source"><![CDATA[--!strict
-- تبديل وحوش بين لاعبين: واحد يبعت طلب، التاني يقبل، كل واحد يختار وحوشه،
-- والتبديل بيحصل بس لما الاتنين يدوسوا "Ready" (شاشة تأكيد من الطرفين).
-- أي تغيير في العرض بيلغي الـ Ready عند الاتنين عشان محدش يتخدع.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)
local DataService = require(script.Parent.DataService)
local MonsterService = require(script.Parent.MonsterService)

type Trade = {
	Players: { Player },
	Offers: { [Player]: { string } },
	Ready: { [Player]: boolean },
}

local TradeService = {}

local remotes: { [string]: RemoteEvent }
local trades: { [Player]: Trade } = {}
local requests: { [Player]: { [Player]: number } } = {} -- requests[target][from] = وقت الطلب

local function partnerOf(trade: Trade, player: Player): Player
	return if trade.Players[1] == player then trade.Players[2] else trade.Players[1]
end

local function summarize(player: Player, ids: { string }): { any }
	local profile = DataService.Get(player)
	local result = {}
	for _, id in ids do
		local monster = profile and profile.Data.Monsters[id]
		if monster then
			local species = Config.Species[monster.Species]
			table.insert(result, {
				Id = id,
				Name = MonsterMath.GetDisplayName(monster),
				Rarity = species and species.Rarity or "Common",
				Level = monster.Level,
			})
		end
	end
	return result
end

local function sendUpdate(trade: Trade)
	for _, player in trade.Players do
		local partner = partnerOf(trade, player)
		remotes.TradeUpdate:FireClient(player, {
			PartnerName = partner.DisplayName,
			MyOffer = summarize(player, trade.Offers[player]),
			TheirOffer = summarize(partner, trade.Offers[partner]),
			MyReady = trade.Ready[player] == true,
			TheirReady = trade.Ready[partner] == true,
		})
	end
end

local function closeTrade(trade: Trade, message: string?)
	for _, player in trade.Players do
		if trades[player] == trade then
			trades[player] = nil
		end
		if player.Parent then
			remotes.TradeUpdate:FireClient(player, nil)
			if message then
				MonsterService.Notify(player, message, "info")
			end
		end
	end
end

local function validOffer(player: Player, ids: { string }): boolean
	local profile = DataService.Get(player)
	if not profile then
		return false
	end
	local seen: { [string]: boolean } = {}
	for _, id in ids do
		if seen[id] or not profile.Data.Monsters[id] or MonsterService.IsCarried(player, id) then
			return false
		end
		seen[id] = true
	end
	return true
end

local function execute(trade: Trade)
	local a, b = trade.Players[1], trade.Players[2]
	local offerA, offerB = trade.Offers[a], trade.Offers[b]
	if not validOffer(a, offerA) or not validOffer(b, offerB) then
		closeTrade(trade, "Trade cancelled: a monster is not available anymore.")
		return
	end
	-- كل واحد لازم يبقى عنده مكان للي جاي له
	if MonsterService.CountFreeSlots(a) + #offerA < #offerB or MonsterService.CountFreeSlots(b) + #offerB < #offerA then
		closeTrade(trade, "Trade cancelled: not enough free slots in a base.")
		return
	end
	local fromA, fromB = {}, {}
	for _, id in offerA do
		local monster = MonsterService.TakeMonsterData(a, id)
		if monster then
			table.insert(fromA, monster)
		end
	end
	for _, id in offerB do
		local monster = MonsterService.TakeMonsterData(b, id)
		if monster then
			table.insert(fromB, monster)
		end
	end
	for _, monster in fromA do
		MonsterService.InsertMonsterData(b, monster)
	end
	for _, monster in fromB do
		MonsterService.InsertMonsterData(a, monster)
	end
	closeTrade(trade)
	for _, player in trade.Players do
		MonsterService.Notify(player, "🤝 Trade complete!", "success")
		MonsterService.PushState(player)
		task.spawn(DataService.Save, player)
	end
end

local function onRequest(player: Player, targetUserId: unknown)
	if type(targetUserId) ~= "number" or trades[player] then
		return
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or target == player then
		return
	end
	if trades[target] then
		MonsterService.Notify(player, target.DisplayName .. " is already trading.", "error")
		return
	end
	requests[target] = requests[target] or {}
	requests[target][player] = os.clock()
	remotes.TradeIncoming:FireClient(target, player.UserId, player.DisplayName)
	MonsterService.Notify(player, "📨 Trade request sent to " .. target.DisplayName, "info")
end

local function onRespond(player: Player, fromUserId: unknown, accepted: unknown)
	if type(fromUserId) ~= "number" then
		return
	end
	local from = Players:GetPlayerByUserId(fromUserId)
	local pending = requests[player]
	local sentAt = from and pending and pending[from]
	if not from or not pending or not sentAt then
		return
	end
	pending[from] = nil
	if accepted ~= true then
		MonsterService.Notify(from, player.DisplayName .. " declined your trade.", "info")
		return
	end
	if os.clock() - sentAt > Config.Trade.RequestTimeout or trades[player] or trades[from] then
		MonsterService.Notify(player, "That trade request expired.", "error")
		return
	end
	local trade: Trade = { Players = { from, player }, Offers = { [from] = {}, [player] = {} }, Ready = {} }
	trades[from] = trade
	trades[player] = trade
	sendUpdate(trade)
end

local function onSetOffer(player: Player, ids: unknown)
	local trade = trades[player]
	if not trade or type(ids) ~= "table" then
		return
	end
	local clean: { string } = {}
	for _, id in ids :: { any } do
		if type(id) == "string" and #clean < Config.Trade.MaxOffer then
			table.insert(clean, id)
		end
	end
	if not validOffer(player, clean) then
		return
	end
	trade.Offers[player] = clean
	trade.Ready = {} -- أي تغيير بيلغي التأكيد
	sendUpdate(trade)
end

local function onReady(player: Player, ready: unknown)
	local trade = trades[player]
	if not trade then
		return
	end
	trade.Ready[player] = ready == true
	local partner = partnerOf(trade, player)
	if trade.Ready[player] and trade.Ready[partner] then
		execute(trade)
	else
		sendUpdate(trade)
	end
end

local function onCancel(player: Player)
	local trade = trades[player]
	if trade then
		closeTrade(trade, player.DisplayName .. " cancelled the trade.")
	end
end

function TradeService.CleanupPlayer(player: Player)
	onCancel(player)
	requests[player] = nil
	for _, pending in requests do
		pending[player] = nil
	end
end

function TradeService.Init(allRemotes: { [string]: RemoteEvent })
	remotes = allRemotes
	remotes.TradeRequest.OnServerEvent:Connect(onRequest)
	remotes.TradeRespond.OnServerEvent:Connect(onRespond)
	remotes.TradeSetOffer.OnServerEvent:Connect(onSetOffer)
	remotes.TradeReady.OnServerEvent:Connect(onReady)
	remotes.TradeCancel.OnServerEvent:Connect(onCancel)
end

return TradeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">ZoneService</string>
          <string name="Source"><![CDATA[--!strict
-- مناطق الوحوش: طريق طالع من الساحة بيعدّي على مناطق ورا بعض، وكل ما تبعد الأم بتبقى أقوى.
-- في كل منطقة أعشاش، كل عش فيه وحش أم وحواليه صغارها.
-- لازم تقتل الأم الأول عشان تقدر تاخد الصغار، وكل 10 دقايق الأعشاش بتتجدد بوحوش تانية.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)
local Build = require(script.Parent.Build)
local PlotService = require(script.Parent.PlotService)
local MonsterService = require(script.Parent.MonsterService)
local CombatService = require(script.Parent.CombatService)
local CarryService = require(script.Parent.CarryService)

local makePart = Build.MakePart
local makeBillboard = Build.MakeBillboard
local makePrompt = Build.MakePrompt

local ZONE_LENGTH = 140
local ZONE_HALF_Z = 100
local ROAD_WIDTH = 20
local NEST_RADIUS = 17
local NEST_Z = 55
local NEST_TOP = 1
local PLACEHOLDER_COLOR = Color3.fromRGB(163, 162, 165)

type Nest = {
	Zone: Config.Zone,
	Center: Vector3,
	Folder: Folder,
	Species: string?,
	Alive: boolean,
	Health: number,
	MaxHealth: number,
	LastHit: number,
	Mother: BasePart?,
	HealthFill: Frame?,
	HealthText: TextLabel?,
	Babies: { BasePart },
	Damagers: { [Player]: number },
	Target: CombatService.Target?,
}

local ZoneService = {}

-- حدود المناطق (الجبال بتلف حواليها)
ZoneService.ZoneHalfZ = ZONE_HALF_Z
ZoneService.ZonesEndX = PlotService.ZonesStartX + #Config.Zones * ZONE_LENGTH

local zonesFolder: Folder
local nests: { Nest } = {}
local gateLabels: { { Label: TextLabel, Title: string } } = {}
local nextResetAt = 0

local function zoneStartX(index: number): number
	return PlotService.ZonesStartX + (index - 1) * ZONE_LENGTH
end

local function stars(count: number): string
	return string.rep("⭐", count)
end

local function rarityHex(species: string): string
	return Build.ColorToHex(Config.Rarities[Config.Species[species].Rarity].Color)
end

-- شكل المنطقة ---------------------------------------------------------------------

local function decorate(index: number, zone: Config.Zone, folder: Folder, nestCenters: { Vector3 })
	local random = Random.new(index * 1000)
	local x0 = zoneStartX(index)
	local placed = 0
	local attempts = 0
	while placed < 22 and attempts < 200 do
		attempts += 1
		local position = Vector3.new(
			random:NextNumber(x0 + 8, x0 + ZONE_LENGTH - 8),
			0,
			random:NextNumber(-ZONE_HALF_Z + 6, ZONE_HALF_Z - 6)
		)
		local blocked = math.abs(position.Z) < ROAD_WIDTH / 2 + 6
		for _, center in nestCenters do
			if (Vector3.new(center.X, 0, center.Z) - position).Magnitude < NEST_RADIUS + 8 then
				blocked = true
			end
		end
		if blocked then
			continue
		end
		placed += 1
		local spin = CFrame.Angles(0, random:NextNumber(0, math.pi * 2), 0)

		if zone.Decoration == "Flowers" then
			local bush = random:NextNumber() < 0.4
			if bush then
				makePart({
					Name = "Bush",
					Shape = Enum.PartType.Ball,
					Size = Vector3.one * random:NextNumber(3, 5),
					Position = position + Vector3.new(0, 1.5, 0),
					Color = Color3.fromRGB(70, 160, 70),
					Material = Enum.Material.Grass,
					CanCollide = false,
					Parent = folder,
				})
			else
				local colors = { Color3.fromRGB(255, 120, 180), Color3.fromRGB(255, 230, 90), Color3.fromRGB(255, 255, 255) }
				for i = 1, 4 do
					makePart({
						Name = "Flower",
						Shape = Enum.PartType.Ball,
						Size = Vector3.one * 1.2,
						Position = position + Vector3.new(random:NextNumber(-2, 2), 0.6, random:NextNumber(-2, 2)),
						Color = colors[(i % #colors) + 1],
						Material = Enum.Material.SmoothPlastic,
						CanCollide = false,
						Parent = folder,
					})
				end
			end
		elseif zone.Decoration == "Trees" then
			local height = random:NextNumber(8, 13)
			makePart({
				Name = "Trunk",
				Size = Vector3.new(1.6, height, 1.6),
				Position = position + Vector3.new(0, height / 2, 0),
				Color = Color3.fromRGB(110, 75, 45),
				Material = Enum.Material.Wood,
				Parent = folder,
			})
			makePart({
				Name = "Leaves",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * random:NextNumber(8, 11),
				Position = position + Vector3.new(0, height + 2, 0),
				Color = Color3.fromRGB(40, 110 + random:NextInteger(0, 40), 45),
				Material = Enum.Material.Grass,
				CanCollide = false,
				Parent = folder,
			})
		elseif zone.Decoration == "Lava" then
			if random:NextNumber() < 0.55 then
				makePart({
					Name = "Lava",
					Size = Vector3.new(random:NextNumber(10, 24), 0.3, random:NextNumber(3, 7)),
					CFrame = CFrame.new(position + Vector3.new(0, 0.1, 0)) * spin,
					Color = Color3.fromRGB(255, 110, 20),
					Material = Enum.Material.Neon,
					CanCollide = false,
					Parent = folder,
				})
			else
				local size = random:NextNumber(3, 7)
				makePart({
					Name = "Rock",
					Size = Vector3.new(size, size * 0.8, size),
					CFrame = CFrame.new(position + Vector3.new(0, size * 0.4, 0)) * spin,
					Color = Color3.fromRGB(45, 35, 35),
					Material = Enum.Material.Basalt,
					Parent = folder,
				})
			end
		elseif zone.Decoration == "Crystals" then
			local height = random:NextNumber(5, 12)
			makePart({
				Name = "Crystal",
				Size = Vector3.new(2, height, 2),
				CFrame = CFrame.new(position + Vector3.new(0, height / 2 - 0.5, 0))
					* spin
					* CFrame.Angles(random:NextNumber(-0.25, 0.25), 0, random:NextNumber(-0.25, 0.25)),
				Color = Color3.fromRGB(170, 70, 255),
				Material = Enum.Material.Neon,
				Parent = folder,
			})
		end
	end
end

local function buildGate(index: number, zone: Config.Zone, folder: Folder)
	local x = zoneStartX(index)
	local stoneColor = Color3.fromRGB(105, 105, 110)
	local pillarZ = ROAD_WIDTH / 2 + 2
	for _, side in { -1, 1 } do
		makePart({
			Name = "GatePillar",
			Size = Vector3.new(4, 16, 4),
			Position = Vector3.new(x, 8, side * pillarZ),
			Color = stoneColor,
			Material = Enum.Material.Cobblestone,
			Parent = folder,
		})
		-- سور واطي على حدود المنطقة عشان الطريق يعدّي من البوابة
		local wallLength = ZONE_HALF_Z - pillarZ - 2
		makePart({
			Name = "ZoneWall",
			Size = Vector3.new(2, 4, wallLength),
			Position = Vector3.new(x, 2, side * (pillarZ + 2 + wallLength / 2)),
			Color = stoneColor,
			Material = Enum.Material.Cobblestone,
			Parent = folder,
		})
	end
	local beam = makePart({
		Name = "GateBeam",
		Size = Vector3.new(4, 3, pillarZ * 2 + 4),
		Position = Vector3.new(x, 17.5, 0),
		Color = zone.AccentColor,
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	local gui, label = makeBillboard(beam, UDim2.fromScale(34, 11), Vector3.new(0, 7, 0), 160)
	gui.AlwaysOnTop = false
	local title = string.format(
		'<font color="%s">ZONE %d · %s</font>\n%s %s',
		Build.ColorToHex(zone.AccentColor),
		index,
		string.upper(zone.Name),
		stars(zone.Stars),
		string.upper(zone.Difficulty)
	)
	label.Text = title
	table.insert(gateLabels, { Label = label, Title = title })
end

local function buildZone(index: number, zone: Config.Zone)
	local folder = Instance.new("Folder")
	folder.Name = "Zone" .. index .. "_" .. zone.Name
	folder.Parent = zonesFolder

	local x0 = zoneStartX(index)
	makePart({
		Name = "Ground",
		Size = Vector3.new(ZONE_LENGTH, 2, ZONE_HALF_Z * 2),
		Position = Vector3.new(x0 + ZONE_LENGTH / 2, -1, 0),
		Color = zone.GroundColor,
		Material = zone.GroundMaterial,
		Parent = folder,
	})
	makePart({
		Name = "Road",
		Size = Vector3.new(ZONE_LENGTH, 0.2, ROAD_WIDTH),
		Position = Vector3.new(x0 + ZONE_LENGTH / 2, 0.1, 0),
		Color = Color3.fromRGB(150, 120, 90),
		Material = Enum.Material.Cobblestone,
		Parent = folder,
	})
	buildGate(index, zone, folder)

	local centers: { Vector3 } = {}
	for n = 1, Config.NestsPerZone do
		local x = x0 + ZONE_LENGTH * n / (Config.NestsPerZone + 1)
		local z = if n % 2 == 1 then -NEST_Z else NEST_Z
		local center = Vector3.new(x, NEST_TOP, z)
		table.insert(centers, center)

		makePart({
			Name = "Nest",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(NEST_TOP, NEST_RADIUS * 2, NEST_RADIUS * 2),
			CFrame = CFrame.new(x, NEST_TOP / 2, z) * CFrame.Angles(0, 0, math.rad(90)),
			Color = zone.AccentColor:Lerp(Color3.fromRGB(70, 70, 75), 0.6),
			Material = Enum.Material.Slate,
			Parent = folder,
		})

		local nestFolder = Instance.new("Folder")
		nestFolder.Name = "Nest" .. n
		nestFolder.Parent = folder
		table.insert(nests, {
			Zone = zone,
			Center = center,
			Folder = nestFolder,
			Species = nil,
			Alive = false,
			Health = 0,
			MaxHealth = zone.MotherHealth,
			LastHit = 0,
			Mother = nil,
			HealthFill = nil,
			HealthText = nil,
			Babies = {},
			Damagers = {},
			Target = nil,
		})
	end

	decorate(index, zone, folder, centers)
end

-- الأم والصغار ----------------------------------------------------------------------

local function updateHealthBar(nest: Nest)
	local fill = nest.HealthFill
	local text = nest.HealthText
	if not fill or not text then
		return
	end
	local ratio = math.clamp(nest.Health / nest.MaxHealth, 0, 1)
	fill.Size = UDim2.fromScale(ratio, 1)
	text.Text = MonsterMath.FormatNumber(math.max(0, nest.Health)) .. " / " .. MonsterMath.FormatNumber(nest.MaxHealth)
end

local function babyText(nest: Nest): string
	local species = nest.Species :: string
	local name = Config.Species[species].DisplayName
	if nest.Alive then
		return string.format('<font color="%s">%s</font>\n🔒 Defeat the mother', rarityHex(species), name)
	end
	return string.format('<font color="%s">%s</font>\n✋ Hold E to take', rarityHex(species), name)
end

local function killMother(nest: Nest, killer: Player)
	nest.Alive = false
	nest.Health = 0
	CombatService.Unregister(nest.Target)
	nest.Target = nil
	if nest.Mother then
		nest.Mother:Destroy()
		nest.Mother = nil
	end
	nest.HealthFill = nil
	nest.HealthText = nil
	for _, baby in nest.Babies do
		local prompt = baby:FindFirstChild("TakePrompt") :: ProximityPrompt?
		if prompt then
			prompt.Enabled = true
		end
		local info = baby:FindFirstChild("Info")
		local label = info and info:FindFirstChild("Label") :: TextLabel?
		if label then
			label.Text = babyText(nest)
		end
	end
	local name = Config.Species[nest.Species :: string].DisplayName
	for player in nest.Damagers do
		if player.Parent then
			MonsterService.Notify(
				player,
				"🏆 " .. killer.DisplayName .. " finished off the " .. name .. " mother! Grab her babies!",
				"success"
			)
		end
	end
end

local function attack(player: Player, nest: Nest, damage: number)
	if not nest.Alive then
		return
	end
	nest.Health -= damage
	nest.Damagers[player] = (nest.Damagers[player] or 0) + damage
	nest.LastHit = os.clock()

	local mother = nest.Mother
	if mother then
		mother.Color = Color3.fromRGB(255, 90, 90)
		task.delay(0.1, function()
			if mother.Parent then
				mother.Color = PLACEHOLDER_COLOR:Lerp(Color3.new(0, 0, 0), 0.3)
			end
		end)
	end

	if nest.Health <= 0 then
		killMother(nest, player)
	else
		updateHealthBar(nest)
	end
end

-- الصغير بيتشال على ضهرك، ولازم توصله قاعدتك عشان يبقى بتاعك
local function take(player: Player, nest: Nest, baby: BasePart)
	if nest.Alive or not baby.Parent or not nest.Species then
		return
	end
	if not nest.Damagers[player] then
		MonsterService.Notify(player, "Help defeat the mother first to take her babies!", "error")
		return
	end
	local cargo: CarryService.Cargo = { Kind = "Monster", Species = nest.Species, Mutation = MonsterService.RollMutation(1) }
	if CarryService.StartCarry(player, cargo) then
		baby:Destroy()
		local index = table.find(nest.Babies, baby)
		if index then
			table.remove(nest.Babies, index)
		end
	end
end

local function clearNest(nest: Nest)
	CombatService.Unregister(nest.Target)
	nest.Target = nil
	nest.Folder:ClearAllChildren()
	nest.Mother = nil
	nest.HealthFill = nil
	nest.HealthText = nil
	nest.Babies = {}
	nest.Damagers = {}
	nest.Alive = false
end

local function spawnNest(nest: Nest)
	clearNest(nest)

	-- وحش مختلف عن اللي كان قبل كده لو ينفع
	local pool = nest.Zone.Species
	local species = pool[math.random(1, #pool)]
	if #pool > 1 then
		while species == nest.Species do
			species = pool[math.random(1, #pool)]
		end
	end
	nest.Species = species
	nest.Alive = true
	nest.MaxHealth = nest.Zone.MotherHealth
	nest.Health = nest.MaxHealth
	nest.LastHit = 0

	local name = Config.Species[species].DisplayName
	local size = nest.Zone.MotherSize
	local mother = makePart({
		Name = "Mother",
		Size = Vector3.one * size,
		Position = nest.Center + Vector3.new(0, size / 2, 0),
		Color = PLACEHOLDER_COLOR:Lerp(Color3.new(0, 0, 0), 0.3),
		Material = Enum.Material.SmoothPlastic,
		Parent = nest.Folder,
	})
	nest.Mother = mother

	-- مقاسات الـ Billboards بالـ studs عشان تصغر مع البعد وماتركبش على بعض
	local gui, label = makeBillboard(mother, UDim2.fromScale(16, 5.5), Vector3.new(0, size / 2 + 3.5, 0), 120)
	gui.Name = "Info"
	gui.AlwaysOnTop = false
	label.Size = UDim2.fromScale(1, 0.6)
	label.Text = string.format('<font color="%s">%s</font> · MOTHER\n🏏 Hit her with your bat', rarityHex(species), name)

	local bar = Instance.new("Frame")
	bar.Name = "HealthBar"
	bar.Size = UDim2.fromScale(1, 0.32)
	bar.Position = UDim2.fromScale(0, 0.66)
	bar.BackgroundColor3 = Color3.fromRGB(40, 20, 20)
	bar.BorderSizePixel = 0
	bar.Parent = gui
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(230, 50, 50)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	local hpText = Instance.new("TextLabel")
	hpText.Name = "HealthText"
	hpText.Size = UDim2.fromScale(1, 1)
	hpText.BackgroundTransparency = 1
	hpText.Font = Enum.Font.FredokaOne
	hpText.TextScaled = true
	hpText.TextColor3 = Color3.new(1, 1, 1)
	hpText.TextStrokeTransparency = 0.3
	hpText.ZIndex = 2
	hpText.Parent = bar
	nest.HealthFill = fill
	nest.HealthText = hpText
	updateHealthBar(nest)

	-- المضرب بيضربها لما تبقى قريب منها
	nest.Target = CombatService.Register({
		Part = mother,
		Radius = size / 2,
		OnHit = function(player: Player, damage: number)
			attack(player, nest, damage)
		end,
	})

	for i = 1, Config.BabiesPerNest do
		local angle = (i / Config.BabiesPerNest) * math.pi * 2
		local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (size / 2 + 6)
		local baby = makePart({
			Name = "Baby",
			Size = Vector3.one * 2.5,
			Position = nest.Center + offset + Vector3.new(0, 1.25, 0),
			Color = PLACEHOLDER_COLOR,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Parent = nest.Folder,
		})
		local babyGui, babyLabel = makeBillboard(baby, UDim2.fromScale(7, 2.2), Vector3.new(0, 3, 0), 60)
		babyGui.Name = "Info"
		babyGui.AlwaysOnTop = false
		babyLabel.Text = babyText(nest)
		local takePrompt = makePrompt(baby, "TakePrompt", "Take", Enum.KeyCode.E, Config.Combat.TakeHoldDuration)
		takePrompt.ObjectText = name
		takePrompt.Enabled = false
		takePrompt.Triggered:Connect(function(player)
			take(player, nest, baby)
		end)
		table.insert(nest.Babies, baby)
	end
end

local function resetAll()
	for _, nest in nests do
		spawnNest(nest)
	end
	nextResetAt = os.clock() + Config.ZoneResetInterval
end

-- اللوب -----------------------------------------------------------------------------

-- الأم بتضرب أي لاعب قريب منها، والـ HP بيرجع كامل لو محدش ضربها شوية.
local function motherTick()
	local now = os.clock()
	for _, nest in nests do
		local mother = nest.Mother
		if not nest.Alive or not mother then
			continue
		end
		if nest.Health < nest.MaxHealth and now - nest.LastHit > Config.Combat.MotherRegenDelay then
			nest.Health = nest.MaxHealth
			nest.Damagers = {}
			updateHealthBar(nest)
		end
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if root and humanoid and humanoid.Health > 0 then
				local flat = Vector3.new(root.Position.X - mother.Position.X, 0, root.Position.Z - mother.Position.Z)
				if flat.Magnitude <= Config.Combat.MotherAttackRange then
					humanoid:TakeDamage(nest.Zone.MotherDamage)
				end
			end
		end
	end
end

local function updateGateTimers()
	local left = math.max(0, math.ceil(nextResetAt - os.clock()))
	local timer = string.format("🔄 New monsters in %d:%02d", left // 60, left % 60)
	for _, gate in gateLabels do
		gate.Label.Text = gate.Title .. "\n" .. timer
	end
end

function ZoneService.CleanupPlayer(player: Player)
	for _, nest in nests do
		nest.Damagers[player] = nil
	end
end

function ZoneService.Init()
	zonesFolder = Instance.new("Folder")
	zonesFolder.Name = "Zones"
	zonesFolder.Parent = workspace

	for index, zone in Config.Zones do
		buildZone(index, zone)
	end
	resetAll()

	task.spawn(function()
		while true do
			task.wait(Config.Combat.MotherAttackInterval)
			motherTick()
		end
	end)

	task.spawn(function()
		while true do
			task.wait(1)
			if os.clock() >= nextResetAt then
				resetAll()
				for _, player in Players:GetPlayers() do
					MonsterService.Notify(player, "🔄 The monster zones have new monsters!", "info")
				end
			end
			updateGateTimers()
		end
	end)
	updateGateTimers()
end

return ZoneService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="24">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="25">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="26">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- الكلاينت: الواجهة، إظهار/إخفاء أزرار الـ ProximityPrompt، وتأثير الـ Rainbow.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local UI = require(script.UI)
local Features = require(script.Features)

local player = Players.LocalPlayer
local remotes = Remotes.Get()
local ui = UI.Create(player:WaitForChild("PlayerGui") :: PlayerGui)

local state: any = nil
local openMonsterId: string? = nil
local sellConfirmUntil = 0

Features.Init(ui, remotes, function()
	return state
end, function()
	return openMonsterId
end)

-- تحديث الواجهة ---------------------------------------------------------------------

local function findMonster(id: string?): any
	if not state or not id then
		return nil
	end
	for _, monster in state.Monsters do
		if monster.Id == id then
			return monster
		end
	end
	return nil
end

local function refreshMonsterPanel()
	if not ui.MonsterFrame.Visible then
		return
	end
	local monster = findMonster(openMonsterId)
	if not monster or monster.Carried then
		ui.MonsterFrame.Visible = false
		return
	end
	local rarity = Config.Rarities[monster.Rarity]
	ui.MonsterName.Text = monster.DisplayName
	ui.MonsterName.TextColor3 = rarity.Color
	ui.MonsterInfo.Text = string.format(
		"%s · %s · Level %d%s",
		monster.Rarity,
		monster.Stage,
		monster.Level,
		if monster.Mutation then " · ✨ " .. monster.Mutation else ""
	)

	if monster.MaxLevel then
		UI.SetBar(ui.XpBar, 1, "MAX LEVEL")
	else
		UI.SetBar(
			ui.XpBar,
			monster.Xp / monster.XpNeeded,
			string.format("%d / %d", math.floor(monster.Xp), monster.XpNeeded)
		)
	end
	UI.SetBar(ui.HungerBar, monster.Hunger / 100, string.format("%d%%", math.floor(monster.Hunger)))
	UI.SetBar(ui.HappyBar, monster.Happiness / 100, string.format("%d%%", math.floor(monster.Happiness)))

	-- المرحلة الجاية
	local nextStage = nil
	for _, stage in Config.Stages do
		if stage.MinLevel > monster.Level then
			nextStage = stage
			break
		end
	end
	local nextText = if nextStage
		then string.format("\nEvolves into %s at Lv %d", nextStage.Name, nextStage.MinLevel)
		else "\nFully evolved! 👑"
	local warning = ""
	if monster.Hunger < Config.LowNeedsThreshold or monster.Happiness < Config.LowNeedsThreshold then
		warning = " (sad monsters make less!)"
	end
	ui.ProductionLabel.Text = "💰 +" .. MonsterMath.FormatNumber(monster.Production) .. "/s" .. warning .. nextText

	ui.FeedButton.Text = "🍖 Feed (" .. MonsterMath.FormatNumber(monster.FoodCost) .. ")"
	ui.FeedButton.BackgroundColor3 = if state.Coins >= monster.FoodCost then UI.Colors.Orange else UI.Colors.Gray

	if monster.PlayReadyIn > 0 then
		ui.PlayButton.Text = string.format("🎮 Play (%ds)", math.ceil(monster.PlayReadyIn))
		ui.PlayButton.BackgroundColor3 = UI.Colors.Gray
	else
		ui.PlayButton.Text = "🎮 Mini-game"
		ui.PlayButton.BackgroundColor3 = UI.Colors.Pink
	end

	if os.clock() < sellConfirmUntil then
		ui.SellButton.Text = "Tap again to confirm sell"
	else
		ui.SellButton.Text = "Sell for 💰 " .. MonsterMath.FormatNumber(monster.SellValue)
	end
end

local function refresh()
	if not state then
		return
	end
	ui.CoinsLabel.Text = "💰 " .. MonsterMath.FormatNumber(state.Coins)
	local production = 0
	for _, monster in state.Monsters do
		if not monster.Carried then
			production += monster.Production
		end
	end
	ui.PendingLabel.Text = string.format(
		"+%s/s · %s waiting at your base",
		MonsterMath.FormatNumber(production),
		MonsterMath.FormatNumber(state.PendingCoins)
	)

	for eggType, eggButton in ui.EggButtons do
		local egg = Config.Eggs[eggType]
		eggButton.BackgroundColor3 = if state.Coins >= egg.Cost then UI.Colors.Green else UI.Colors.Gray
	end

	local used = #state.Monsters + #state.Eggs
	ui.SlotsInfo.Text = string.format("🏠 Base slots: %d / %d  (used: %d)", state.UnlockedSlots, state.MaxSlots, used)
	if state.NextSlotCost then
		ui.SlotsButton.Text = "Unlock slot · 💰 " .. MonsterMath.FormatNumber(state.NextSlotCost)
		ui.SlotsButton.BackgroundColor3 = if state.Coins >= state.NextSlotCost then UI.Colors.Green else UI.Colors.Gray
	else
		ui.SlotsButton.Text = "MAX"
		ui.SlotsButton.BackgroundColor3 = UI.Colors.Gray
	end

	ui.LockInfo.Text = string.format("🔒 Base lock lasts %ds", state.LockDuration)
	if state.NextLockCost then
		ui.LockButton.Text = "+" .. Config.LockDurationPerUpgrade .. "s lock · 💰 " .. MonsterMath.FormatNumber(state.NextLockCost)
		ui.LockButton.BackgroundColor3 = if state.Coins >= state.NextLockCost then UI.Colors.Green else UI.Colors.Gray
	else
		ui.LockButton.Text = "MAX"
		ui.LockButton.BackgroundColor3 = UI.Colors.Gray
	end

	refreshMonsterPanel()
	Features.Refresh()
end

-- الأحداث -------------------------------------------------------------------------------

remotes.StateUpdate.OnClientEvent:Connect(function(newState)
	state = newState
	refresh()
end)

remotes.Notify.OnClientEvent:Connect(function(text: string, kind: string)
	UI.Toast(ui, text, kind)
end)

remotes.OpenShop.OnClientEvent:Connect(function()
	UI.Open(ui, ui.ShopFrame)
end)

remotes.OpenMonster.OnClientEvent:Connect(function(monsterId: string)
	openMonsterId = monsterId
	sellConfirmUntil = 0
	UI.Open(ui, ui.MonsterFrame)
	refresh()
end)

ui.ShopButton.Activated:Connect(function()
	UI.Toggle(ui, ui.ShopFrame)
end)
ui.UpgradesButton.Activated:Connect(function()
	UI.Toggle(ui, ui.UpgradesFrame)
end)

for eggType, eggButton in ui.EggButtons do
	eggButton.Activated:Connect(function()
		remotes.BuyEgg:FireServer(eggType)
	end)
end

ui.SlotsButton.Activated:Connect(function()
	remotes.BuyUpgrade:FireServer("Slots")
end)
ui.LockButton.Activated:Connect(function()
	remotes.BuyUpgrade:FireServer("Lock")
end)

ui.FeedButton.Activated:Connect(function()
	if openMonsterId then
		remotes.FeedMonster:FireServer(openMonsterId)
	end
end)
ui.SellButton.Activated:Connect(function()
	if not openMonsterId then
		return
	end
	if os.clock() < sellConfirmUntil then
		sellConfirmUntil = 0
		remotes.SellMonster:FireServer(openMonsterId)
		ui.MonsterFrame.Visible = false
	else
		sellConfirmUntil = os.clock() + 3
		refresh()
	end
end)

-- أزرار الـ Prompt: "Care" لوحوشك بس، "Steal" لوحوش غيرك بس، و"Lock" لقاعدتك بس.
local function setupPrompt(prompt: ProximityPrompt)
	if prompt.Name == "CarePrompt" or prompt.Name == "StealPrompt" then
		local model = prompt.Parent and prompt.Parent.Parent
		if not model then
			return
		end
		local isMine = model:GetAttribute("OwnerUserId") == player.UserId
		prompt.Enabled = if prompt.Name == "CarePrompt" then isMine else not isMine
	elseif prompt.Name == "LockPrompt" then
		local function update()
			prompt.Enabled = prompt:GetAttribute("OwnerUserId") == player.UserId
		end
		prompt:GetAttributeChangedSignal("OwnerUserId"):Connect(update)
		update()
	end
end

local function watchMap(map: Instance)
	for _, descendant in map:GetDescendants() do
		if descendant:IsA("ProximityPrompt") then
			setupPrompt(descendant)
		end
	end
	map.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("ProximityPrompt") then
			-- نستنى لحظة عشان الـ attributes توصل
			task.defer(setupPrompt, descendant)
		end
	end)
end
watchMap(workspace:WaitForChild("Map"))

-- تأثير الـ Rainbow ---------------------------------------------------------------
local rainbowParts: { [BasePart]: boolean } = {}
local function addRainbow(instance: Instance)
	if instance:IsA("BasePart") then
		rainbowParts[instance] = true
	end
end
for _, instance in CollectionService:GetTagged("RainbowPart") do
	addRainbow(instance)
end
CollectionService:GetInstanceAddedSignal("RainbowPart"):Connect(addRainbow)
CollectionService:GetInstanceRemovedSignal("RainbowPart"):Connect(function(instance)
	rainbowParts[instance :: BasePart] = nil
end)
RunService.RenderStepped:Connect(function()
	local hue = (os.clock() * 0.25) % 1
	for part in rainbowParts do
		part.Color = Color3.fromHSV(hue, 0.8, 1)
	end
end)

-- العدّاد في لوحة الوحش (Play cooldown) بيتحدث مع كل StateUpdate، وكمان كل نص ثانية.
task.spawn(function()
	while true do
		task.wait(0.5)
		refreshMonsterPanel()
	end
end)

UI.Toast(ui, "Welcome to Raise a Monster! Hatch your egg, hunt monsters with your bat and carry them home 🏃", "info")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Features</string>
            <string name="Source"><![CDATA[--!strict
-- واجهة الأنظمة الجديدة: تليبورت، الهدية اليومية، عجلة الحظ، الـ Gamepasses في المتجر،
-- الإكسسوارات، الألعاب الصغيرة، الـ Trading، الـ Arena، والإعلانات الكبيرة.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)
local UI = require(script.Parent.UI)

local COLORS = UI.Colors
local player = Players.LocalPlayer

local Features = {}

local ui: UI.UI
local remotes: { [string]: RemoteEvent }
local getState: () -> any
local getOpenMonster: () -> string?

-- عناصر بتتحدث مع كل StateUpdate
local statusLabel: TextLabel
local dailyButton: TextButton
local spinButton: TextButton
local dailyInfo: TextLabel
local dailyClaim: TextButton
local spinGo: TextButton
local passButtons: { [string]: TextButton } = {}
local accessoryRows: { [string]: { Button: TextButton, Info: TextLabel } } = {}
local accessoriesFrame: Frame
local miniGameFrame: Frame

-- أدوات ------------------------------------------------------------------------------------

local function formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local hours = seconds // 3600
	local minutes = (seconds % 3600) // 60
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, secs)
	end
	return string.format("%d:%02d", minutes, secs)
end

local function rarityHex(rarity: string): string
	local info = Config.Rarities[rarity]
	return if info then "#" .. info.Color:ToHex() else "#FFFFFF"
end

local function makeList(parent: Instance, size: UDim2, position: UDim2): ScrollingFrame
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = size
	scroll.Position = position
	scroll.BackgroundColor3 = COLORS.PanelLight
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 6
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = parent
	UI.Corner(scroll, 10)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = scroll
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 6)
	padding.PaddingLeft = UDim.new(0, 6)
	padding.PaddingRight = UDim.new(0, 12)
	padding.Parent = scroll
	return scroll
end

local function clearList(scroll: ScrollingFrame)
	for _, child in scroll:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function sortedMonsters(): { any }
	local state = getState()
	local list = {}
	if state then
		for _, monster in state.Monsters do
			if not monster.Carried then
				table.insert(list, monster)
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Production > b.Production
	end)
	return list
end

local function monsterText(monster: any): string
	-- وحوشك جاية بـ DisplayName، وعرض اللاعب التاني في الـ Trade جاي بـ Name
	local name = monster.DisplayName or monster.Name or "?"
	return string.format('<font color="%s">%s</font>  Lv %d', rarityHex(monster.Rarity), name, monster.Level)
end

local function fillMonsters(scroll: ScrollingFrame, isSelected: (any) -> boolean, onClick: (any) -> ())
	clearList(scroll)
	for index, monster in sortedMonsters() do
		local entry = UI.Button(scroll, monsterText(monster), if isSelected(monster) then COLORS.Green else COLORS.Panel, UDim2.new(1, 0, 0, 38), UDim2.new())
		entry.LayoutOrder = index
		entry.TextSize = 17
		entry.Activated:Connect(function()
			onClick(monster)
		end)
	end
end

local function fillPlayers(scroll: ScrollingFrame, onClick: (Player) -> ())
	clearList(scroll)
	local count = 0
	for _, other in Players:GetPlayers() do
		if other ~= player then
			count += 1
			local entry = UI.Button(scroll, other.DisplayName, COLORS.Panel, UDim2.new(1, 0, 0, 38), UDim2.new())
			entry.LayoutOrder = count
			entry.Activated:Connect(function()
				onClick(other)
			end)
		end
	end
	if count == 0 then
		local empty = UI.Label(scroll, "No other players in this server yet.", UDim2.new(1, 0, 0, 40), UDim2.new(), 16)
		empty.TextColor3 = COLORS.SubText
	end
end

local function newPanel(name: string, size: UDim2, title: string, color: Color3): Frame
	local frame = UI.Panel(ui.Gui, name, size, title, color)
	table.insert(ui.Panels, frame)
	return frame
end

-- إعلانات كبيرة -----------------------------------------------------------------------------

local banner: TextLabel
local bannerToken = 0
local function buildBanner()
	banner = Instance.new("TextLabel")
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.Position = UDim2.new(0.5, 0, 0, 132)
	banner.Size = UDim2.fromOffset(760, 64)
	banner.BackgroundColor3 = COLORS.Panel
	banner.BackgroundTransparency = 0.1
	banner.Font = Enum.Font.FredokaOne
	banner.TextSize = 24
	banner.TextWrapped = true
	banner.TextColor3 = COLORS.Yellow
	banner.Visible = false
	banner.ZIndex = 20
	banner.Parent = ui.Gui
	UI.Corner(banner, 14)
	UI.Stroke(banner, COLORS.Yellow, 3)
end

local function announce(text: string, color: Color3?)
	bannerToken += 1
	local token = bannerToken
	banner.Text = text
	banner.TextColor3 = color or COLORS.Yellow
	local stroke = banner:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color or COLORS.Yellow
	end
	banner.Visible = true
	task.delay(6, function()
		if bannerToken == token then
			banner.Visible = false
		end
	end)
end

-- Popup (طلبات الـ Trade والـ Arena) ----------------------------------------------------------

local popup: Frame
local popupTitle: TextLabel
local popupBody: Frame
local popupToken = 0

local function buildPopup()
	popup = Instance.new("Frame")
	-- في النص تحت (اليمين بتغطيه لستة اللاعبين بتاعة Roblox)
	popup.AnchorPoint = Vector2.new(0.5, 1)
	popup.Position = UDim2.new(0.5, 0, 1, -206)
	popup.Size = UDim2.fromOffset(340, 300)
	popup.BackgroundColor3 = COLORS.Panel
	popup.Visible = false
	popup.ZIndex = 10
	popup.Parent = ui.Gui
	UI.Corner(popup, 14)
	UI.Stroke(popup, COLORS.Orange, 3)
	popupTitle = UI.Label(popup, "", UDim2.new(1, -20, 0, 54), UDim2.fromOffset(10, 6), 20)
	popupBody = Instance.new("Frame")
	popupBody.BackgroundTransparency = 1
	popupBody.Position = UDim2.fromOffset(10, 64)
	popupBody.Size = UDim2.new(1, -20, 1, -74)
	popupBody.Parent = popup
end

local function showPopup(title: string, timeout: number, build: (body: Frame, close: () -> ()) -> ())
	popupToken += 1
	local token = popupToken
	for _, child in popupBody:GetChildren() do
		child:Destroy()
	end
	popupTitle.Text = title
	local function close()
		if popupToken == token then
			popup.Visible = false
		end
	end
	build(popupBody, close)
	popup.Visible = true
	task.delay(timeout, close)
end

-- تليبورت وأزرار جانبية -----------------------------------------------------------------------

local function buildButtons()
	-- ZIndex 0 عشان أي لوحة تتفتح تبقى فوقهم
	local home = UI.Button(ui.Gui, "🏠 Home", COLORS.Green, UDim2.fromOffset(150, 44), UDim2.new(0.5, -160, 1, -150))
	home.ZIndex = 0
	home.Activated:Connect(function()
		remotes.Teleport:FireServer("Home")
	end)
	local shop = UI.Button(ui.Gui, "🥚 To Shop", COLORS.Pink, UDim2.fromOffset(150, 44), UDim2.new(0.5, 10, 1, -150))
	shop.ZIndex = 0
	shop.Activated:Connect(function()
		remotes.Teleport:FireServer("Shop")
	end)

	-- عمود تاني على الشمال (اليمين بتغطيه لستة اللاعبين بتاعة Roblox وبتاكل الضغطات)
	dailyButton = UI.Button(ui.Gui, "🎁\nDaily", COLORS.Yellow, UDim2.fromOffset(84, 84), UDim2.new(0, 104, 0.5, -92))
	dailyButton.TextSize = 18
	spinButton = UI.Button(ui.Gui, "🎡\nSpin", COLORS.Orange, UDim2.fromOffset(84, 84), UDim2.new(0, 104, 0.5, 8))
	spinButton.TextSize = 18

	statusLabel = UI.Label(ui.Gui, "", UDim2.fromOffset(420, 26), UDim2.new(0.5, -210, 0, 76), 18)
	statusLabel.TextStrokeTransparency = 0.3
	statusLabel.ZIndex = 0
end

-- المتجر: Gamepasses و Boosts تحت خالص --------------------------------------------------------

local function buildShopExtras()
	local y = ui.ShopContentBottom
	local function section(title: string)
		local header = UI.Label(ui.ShopScroll, title, UDim2.new(1, -32, 0, 34), UDim2.fromOffset(16, y), 24)
		header.TextXAlignment = Enum.TextXAlignment.Left
		header.TextColor3 = COLORS.Yellow
		y += 40
	end
	local function card(index: number, perRow: number, name: string, description: string, price: number, color: Color3, onBuy: () -> ()): TextButton
		local width = math.floor((640 - (perRow - 1) * 10) / perRow)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromOffset(width, 156)
		frame.Position = UDim2.fromOffset(16 + (index - 1) * (width + 10), y)
		frame.BackgroundColor3 = COLORS.PanelLight
		frame.Parent = ui.ShopScroll
		UI.Corner(frame, 12)
		UI.Stroke(frame, color, 2)
		local title = UI.Label(frame, name, UDim2.new(1, -10, 0, 30), UDim2.fromOffset(5, 6), 20)
		title.TextColor3 = color
		local desc = UI.Label(frame, description, UDim2.new(1, -10, 0, 60), UDim2.fromOffset(5, 38), 15)
		desc.TextColor3 = COLORS.SubText
		local buy = UI.Button(frame, "R$ " .. price, COLORS.Green, UDim2.new(1, -16, 0, 40), UDim2.fromOffset(8, 106))
		buy.Activated:Connect(onBuy)
		return buy
	end

	section("⭐ Gamepasses")
	local passes = {}
	for name, pass in Config.Gamepasses do
		table.insert(passes, { Name = name, Pass = pass })
	end
	table.sort(passes, function(a, b)
		return a.Pass.Order < b.Pass.Order
	end)
	for i, entry in passes do
		passButtons[entry.Name] = card(i, #passes, entry.Pass.Name, entry.Pass.Description, entry.Pass.Price, COLORS.Yellow, function()
			remotes.BuyPass:FireServer(entry.Name)
		end)
	end
	y += 168

	section("⚡ Boosts")
	local products = {}
	for name, product in Config.Products do
		table.insert(products, { Name = name, Product = product })
	end
	table.sort(products, function(a, b)
		return a.Product.Order < b.Product.Order
	end)
	for i, entry in products do
		card(i, #products, entry.Product.Name, entry.Product.Description, entry.Product.Price, COLORS.Blue, function()
			remotes.BuyProduct:FireServer(entry.Name)
		end)
	end
	y += 168
	local spacer = Instance.new("Frame")
	spacer.BackgroundTransparency = 1
	spacer.Size = UDim2.fromOffset(1, 10)
	spacer.Position = UDim2.fromOffset(0, y)
	spacer.Parent = ui.ShopScroll
end

-- الهدية اليومية -------------------------------------------------------------------------------

local function buildDaily()
	local frame = newPanel("Daily", UDim2.fromOffset(420, 260), "🎁 Daily Reward", COLORS.Yellow)
	dailyInfo = UI.Label(frame, "", UDim2.new(1, -32, 0, 110), UDim2.fromOffset(16, 60), 20)
	dailyClaim = UI.Button(frame, "Claim", COLORS.Green, UDim2.new(1, -32, 0, 50), UDim2.fromOffset(16, 190))
	dailyClaim.Activated:Connect(function()
		remotes.ClaimDaily:FireServer()
	end)
	dailyButton.Activated:Connect(function()
		UI.Toggle(ui, frame)
	end)
end

-- عجلة الحظ -------------------------------------------------------------------------------------

local function buildSpin()
	local frame = newPanel("Spin", UDim2.fromOffset(460, 470), "🎡 Spin Wheel", COLORS.Orange)
	local wheel = Instance.new("Frame")
	wheel.AnchorPoint = Vector2.new(0.5, 0.5)
	wheel.Position = UDim2.new(0.5, 0, 0, 220)
	wheel.Size = UDim2.fromOffset(300, 300)
	wheel.BackgroundColor3 = COLORS.PanelLight
	wheel.Parent = frame
	UI.Corner(wheel, 150)
	UI.Stroke(wheel, COLORS.Orange, 4)
	local prizes = Config.Spin.Prizes
	local step = 360 / #prizes
	for i, prize in prizes do
		local angle = math.rad((i - 1) * step)
		local chip = UI.Label(wheel, prize.Name, UDim2.fromOffset(104, 40), UDim2.new(0.5, math.sin(angle) * 100 - 52, 0.5, -math.cos(angle) * 100 - 20), 16)
		chip.BackgroundTransparency = 0
		chip.BackgroundColor3 = prize.Color
		chip.TextColor3 = Color3.fromRGB(25, 25, 30)
		chip.Rotation = (i - 1) * step
		UI.Corner(chip, 10)
	end
	local pointer = UI.Label(frame, "▼", UDim2.fromOffset(40, 40), UDim2.new(0.5, -20, 0, 52), 34)
	pointer.TextColor3 = COLORS.Red
	pointer.ZIndex = 3
	spinGo = UI.Button(frame, "SPIN!", COLORS.Green, UDim2.new(1, -32, 0, 50), UDim2.fromOffset(16, 400))
	spinGo.Activated:Connect(function()
		remotes.Spin:FireServer()
	end)
	spinButton.Activated:Connect(function()
		UI.Toggle(ui, frame)
	end)

	remotes.SpinResult.OnClientEvent:Connect(function(index: number)
		UI.Open(ui, frame)
		local current = wheel.Rotation % 360
		wheel.Rotation = current
		-- الجايزة رقم index لازم توقف تحت السهم اللي فوق
		local target = 360 * 5 - (index - 1) * step
		TweenService:Create(wheel, TweenInfo.new(4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = target }):Play()
	end)
end

-- الإكسسوارات -----------------------------------------------------------------------------------

local function buildAccessories()
	accessoriesFrame = newPanel("Accessories", UDim2.fromOffset(500, 470), "👒 Accessories", COLORS.Blue)
	local list = makeList(accessoriesFrame, UDim2.new(1, -32, 1, -76), UDim2.fromOffset(16, 60))
	local sorted = {}
	for name, accessory in Config.Accessories do
		table.insert(sorted, { Name = name, Accessory = accessory })
	end
	table.sort(sorted, function(a, b)
		return a.Accessory.Order < b.Accessory.Order
	end)
	for index, entry in sorted do
		local accessory = entry.Accessory
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 52)
		row.BackgroundColor3 = COLORS.Panel
		row.LayoutOrder = index
		row.Parent = list
		UI.Corner(row, 10)
		local swatch = Instance.new("Frame")
		swatch.Size = UDim2.fromOffset(30, 30)
		swatch.Position = UDim2.fromOffset(10, 11)
		swatch.BackgroundColor3 = accessory.Color
		swatch.Parent = row
		UI.Corner(swatch, 8)
		local bonus = if accessory.Bonus > 0 then string.format(" · +%d%% coins", math.floor(accessory.Bonus * 100 + 0.5)) else ""
		local info = UI.Label(row, accessory.Name .. "  (" .. accessory.Slot .. ")" .. bonus, UDim2.new(1, -200, 1, 0), UDim2.fromOffset(50, 0), 17)
		info.TextXAlignment = Enum.TextXAlignment.Left
		local action = UI.Button(row, "", COLORS.Green, UDim2.fromOffset(130, 38), UDim2.new(1, -138, 0, 7))
		action.TextSize = 16
		action.Activated:Connect(function()
			local state = getState()
			local monsterId = getOpenMonster()
			if not state then
				return
			end
			if not state.Accessories[entry.Name] then
				remotes.BuyAccessory:FireServer(entry.Name)
				return
			end
			if not monsterId then
				return
			end
			local monster = nil
			for _, m in state.Monsters do
				if m.Id == monsterId then
					monster = m
				end
			end
			if not monster then
				return
			end
			local wearing = monster[accessory.Slot] == entry.Name
			remotes.EquipAccessory:FireServer(monsterId, accessory.Slot, if wearing then nil else entry.Name)
		end)
		accessoryRows[entry.Name] = { Button = action, Info = info }
	end
	ui.AccessoriesButton.Activated:Connect(function()
		UI.Open(ui, accessoriesFrame)
		Features.Refresh()
	end)
end

local function refreshAccessories(state: any)
	local monsterId = getOpenMonster()
	local monster = nil
	for _, m in state.Monsters do
		if m.Id == monsterId then
			monster = m
		end
	end
	for name, row in accessoryRows do
		local accessory = Config.Accessories[name]
		if not state.Accessories[name] then
			row.Button.Text = "💰 " .. MonsterMath.FormatNumber(accessory.Cost)
			row.Button.BackgroundColor3 = if state.Coins >= accessory.Cost then COLORS.Green else COLORS.Gray
		elseif monster and monster[accessory.Slot] == name then
			row.Button.Text = "Take off"
			row.Button.BackgroundColor3 = COLORS.Red
		else
			row.Button.Text = "Wear"
			row.Button.BackgroundColor3 = COLORS.Blue
		end
	end
end

-- الألعاب الصغيرة ------------------------------------------------------------------------------

local function buildMiniGames()
	local chooser = newPanel("MiniGames", UDim2.fromOffset(420, 250), "🎮 Play a mini-game", COLORS.Pink)
	local catch = UI.Button(chooser, "⚾ Catch the Ball\nClick the balls!", COLORS.Blue, UDim2.fromOffset(186, 120), UDim2.fromOffset(16, 70))
	local run = UI.Button(chooser, "🏃 Run Together\nRun as far as you can!", COLORS.Orange, UDim2.fromOffset(186, 120), UDim2.fromOffset(218, 70))
	local function start(gameName: string)
		local monsterId = getOpenMonster()
		if monsterId then
			remotes.MiniGameStart:FireServer(monsterId, gameName)
		end
		chooser.Visible = false
	end
	catch.Activated:Connect(function()
		start("Catch")
	end)
	run.Activated:Connect(function()
		start("Run")
	end)
	-- زرار Play بقى بيفتح الألعاب
	ui.PlayButton.Activated:Connect(function()
		UI.Open(ui, chooser)
	end)

	-- الشاشة اللي اللعبة بتتلعب فيها
	miniGameFrame = Instance.new("Frame")
	miniGameFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	miniGameFrame.Position = UDim2.fromScale(0.5, 0.5)
	miniGameFrame.Size = UDim2.fromOffset(620, 420)
	miniGameFrame.BackgroundColor3 = COLORS.Panel
	miniGameFrame.BackgroundTransparency = 0.15
	miniGameFrame.Visible = false
	miniGameFrame.ZIndex = 5
	miniGameFrame.Parent = ui.Gui
	UI.Corner(miniGameFrame, 16)
	UI.Stroke(miniGameFrame, COLORS.Pink, 3)
	local header = UI.Label(miniGameFrame, "", UDim2.new(1, -20, 0, 50), UDim2.fromOffset(10, 6), 26)
	header.ZIndex = 6
	local ball = UI.Button(miniGameFrame, "⚾", COLORS.Yellow, UDim2.fromOffset(70, 70), UDim2.fromOffset(270, 200))
	ball.TextSize = 36
	ball.ZIndex = 6
	UI.Corner(ball, 35)

	local score = 0
	local playingCatch = false
	local runPanel = UI.Label(ui.Gui, "", UDim2.fromOffset(460, 46), UDim2.new(0.5, -230, 0, 104), 24)
	runPanel.BackgroundTransparency = 0.15
	runPanel.BackgroundColor3 = COLORS.Panel
	runPanel.Visible = false
	UI.Corner(runPanel, 12)

	ball.Activated:Connect(function()
		if not playingCatch then
			return
		end
		score += 1
		ball.Position = UDim2.fromOffset(math.random(20, 530), math.random(70, 330))
	end)

	remotes.MiniGameState.OnClientEvent:Connect(function(info: any)
		if info.Done then
			playingCatch = false
			miniGameFrame.Visible = false
			runPanel.Visible = false
			return
		end
		if info.Game == "Catch" and not playingCatch then
			playingCatch = true
			score = 0
			miniGameFrame.Visible = true
			ball.Visible = true
			ball.Position = UDim2.fromOffset(270, 200)
			local duration = info.TimeLeft :: number
			task.spawn(function()
				local started = os.clock()
				while playingCatch and os.clock() - started < duration do
					header.Text = string.format("⚾ Catch the ball!   Score: %d   ⏳ %ds", score, math.ceil(duration - (os.clock() - started)))
					task.wait(0.1)
				end
				if playingCatch then
					playingCatch = false
					header.Text = "Done! Score: " .. score
					remotes.MiniGameFinish:FireServer(score)
					task.wait(1)
					miniGameFrame.Visible = false
				end
			end)
		elseif info.Game == "Run" then
			runPanel.Visible = true
			runPanel.Text = string.format("🏃 Run with your monster!  %d / %d studs  ⏳ %ds", info.Progress or 0, info.Target or 0, math.ceil(info.TimeLeft or 0))
		end
	end)
end

-- الـ Trading -----------------------------------------------------------------------------------

local function buildTrade()
	local tradeButton = UI.Button(ui.Gui, "🤝\nTrade", COLORS.Green, UDim2.fromOffset(84, 84), UDim2.new(0, 12, 0.5, 108))
	tradeButton.TextSize = 18
	local picker = newPanel("TradePicker", UDim2.fromOffset(380, 400), "🤝 Trade with...", COLORS.Green)
	local playerList = makeList(picker, UDim2.new(1, -32, 1, -76), UDim2.fromOffset(16, 60))
	tradeButton.Activated:Connect(function()
		fillPlayers(playerList, function(other)
			remotes.TradeRequest:FireServer(other.UserId)
			picker.Visible = false
		end)
		UI.Toggle(ui, picker)
	end)

	-- شباك الـ Trade نفسه
	local window = newPanel("Trade", UDim2.fromOffset(640, 470), "🤝 Trade", COLORS.Green)
	local mineTitle = UI.Label(window, "Your offer (tap to add/remove)", UDim2.fromOffset(290, 24), UDim2.fromOffset(16, 56), 17)
	mineTitle.TextXAlignment = Enum.TextXAlignment.Left
	local theirTitle = UI.Label(window, "", UDim2.fromOffset(290, 24), UDim2.fromOffset(330, 56), 17)
	theirTitle.TextXAlignment = Enum.TextXAlignment.Left
	local mineList = makeList(window, UDim2.fromOffset(294, 290), UDim2.fromOffset(16, 84))
	local theirList = makeList(window, UDim2.fromOffset(294, 290), UDim2.fromOffset(330, 84))
	local readyButton = UI.Button(window, "Ready ✓", COLORS.Green, UDim2.fromOffset(294, 50), UDim2.fromOffset(16, 400))
	local status = UI.Label(window, "", UDim2.fromOffset(180, 50), UDim2.fromOffset(330, 400), 16)
	local cancel = UI.Button(window, "Cancel", COLORS.Red, UDim2.fromOffset(100, 50), UDim2.fromOffset(524, 400))

	local current: any = nil
	local function selectedIds(): { string }
		local ids = {}
		if current then
			for _, monster in current.MyOffer do
				table.insert(ids, monster.Id)
			end
		end
		return ids
	end
	local function render()
		if not current then
			return
		end
		local selected = {}
		for _, id in selectedIds() do
			selected[id] = true
		end
		fillMonsters(mineList, function(monster)
			return selected[monster.Id] == true
		end, function(monster)
			local ids = selectedIds()
			local index = table.find(ids, monster.Id)
			if index then
				table.remove(ids, index)
			elseif #ids < Config.Trade.MaxOffer then
				table.insert(ids, monster.Id)
			end
			remotes.TradeSetOffer:FireServer(ids)
		end)
		clearList(theirList)
		for index, monster in current.TheirOffer do
			local entry = UI.Label(theirList, monsterText(monster), UDim2.new(1, 0, 0, 34), UDim2.new(), 17)
			entry.LayoutOrder = index
		end
		theirTitle.Text = current.PartnerName .. "'s offer"
		readyButton.Text = if current.MyReady then "Waiting... (tap to undo)" else "Ready ✓"
		readyButton.BackgroundColor3 = if current.MyReady then COLORS.Gray else COLORS.Green
		status.Text = if current.TheirReady then "✅ " .. current.PartnerName .. " is ready" else "⏳ " .. current.PartnerName .. " is choosing"
	end
	readyButton.Activated:Connect(function()
		if current then
			remotes.TradeReady:FireServer(not current.MyReady)
		end
	end)
	cancel.Activated:Connect(function()
		remotes.TradeCancel:FireServer()
	end)
	-- لو قفل الشباك بالـ X بنلغي الـ Trade
	window:GetPropertyChangedSignal("Visible"):Connect(function()
		if not window.Visible and current then
			remotes.TradeCancel:FireServer()
		end
	end)

	remotes.TradeUpdate.OnClientEvent:Connect(function(state: any)
		current = state
		if state then
			UI.Open(ui, window)
			render()
		else
			window.Visible = false
		end
	end)

	remotes.TradeIncoming.OnClientEvent:Connect(function(fromUserId: number, fromName: string)
		showPopup("🤝 " .. fromName .. " wants to trade with you!", Config.Trade.RequestTimeout, function(body, close)
			local accept = UI.Button(body, "Accept", COLORS.Green, UDim2.new(0.5, -6, 0, 50), UDim2.fromOffset(0, 150))
			local decline = UI.Button(body, "Decline", COLORS.Red, UDim2.new(0.5, -6, 0, 50), UDim2.new(0.5, 6, 0, 150))
			accept.Activated:Connect(function()
				remotes.TradeRespond:FireServer(fromUserId, true)
				close()
			end)
			decline.Activated:Connect(function()
				remotes.TradeRespond:FireServer(fromUserId, false)
				close()
			end)
		end)
	end)
end

-- الـ Arena -------------------------------------------------------------------------------------

local function buildArena()
	local arenaButton = UI.Button(ui.Gui, "⚔️\nArena", COLORS.Red, UDim2.fromOffset(84, 84), UDim2.new(0, 12, 0.5, 208))
	arenaButton.TextSize = 18
	local picker = newPanel("ArenaPicker", UDim2.fromOffset(640, 470), "⚔️ Monster Arena", COLORS.Red)
	local hint = UI.Label(picker, "Pick an opponent and your fighter. The winner takes coins AND the loser's monster!", UDim2.new(1, -32, 0, 40), UDim2.fromOffset(16, 52), 16)
	hint.TextColor3 = COLORS.SubText
	local playersTitle = UI.Label(picker, "Opponent", UDim2.fromOffset(290, 24), UDim2.fromOffset(16, 96), 17)
	playersTitle.TextXAlignment = Enum.TextXAlignment.Left
	local monstersTitle = UI.Label(picker, "Your fighter", UDim2.fromOffset(290, 24), UDim2.fromOffset(330, 96), 17)
	monstersTitle.TextXAlignment = Enum.TextXAlignment.Left
	local playerList = makeList(picker, UDim2.fromOffset(294, 270), UDim2.fromOffset(16, 122))
	local monsterList = makeList(picker, UDim2.fromOffset(294, 270), UDim2.fromOffset(330, 122))
	local challenge = UI.Button(picker, "Challenge!", COLORS.Gray, UDim2.new(1, -32, 0, 48), UDim2.fromOffset(16, 406))

	local chosenPlayer: Player? = nil
	local chosenMonster: string? = nil
	local function renderPicker()
		fillPlayers(playerList, function(other)
			chosenPlayer = other
			playersTitle.Text = "Opponent: " .. other.DisplayName
		end)
		fillMonsters(monsterList, function(monster)
			return monster.Id == chosenMonster
		end, function(monster)
			chosenMonster = monster.Id
			renderPicker()
		end)
		challenge.BackgroundColor3 = if chosenPlayer and chosenMonster then COLORS.Green else COLORS.Gray
	end
	arenaButton.Activated:Connect(function()
		chosenPlayer = nil
		chosenMonster = nil
		playersTitle.Text = "Opponent"
		renderPicker()
		UI.Toggle(ui, picker)
	end)
	challenge.Activated:Connect(function()
		if chosenPlayer and chosenMonster then
			remotes.ArenaChallenge:FireServer(chosenPlayer.UserId, chosenMonster)
			picker.Visible = false
		end
	end)

	remotes.ArenaIncoming.OnClientEvent:Connect(function(fromUserId: number, fromName: string, monsterName: string)
		showPopup("⚔️ " .. fromName .. " challenges you with " .. monsterName .. "! Pick your fighter:", Config.Arena.RequestTimeout, function(body, close)
			local list = makeList(body, UDim2.new(1, 0, 1, -56), UDim2.new())
			fillMonsters(list, function()
				return false
			end, function(monster)
				remotes.ArenaRespond:FireServer(fromUserId, monster.Id)
				close()
			end)
			local decline = UI.Button(body, "Decline", COLORS.Red, UDim2.new(1, 0, 0, 46), UDim2.new(0, 0, 1, -48))
			decline.Activated:Connect(function()
				remotes.ArenaRespond:FireServer(fromUserId, nil)
				close()
			end)
		end)
	end)

	-- المعركة
	local battle = Instance.new("Frame")
	battle.AnchorPoint = Vector2.new(0.5, 0)
	battle.Position = UDim2.new(0.5, 0, 0, 200)
	battle.Size = UDim2.fromOffset(560, 190)
	battle.BackgroundColor3 = COLORS.Panel
	battle.BackgroundTransparency = 0.1
	battle.Visible = false
	battle.Parent = ui.Gui
	UI.Corner(battle, 16)
	UI.Stroke(battle, COLORS.Red, 3)
	local myName = UI.Label(battle, "", UDim2.new(1, -32, 0, 24), UDim2.fromOffset(16, 8), 18)
	myName.TextXAlignment = Enum.TextXAlignment.Left
	local myBar = UI.Bar(battle, COLORS.Green, UDim2.fromOffset(16, 34))
	local theirName = UI.Label(battle, "", UDim2.new(1, -32, 0, 24), UDim2.fromOffset(16, 70), 18)
	theirName.TextXAlignment = Enum.TextXAlignment.Left
	local theirBar = UI.Bar(battle, COLORS.Red, UDim2.fromOffset(16, 96))
	local log = UI.Label(battle, "", UDim2.new(1, -32, 0, 50), UDim2.fromOffset(16, 132), 20)
	log.TextColor3 = COLORS.Yellow
	local token = 0
	remotes.ArenaUpdate.OnClientEvent:Connect(function(state: any)
		token += 1
		local myToken = token
		if not state then
			battle.Visible = false
			return
		end
		battle.Visible = true
		myName.Text = "🔵 You: " .. state.MyName
		theirName.Text = "🔴 Them: " .. state.TheirName
		UI.SetBar(myBar, state.MyHealth / state.MyMax, string.format("%d / %d", math.floor(state.MyHealth), state.MyMax))
		UI.SetBar(theirBar, state.TheirHealth / state.TheirMax, string.format("%d / %d", math.floor(state.TheirHealth), state.TheirMax))
		log.Text = if state.Done then (if state.Won then "🏆 YOU WON! " else "💔 You lost. ") .. state.Log else state.Log
		if state.Done then
			task.delay(5, function()
				if token == myToken then
					battle.Visible = false
				end
			end)
		end
	end)
end

-- التحديث ---------------------------------------------------------------------------------------

function Features.Refresh()
	local state = getState()
	if not state then
		return
	end

	-- الحالة تحت الفلوس: Speed Boost والحاجة اللي شايلها
	local parts = {}
	if state.Carrying then
		table.insert(parts, "🎒 Carrying a monster: walk it home!")
	end
	if state.BoostLeft and state.BoostLeft > 0 then
		table.insert(parts, "💨 Boost " .. formatTime(state.BoostLeft))
	end
	if state.CoinMultiplier and state.CoinMultiplier > 1 then
		table.insert(parts, "👑 VIP x" .. state.CoinMultiplier)
	end
	statusLabel.Text = table.concat(parts, "   ")

	-- الهدية اليومية
	local dailyIn = state.DailyReadyIn or 0
	local streak = state.DailyStreak or 0
	local nextDay = math.min(streak + 1, Config.Daily.MaxStreak)
	dailyInfo.Text = string.format(
		"Day %d / %d\nNext reward: 💰 %s%s",
		nextDay,
		Config.Daily.MaxStreak,
		MonsterMath.FormatNumber(Config.Daily.CoinsPerDay * nextDay),
		if nextDay == Config.Daily.MaxStreak then " + " .. Config.Eggs[Config.Daily.Day7Egg].DisplayName else ""
	)
	dailyClaim.Text = if dailyIn > 0 then "Ready in " .. formatTime(dailyIn) else "Claim!"
	dailyClaim.BackgroundColor3 = if dailyIn > 0 then COLORS.Gray else COLORS.Green
	dailyButton.Text = if dailyIn > 0 then "🎁\nDaily" else "🎁\nReady!"

	-- عجلة الحظ
	local spinIn = state.SpinReadyIn or 0
	spinGo.Text = if spinIn > 0 then "Free spin in " .. formatTime(spinIn) else "SPIN!"
	spinGo.BackgroundColor3 = if spinIn > 0 then COLORS.Gray else COLORS.Green
	spinButton.Text = if spinIn > 0 then "🎡\nSpin" else "🎡\nReady!"

	-- الـ Gamepasses
	local passes = state.Passes or {}
	for name, button in passButtons do
		if passes[name] then
			button.Text = "Owned ✓"
			button.BackgroundColor3 = COLORS.Gray
		else
			button.Text = "R$ " .. Config.Gamepasses[name].Price
			button.BackgroundColor3 = COLORS.Green
		end
	end

	if accessoriesFrame.Visible then
		refreshAccessories(state)
	end
end

function Features.Init(newUi: UI.UI, allRemotes: { [string]: RemoteEvent }, stateGetter: () -> any, openMonsterGetter: () -> string?)
	ui = newUi
	remotes = allRemotes
	getState = stateGetter
	getOpenMonster = openMonsterGetter

	buildBanner()
	buildPopup()
	buildButtons()
	buildShopExtras()
	buildDaily()
	buildSpin()
	buildAccessories()
	buildMiniGames()
	buildTrade()
	buildArena()

	remotes.Announce.OnClientEvent:Connect(function(text: string, color: Color3?)
		announce(text, color)
	end)

	-- العدادات (Daily / Spin / Boost) بتعد كل ثانية
	task.spawn(function()
		while true do
			task.wait(1)
			local state = getState()
			if state then
				for _, key in { "DailyReadyIn", "SpinReadyIn", "BoostLeft" } do
					if state[key] and state[key] > 0 then
						state[key] = math.max(0, state[key] - 1)
					end
				end
				Features.Refresh()
			end
		end
	end)
end

return Features
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[--!strict
-- بيبني كل الواجهة بالكود (مفيش حاجة محتاجة تتعمل بإيدك في StarterGui).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local MonsterMath = require(ReplicatedStorage.Shared.MonsterMath)

local COLORS = {
	Panel = Color3.fromRGB(30, 30, 45),
	PanelLight = Color3.fromRGB(48, 48, 70),
	Text = Color3.fromRGB(255, 255, 255),
	SubText = Color3.fromRGB(190, 190, 210),
	Green = Color3.fromRGB(70, 200, 100),
	Blue = Color3.fromRGB(70, 140, 255),
	Red = Color3.fromRGB(230, 70, 70),
	Yellow = Color3.fromRGB(255, 200, 50),
	Orange = Color3.fromRGB(255, 140, 40),
	Pink = Color3.fromRGB(255, 100, 170),
	Gray = Color3.fromRGB(110, 110, 120),
}

export type Bar = { Frame: Frame, Fill: Frame, Label: TextLabel }

export type UI = {
	Gui: ScreenGui,
	CoinsLabel: TextLabel,
	PendingLabel: TextLabel,
	ShopButton: TextButton,
	UpgradesButton: TextButton,
	ShopFrame: Frame,
	ShopScroll: ScrollingFrame,
	ShopContentBottom: number,
	EggButtons: { [string]: TextButton },
	UpgradesFrame: Frame,
	SlotsInfo: TextLabel,
	SlotsButton: TextButton,
	LockInfo: TextLabel,
	LockButton: TextButton,
	MonsterFrame: Frame,
	MonsterName: TextLabel,
	MonsterInfo: TextLabel,
	XpBar: Bar,
	HungerBar: Bar,
	HappyBar: Bar,
	ProductionLabel: TextLabel,
	FeedButton: TextButton,
	PlayButton: TextButton,
	AccessoriesButton: TextButton,
	SellButton: TextButton,
	Toasts: Frame,
	Panels: { Frame },
}

local UI = {}
UI.Colors = COLORS

local function corner(parent: Instance, radius: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 12)
	c.Parent = parent
end

local function stroke(parent: Instance, color: Color3?, thickness: number?)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(0, 0, 0)
	s.Thickness = thickness or 2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
end

local function label(parent: Instance, text: string, size: UDim2, position: UDim2, textSize: number?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = position
	l.Font = Enum.Font.FredokaOne
	l.Text = text
	l.TextColor3 = COLORS.Text
	l.TextSize = textSize or 20
	l.TextWrapped = true
	l.RichText = true
	l.Parent = parent
	return l
end

local function button(parent: Instance, text: string, color: Color3, size: UDim2, position: UDim2): TextButton
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = position
	b.BackgroundColor3 = color
	b.Font = Enum.Font.FredokaOne
	b.Text = text
	b.TextColor3 = COLORS.Text
	b.TextSize = 20
	b.TextWrapped = true
	b.AutoButtonColor = true
	b.RichText = true
	b.Parent = parent
	corner(b, 10)
	stroke(b, Color3.new(0, 0, 0), 2)
	return b
end

local function panel(parent: Instance, name: string, size: UDim2, title: string, titleColor: Color3): (Frame, TextLabel)
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(0.5, 0.5)
	f.Size = size
	f.BackgroundColor3 = COLORS.Panel
	f.Visible = false
	f.Parent = parent
	corner(f, 16)
	stroke(f, titleColor, 3)

	local titleLabel = label(f, title, UDim2.new(1, -60, 0, 44), UDim2.fromOffset(16, 6), 30)
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.TextColor3 = titleColor

	local close = button(f, "X", COLORS.Red, UDim2.fromOffset(40, 40), UDim2.new(1, -48, 0, 8))
	close.Activated:Connect(function()
		f.Visible = false
	end)
	return f, titleLabel
end

local function bar(parent: Instance, color: Color3, position: UDim2): Bar
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, -32, 0, 26)
	frame.Position = position
	frame.BackgroundColor3 = COLORS.PanelLight
	frame.Parent = parent
	corner(frame, 8)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0.5, 1)
	fill.BackgroundColor3 = color
	fill.Parent = frame
	corner(fill, 8)

	local text = label(frame, "", UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 16)
	text.ZIndex = 2
	return { Frame = frame, Fill = fill, Label = text }
end

function UI.SetBar(b: Bar, fraction: number, text: string)
	b.Fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
	b.Label.Text = text
end

function UI.Create(playerGui: PlayerGui): UI
	local gui = Instance.new("ScreenGui")
	gui.Name = "RaiseAMonsterUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui

	local uiScale = Instance.new("UIScale")
	uiScale.Parent = gui
	local camera = workspace.CurrentCamera
	local function rescale()
		local viewport = camera.ViewportSize
		uiScale.Scale = math.clamp(math.min(viewport.X / 1100, viewport.Y / 700), 0.55, 1.2)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	-- الفلوس فوق
	local coinsFrame = Instance.new("Frame")
	coinsFrame.AnchorPoint = Vector2.new(0.5, 0)
	coinsFrame.Position = UDim2.new(0.5, 0, 0, 8)
	coinsFrame.Size = UDim2.fromOffset(260, 64)
	coinsFrame.BackgroundColor3 = COLORS.Panel
	coinsFrame.BackgroundTransparency = 0.15
	coinsFrame.Parent = gui
	corner(coinsFrame, 14)
	stroke(coinsFrame, COLORS.Yellow, 3)
	local coinsLabel = label(coinsFrame, "💰 0", UDim2.new(1, 0, 0, 40), UDim2.fromOffset(0, 2), 32)
	coinsLabel.TextColor3 = COLORS.Yellow
	local pendingLabel = label(coinsFrame, "", UDim2.new(1, 0, 0, 20), UDim2.fromOffset(0, 40), 16)
	pendingLabel.TextColor3 = COLORS.SubText

	-- أزرار الشمال
	local shopButton = button(gui, "🥚\nShop", COLORS.Pink, UDim2.fromOffset(84, 84), UDim2.new(0, 12, 0.5, -92))
	shopButton.TextSize = 22
	local upgradesButton = button(gui, "⬆️\nUpgrades", COLORS.Blue, UDim2.fromOffset(84, 84), UDim2.new(0, 12, 0.5, 8))
	upgradesButton.TextSize = 18

	local panels: { Frame } = {}

	-- المتجر -------------------------------------------------------------------
	local shopFrame = panel(gui, "Shop", UDim2.fromOffset(700, 560), "🥚 Shop", COLORS.Pink)
	table.insert(panels, shopFrame)
	local shopScroll = Instance.new("ScrollingFrame")
	shopScroll.Name = "Content"
	shopScroll.Position = UDim2.fromOffset(0, 56)
	shopScroll.Size = UDim2.new(1, 0, 1, -64)
	shopScroll.BackgroundTransparency = 1
	shopScroll.BorderSizePixel = 0
	shopScroll.ScrollBarThickness = 8
	shopScroll.CanvasSize = UDim2.fromOffset(0, 0)
	shopScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	shopScroll.Parent = shopFrame
	local eggButtons: { [string]: TextButton } = {}
	local sortedEggs = {}
	for _, eggType in Config.ShopEggs do
		local egg = Config.Eggs[eggType]
		if egg then
			table.insert(sortedEggs, { Type = eggType, Egg = egg })
		end
	end
	if #sortedEggs == 0 then
		local empty = label(shopScroll, "🥚 Eggs: coming soon...", UDim2.new(1, -40, 0, 60), UDim2.fromOffset(20, 10), 28)
		empty.TextColor3 = COLORS.SubText
	end
	for i, entry in sortedEggs do
		local egg = entry.Egg
		local card = Instance.new("Frame")
		card.Size = UDim2.fromOffset(196, 300)
		card.Position = UDim2.fromOffset(16 + (i - 1) * 206, 4)
		card.BackgroundColor3 = COLORS.PanelLight
		card.Parent = shopScroll
		corner(card, 12)
		stroke(card, egg.Color, 2)

		local eggIcon = Instance.new("Frame")
		eggIcon.Size = UDim2.fromOffset(56, 72)
		eggIcon.Position = UDim2.new(0.5, -28, 0, 10)
		eggIcon.BackgroundColor3 = egg.Color
		eggIcon.Parent = card
		corner(eggIcon, 36)
		stroke(eggIcon, Color3.new(0, 0, 0), 2)

		label(card, egg.DisplayName, UDim2.new(1, -10, 0, 28), UDim2.fromOffset(5, 86), 22)

		-- نسب الوحوش في البيضة
		local total = 0
		for _, weight in egg.Weights do
			total += weight
		end
		local odds = {}
		for speciesName, weight in egg.Weights do
			table.insert(odds, { Name = speciesName, Chance = weight / total })
		end
		table.sort(odds, function(a, b)
			return a.Chance > b.Chance
		end)
		local lines = {}
		for _, odd in odds do
			local species = Config.Species[odd.Name]
			local rarity = Config.Rarities[species.Rarity]
			table.insert(
				lines,
				string.format(
					'<font color="#%s">%s</font> %d%%',
					rarity.Color:ToHex(),
					species.DisplayName,
					math.floor(odd.Chance * 100 + 0.5)
				)
			)
		end
		local oddsLabel = label(card, table.concat(lines, "\n"), UDim2.new(1, -10, 0, 110), UDim2.fromOffset(5, 116), 16)
		oddsLabel.TextYAlignment = Enum.TextYAlignment.Top
		label(card, "⏳ " .. egg.HatchTime .. "s to hatch", UDim2.new(1, -10, 0, 20), UDim2.fromOffset(5, 226), 15).TextColor3 =
			COLORS.SubText

		local buy = button(card, "💰 " .. MonsterMath.FormatNumber(egg.Cost), COLORS.Green, UDim2.new(1, -20, 0, 40), UDim2.fromOffset(10, 250))
		eggButtons[entry.Type] = buy
	end

	-- الترقيات ----------------------------------------------------------------------
	local upgradesFrame = panel(gui, "Upgrades", UDim2.fromOffset(460, 300), "⬆️ Upgrades", COLORS.Blue)
	table.insert(panels, upgradesFrame)

	local slotsInfo = label(upgradesFrame, "", UDim2.new(1, -32, 0, 50), UDim2.fromOffset(16, 60), 18)
	slotsInfo.TextXAlignment = Enum.TextXAlignment.Left
	local slotsButton = button(upgradesFrame, "", COLORS.Green, UDim2.new(1, -32, 0, 40), UDim2.fromOffset(16, 112))
	local lockInfo = label(upgradesFrame, "", UDim2.new(1, -32, 0, 50), UDim2.fromOffset(16, 166), 18)
	lockInfo.TextXAlignment = Enum.TextXAlignment.Left
	local lockButton = button(upgradesFrame, "", COLORS.Green, UDim2.new(1, -32, 0, 40), UDim2.fromOffset(16, 218))

	-- لوحة الوحش ------------------------------------------------------------------
	local monsterFrame, monsterName = panel(gui, "Monster", UDim2.fromOffset(440, 468), "", COLORS.Green)
	table.insert(panels, monsterFrame)
	local monsterInfo = label(monsterFrame, "", UDim2.new(1, -32, 0, 24), UDim2.fromOffset(16, 52), 18)
	monsterInfo.TextXAlignment = Enum.TextXAlignment.Left
	monsterInfo.TextColor3 = COLORS.SubText

	label(monsterFrame, "XP", UDim2.fromOffset(100, 20), UDim2.fromOffset(16, 84), 16).TextXAlignment = Enum.TextXAlignment.Left
	local xpBar = bar(monsterFrame, COLORS.Blue, UDim2.fromOffset(16, 104))
	label(monsterFrame, "🍖 Hunger", UDim2.fromOffset(140, 20), UDim2.fromOffset(16, 138), 16).TextXAlignment =
		Enum.TextXAlignment.Left
	local hungerBar = bar(monsterFrame, COLORS.Orange, UDim2.fromOffset(16, 158))
	label(monsterFrame, "😄 Happiness", UDim2.fromOffset(160, 20), UDim2.fromOffset(16, 192), 16).TextXAlignment =
		Enum.TextXAlignment.Left
	local happyBar = bar(monsterFrame, COLORS.Pink, UDim2.fromOffset(16, 212))

	local productionLabel = label(monsterFrame, "", UDim2.new(1, -32, 0, 50), UDim2.fromOffset(16, 246), 18)
	productionLabel.TextColor3 = COLORS.Yellow

	local feedButton = button(monsterFrame, "", COLORS.Orange, UDim2.fromOffset(196, 48), UDim2.fromOffset(16, 304))
	local playButton = button(monsterFrame, "", COLORS.Pink, UDim2.fromOffset(196, 48), UDim2.fromOffset(228, 304))
	local accessoriesButton = button(monsterFrame, "👒 Accessories", COLORS.Blue, UDim2.new(1, -32, 0, 40), UDim2.fromOffset(16, 362))
	local sellButton = button(monsterFrame, "", COLORS.Red, UDim2.new(1, -32, 0, 44), UDim2.fromOffset(16, 412))

	-- الإشعارات --------------------------------------------------------------------
	local toasts = Instance.new("Frame")
	toasts.Name = "Toasts"
	toasts.AnchorPoint = Vector2.new(0.5, 0)
	toasts.Position = UDim2.new(0.5, 0, 0, 84)
	toasts.Size = UDim2.fromOffset(560, 300)
	toasts.BackgroundTransparency = 1
	toasts.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = toasts

	return {
		Gui = gui,
		CoinsLabel = coinsLabel,
		PendingLabel = pendingLabel,
		ShopButton = shopButton,
		UpgradesButton = upgradesButton,
		ShopFrame = shopFrame,
		ShopScroll = shopScroll,
		ShopContentBottom = if #sortedEggs > 0 then 316 else 80,
		EggButtons = eggButtons,
		UpgradesFrame = upgradesFrame,
		SlotsInfo = slotsInfo,
		SlotsButton = slotsButton,
		LockInfo = lockInfo,
		LockButton = lockButton,
		MonsterFrame = monsterFrame,
		MonsterName = monsterName,
		MonsterInfo = monsterInfo,
		XpBar = xpBar,
		HungerBar = hungerBar,
		HappyBar = happyBar,
		ProductionLabel = productionLabel,
		FeedButton = feedButton,
		PlayButton = playButton,
		AccessoriesButton = accessoriesButton,
		SellButton = sellButton,
		Toasts = toasts,
		Panels = panels,
	}
end

-- أدوات البناء متاحة لباقي ملفات الواجهة
UI.Corner = corner
UI.Stroke = stroke
UI.Label = label
UI.Button = button
UI.Panel = panel
UI.Bar = bar

function UI.Open(ui: UI, frame: Frame)
	for _, other in ui.Panels do
		other.Visible = other == frame
	end
end

function UI.Toggle(ui: UI, frame: Frame)
	if frame.Visible then
		frame.Visible = false
	else
		UI.Open(ui, frame)
	end
end

local toastOrder = 0
function UI.Toast(ui: UI, text: string, kind: string?)
	local color = COLORS.PanelLight
	if kind == "success" then
		color = COLORS.Green
	elseif kind == "error" then
		color = COLORS.Red
	elseif kind == "warning" then
		color = COLORS.Orange
	elseif kind == "coins" then
		color = COLORS.Yellow
	end

	toastOrder += 1
	local toast = Instance.new("TextLabel")
	toast.LayoutOrder = toastOrder
	toast.Size = UDim2.fromOffset(540, 40)
	toast.BackgroundColor3 = color
	toast.BackgroundTransparency = 0.1
	toast.Font = Enum.Font.FredokaOne
	toast.TextSize = 20
	toast.TextColor3 = if kind == "coins" then Color3.new(0.1, 0.1, 0.1) else COLORS.Text
	toast.TextWrapped = true
	toast.Text = text
	toast.Parent = ui.Toasts
	corner(toast, 10)
	stroke(toast, Color3.new(0, 0, 0), 2)

	-- ما نخليش الإشعارات تتكوم
	local children = {}
	for _, child in ui.Toasts:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(children, child)
		end
	end
	if #children > 5 then
		table.sort(children, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		children[1]:Destroy()
	end

	task.delay(3.5, function()
		if toast.Parent then
			local tween = TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			toast:Destroy()
		end
	end)
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>